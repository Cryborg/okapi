msgctxt "SettingsPage"
msgid "Réglages"
msgstr "Settings"

msgctxt "SettingsPage"
msgid "Chaque changement est enregistré tout de suite."
msgstr "Each change is saved at once."

msgctxt "SettingsPage"
msgid "Vos réglages sont un lien : modifiez-les à la main."
msgstr "Your settings are a link: edit them by hand."

msgctxt "SettingsPage"
msgid "Okapi ne sait pas où ranger ses réglages : ni XDG_CONFIG_HOME ni HOME ne sont utilisables."
msgstr "Okapi does not know where to keep its settings: neither XDG_CONFIG_HOME nor HOME can be used."

msgctxt "SettingsPage"
msgid "{} ne se lit pas : corrigez-le ou supprimez-le. Okapi ne le remplace pas."
msgstr "{} cannot be read: fix it or delete it. Okapi does not replace it."

msgctxt "SettingsPage"
msgid "Okapi ne peut pas enregistrer ses réglages : le détail est dans le journal."
msgstr "Okapi cannot save its settings: the details are in the log."

msgctxt "SettingsPage"
msgid "Relire"
msgstr "Read again"

msgctxt "SettingsPage"
msgid "Ce réglage n'a pas pu être enregistré (le détail est dans le journal)."
msgstr "This setting could not be saved (the details are in the log)."

