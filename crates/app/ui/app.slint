import { Theme, Brand } from "theme.slint";
import { Sidebar, Page } from "sidebar.slint";
import { AboutPage } from "about.slint";
import { CleanerPage } from "cleaner.slint";
import { DashboardPage } from "dashboard.slint";
import {
    AddableWidget, CellPlace, Dashboard, DayKind, FocusPart, FocusRequest, Moment, ReadingState, Reclaimable, ReclaimableState, SystemShown, Toast,
    WidgetCell, WidgetKind, WidgetSize,
} from "dashboard-model.slint";
import {
    CategoryChoice, CategoryKind, CheckState, CleanerStep, Cleaner, IssueKind, IssueShown,
    OutcomeKind, ResultBadge, ResultRow, RowState, ScanRow, SetupProblem, Size, SizeUnit,
    StopReason, StopShown,
} from "cleaner-model.slint";

export {
    AddableWidget, CellPlace, Dashboard, DayKind, FocusPart, FocusRequest, Moment, ReadingState, Reclaimable, ReclaimableState, SystemShown, Toast,
    WidgetCell, WidgetKind, WidgetSize,
    Page, CategoryChoice, CategoryKind, CheckState, CleanerStep, Cleaner, IssueKind, IssueShown,
    OutcomeKind, ResultBadge, ResultRow, RowState, ScanRow, SetupProblem, Size, SizeUnit,
    StopReason, StopShown,
}

export component AppWindow inherits Window {
    in property <string> version;
    // Its SPDX identifier (`MIT`), and the full texts of every license.
    in property <string> license-name;
    in property <string> license-texts;
    in property <string> repository;
    in-out property <Page> page: Page.home;
    // Told to Rust, which traces it.
    callback page-shown(Page);
    changed page => {
        root.page-shown(self.page);
    }

    title: Brand.name;
    icon: @image-url("../assets/okapi-icon.svg");
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    background: Theme.background;

    HorizontalLayout {
        Sidebar {
            page: root.page;
            navigate(page) => {
                root.page = page;
            }
        }

        // A layout, so that the window's minimum follows the page shown.
        VerticalLayout {
            horizontal-stretch: 1;
            if root.page == Page.home: DashboardPage {
                vertical-stretch: 1;
                window-width: root.width;
                open-cleaner => {
                    root.page = Page.cleaner;
                }
            }
            if root.page == Page.cleaner: CleanerPage {
                vertical-stretch: 1;
            }
            if root.page == Page.about: AboutPage {
                version: root.version;
                license-name: root.license-name;
                license-texts: root.license-texts;
                repository: root.repository;
            }
        }
    }
}
