import { Theme, Brand, Screen } from "theme.slint";
import { Sidebar, Page } from "sidebar.slint";
import { AboutPage } from "about.slint";
import { CleanerPage } from "cleaner.slint";
import { DashboardPage } from "dashboard.slint";
import {
    AddableWidget, CellPlace, Dashboard, DayKind, FocusPart, FocusRequest, Moment, ReadingState, Reclaimable, ReclaimableState, SystemShown, Toast,
    WidgetCell, WidgetKind, WidgetSize,
} from "dashboard-model.slint";
import {
    CategoryChoice, CategoryKind, CheckState, CleanerStep, Cleaner, IssueKind, IssueShown,
    OutcomeKind, ResultBadge, ResultRow, RowState, ScanRow, SetupProblem, Size, SizeUnit,
    StopReason, StopShown,
} from "cleaner-model.slint";

export {
    AddableWidget, CellPlace, Dashboard, DayKind, FocusPart, FocusRequest, Moment, ReadingState, Reclaimable, ReclaimableState, SystemShown, Toast,
    WidgetCell, WidgetKind, WidgetSize,
    Page, CategoryChoice, CategoryKind, CheckState, CleanerStep, Cleaner, IssueKind, IssueShown,
    OutcomeKind, ResultBadge, ResultRow, RowState, ScanRow, SetupProblem, Size, SizeUnit,
    StopReason, StopShown,
}

export component AppWindow inherits Window {
    in property <string> version;
    // Its SPDX identifier (`MIT`), and the full texts of every license.
    in property <string> license-name;
    in property <string> license-texts;
    in property <string> repository;
    in-out property <Page> page: Page.home;
    // The sidebar folded by the user's choice (a narrow window folds it too).
    in-out property <bool> sidebar-chosen-folded;
    // The width has changed since creation: the state was traced then.
    property <bool> sized;
    pure function narrow-now() -> bool {
        self.width < Theme.narrow-below
    }
    // `Screen.narrow` is set, never bound to the width: the sidebar's width
    // and the pages' margins follow it, the window's minimum width follows
    // them, and a binding would loop. Set at creation, for a window that
    // knows its size then (not winit's: 0 until shown); then at the first
    // change of width, and whenever the width crosses the threshold.
    init => {
        Screen.narrow = self.narrow-now();
    }
    changed width => {
        if !self.sized || Screen.narrow != self.narrow-now() {
            self.sized = true;
            Screen.narrow = self.narrow-now();
            root.sidebar-shown(self.sidebar-chosen-folded, Screen.narrow);
        }
    }
    // Told to Rust, which traces them.
    callback page-shown(Page);
    changed page => {
        root.page-shown(self.page);
    }
    callback sidebar-shown(chosen-folded: bool, narrow: bool);
    // Before the first width, `Screen.narrow` is not known yet: that width
    // says it.
    changed sidebar-chosen-folded => {
        if self.sized {
            root.sidebar-shown(self.sidebar-chosen-folded, Screen.narrow);
        }
    }

    title: Brand.name;
    icon: @image-url("../assets/okapi-icon.svg");
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    background: Theme.background;

    HorizontalLayout {
        Sidebar {
            page: root.page;
            chosen-folded <=> root.sidebar-chosen-folded;
            narrow: Screen.narrow;
            navigate(page) => {
                root.page = page;
            }
        }

        // A layout, so that the window's minimum follows the page shown.
        VerticalLayout {
            horizontal-stretch: 1;
            if root.page == Page.home: DashboardPage {
                vertical-stretch: 1;
                open-cleaner => {
                    root.page = Page.cleaner;
                }
            }
            if root.page == Page.cleaner: CleanerPage {
                vertical-stretch: 1;
            }
            if root.page == Page.about: AboutPage {
                version: root.version;
                license-name: root.license-name;
                license-texts: root.license-texts;
                repository: root.repository;
            }
        }
    }
}
