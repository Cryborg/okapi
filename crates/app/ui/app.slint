import { Theme, Brand } from "theme.slint";

export component AppWindow inherits Window {
    title: Brand.name;
    preferred-width: Theme.window-width;
    preferred-height: Theme.window-height;
    background: Theme.background;

    // Stands in for the first screen until the home screen lands.
    Text {
        text: Brand.name;
        color: Theme.text;
        font-size: Theme.font-display;
        font-weight: Theme.weight-semibold;
    }
}
