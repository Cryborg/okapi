// What the applications screen shows, filled by Rust (`apps.rs`).
import { Size } from "cleaner-model.slint";
import { Moment } from "dashboard-model.slint";

export enum AppSource { deb, snap, flatpak }

// What is known of what an application keeps in the home folder.
export enum AppData {
    // No folder is surely its (a deb).
    unknown,
    // It kept nothing.
    none,
    measuring,
    measured,
    // Some of it could not be read.
    partial,
    // A link, or a folder that cannot be opened.
    not-measured,
}

export enum AppsFilter { all, deb, snap, flatpak }

// How a source stands; `partial`: read, but a part of it could not be (a
// flatpak installation).
export enum SourceShown { reading, read, partial, absent, busy, failed }

export enum AppOrigin { none, by-user, as-dependency, with-system }

export struct AppLine {
    name: string,
    source: AppSource,
    icon: image,
    has-icon: bool,
    // A flatpak's size is measured.
    app-known: bool,
    app-size: Size,
    data: AppData,
    data-size: Size,
    has-old: bool,
    old-size: Size,
    system: bool,
    uninstalling: bool,
    // Its total, relative to the largest.
    bar: float,
}

export struct AppDetail {
    name: string,
    source: AppSource,
    icon: image,
    has-icon: bool,
    version: string,
    publisher: string,
    origin: AppOrigin,
    package: string,
    app-known: bool,
    app-size: Size,
    data: AppData,
    data-size: Size,
    has-old: bool,
    old-size: Size,
    old-versions: int,
    total: Size,
    system: bool,
    // Okapi can uninstall it, and its own uninstallation does not run.
    uninstallable: bool,
    uninstalling: bool,
    // A flatpak installed for the user's account only: no service removes it.
    for-account-only: bool,
}

export enum UninstallStep { closed, checking, confirm, refused, running, failed }

// Why an uninstallation did not happen.
export enum UninstallWhy { none, absent, not-authorized, busy, unanswered, timed-out, not-found, unclear, service }

// The tab shown: what is installed, what applications uninstalled left, or
// the old versions the package managers keep.
export enum AppsTab { installed, leftovers, old-versions }

// When the room of an old version comes back.
export enum OldRoom {
    // As soon as it goes.
    now,
    // Once snapd's download cache lets its file go.
    later,
    // Another snap shares its file: nothing.
    shared,
    unknown,
    // About this, once flatpak prunes its repository.
    about,
}

// An old revision of a snap, or a flatpak runtime no application uses.
export struct OldVersionLine {
    // Its rank in the report: what a tick names.
    index: int,
    source: AppSource,
    // The application's name as Okapi saw it, else the snap's or the
    // runtime's own.
    name: string,
    // A snap's version, a runtime's branch.
    version: string,
    // A snap's revision.
    revision: string,
    room: OldRoom,
    size: Size,
    has-since: bool,
    // Since when the snap's version in use is.
    since: Moment,
    checked: bool,
}

// What the last removal did.
export enum OldOutcome { none, done, partly, refused, nothing, interrupted }

export global OldVersions {
    in property <bool> finding;
    in property <[OldVersionLine]> snaps;
    in property <[OldVersionLine]> flatpaks;
    // What they take: the tab's badge, when there is any.
    in property <Size> total;
    in property <bool> has-total;
    in property <bool> searched;
    in property <bool> analysis-failed;
    in property <bool> snaps-unread;
    in property <bool> flatpaks-unread;
    // The user's own runtimes no application uses, never proposed.
    in property <int> for-account-only;
    // Other persons log in here: what they installed is not seen.
    in property <bool> other-accounts;
    in property <int> checked-count;
    // Of what is checked: snaps, and when their room comes back; runtimes.
    in property <bool> checked-snaps;
    in property <Size> checked-now;
    in property <bool> has-now;
    in property <Size> checked-later;
    in property <bool> has-later;
    in property <bool> checked-runtimes;
    in property <Size> checked-about;
    // What would go.
    in property <[OldVersionLine]> going;
    in property <bool> confirming;
    in property <bool> retiring;
    // A search or a removal runs, here or elsewhere on the screen.
    in property <bool> busy;
    in property <OldOutcome> outcome;
    in property <int> removed;
    in property <int> kept;
    // A history line could not be written.
    in property <bool> unrecorded;
    // Runtimes went, and flatpak did not prune its repository: their room
    // is not given back yet.
    in property <bool> unpruned;

    callback toggle(int);
    callback retire();
    callback confirm();
    callback cancel();
    callback close-outcome();
}

// A folder an application uninstalled left.
export struct LeftoverLine {
    source: AppSource,
    // The application's name as Okapi saw it installed, else its identifier.
    name: string,
    // Okapi saw it installed: it was uninstalled.
    known: bool,
    // `~/…`.
    path: string,
    size: Size,
    // Small enough to be checked, hence moved.
    checkable: bool,
    checked: bool,
}

// A copy snapd made by itself of the data of a snap no longer installed.
export struct CopyLine {
    // The snap's name as Okapi saw it installed, else its own.
    name: string,
    made: Moment,
    size: Size,
}

// What became of the last copy asked to be forgotten.
export enum ForgetOutcome {
    none,
    forgotten,
    // snapd lists it no more: it may have erased it itself.
    gone,
    reinstalled,
    // The rights were not given.
    refused,
    // Another operation of snapd holds it.
    busy,
    // snapd did not say in time: the list read again tells.
    unknown,
    failed,
}

// Why no leftover is proposed at all.
export enum LeftoversBlock { none, settings, variables }

export global Leftovers {
    in property <bool> analysing;
    in property <[LeftoverLine]> lines;
    // What the leftovers that can be moved take: the tab's badge, when
    // there is any.
    in property <Size> total;
    in property <bool> has-total;
    // Packages removed whose settings stay; 0 when none or unknown.
    in property <int> residual;
    // A report is shown: what it did not find is known to be absent.
    in property <bool> searched;
    // The last analysis ended without a word, or could not start.
    in property <bool> analysis-failed;
    // Folders no application bears, not proposed for safety.
    in property <int> withheld;
    in property <bool> snaps-unread;
    in property <bool> flatpaks-unread;
    in property <LeftoversBlock> blocked;
    in property <int> checked-count;
    in property <Size> checked-size;
    in property <bool> confirming;
    in property <bool> trashing;
    // An analysis, a move or a forgetting runs: nothing else starts.
    in property <bool> busy;
    // What the last move did, until closed.
    in property <bool> receipt;
    // Nothing was moved: the move could not run.
    in property <bool> trash-failed;
    // The move ended without a word: what it did is in the trash.
    in property <bool> trash-interrupted;
    in property <int> trashed;
    in property <Size> trashed-size;
    in property <int> kept;
    // In the trash, not known to be what was checked.
    in property <int> unchecked;

    // snapd's copies of snaps no longer installed, by the rank in its report.
    in property <[CopyLine]> copies;
    // They could not be read: none is proposed.
    in property <bool> copies-unread;
    // A copy asked to be forgotten, waiting for the yes.
    in property <bool> forget-asking;
    in property <string> forget-name;
    in property <Size> forget-size;
    in property <bool> forgetting;
    // What the last forgetting did, until closed.
    in property <ForgetOutcome> forgot;
    in property <string> forgot-name;
    in property <Size> forgot-size;

    callback forget(int);
    callback confirm-forget();
    callback cancel-forget();
    callback close-forgot();
    callback toggle(int);
    callback trash();
    callback confirm();
    callback cancel();
    callback close-receipt();
}

export global Apps {
    in-out property <AppsTab> tab;
    in property <bool> reading;
    // An uninstallation runs, its window shown or not: no other, no reading.
    in property <bool> busy;
    // When the list was last read, in minutes; -1 before.
    in property <int> minutes-ago: -1;
    in property <int> app-count;
    in property <[AppLine]> lines;
    in-out property <string> search;
    in-out property <AppsFilter> filter;
    in property <bool> has-flatpak;
    in property <SourceShown> debs;
    in property <SourceShown> snaps;
    in property <SourceShown> flatpaks;
    // The packages and snap components that are no application.
    in property <int> rest-packages;
    in property <Size> rest-packages-size;
    in property <int> rest-snaps;
    in property <Size> rest-snaps-size;
    in-out property <bool> rest-open;
    // The line the keyboard is on, the one whose detail is open (-1).
    in-out property <int> current;
    in property <int> chosen: -1;
    in property <AppDetail> detail;

    in property <UninstallStep> step;
    in property <string> target;
    in property <AppSource> target-source;
    // What would go, by name: the package and what goes with it (packages
    // that depend on it, a flatpak's extensions).
    in property <[string]> going;
    in property <Size> freed;
    // Every size of what goes is known.
    in property <bool> freed-known;
    in property <bool> has-data;
    in property <Size> data-size;
    in-out property <bool> purge;
    in property <bool> cancellable;
    in property <bool> too-late;
    // Another installation holds the package manager.
    in property <bool> waiting;
    in property <UninstallWhy> why;
    // The service's own words, for `service`.
    in property <string> why-detail;
    // The window was asked to close while it runs.
    in property <bool> closing;

    in property <bool> toast;
    in property <string> toast-name;
    in property <Size> toast-freed;
    in property <bool> toast-freed-known;
    // Its history line was written.
    in property <bool> toast-recorded;
    // Some of what was shown stayed (a flatpak's extension).
    in property <bool> toast-partly;

    callback refresh();
    callback searched();
    callback filtered();
    callback choose(int);
    // The keyboard moved to a line.
    callback move-to(int);
    callback close-detail();
    callback point(int);
    callback list-focus(bool);
    callback uninstall();
    callback confirm();
    callback cancel();
    callback close-modal();
    callback retry();
    callback close-toast();
    callback toast-held(bool);
}
