// The applications screen: what is installed (deb, snap, flatpak), what each
// takes (the application, its data, its old versions), its detail, and its
// uninstallation through the system's own services. Drawn from
// docs/design/applications/project/Applications.dc.html.
import { LineEdit, ListView } from "std-widgets.slint";
import { Theme, Screen } from "theme.slint";
import {
    ActionButton, Banner, ButtonKind, Card, CheckMark, Detail, FocusRing, Icon, IconButton,
    Badge, ModalFrame, ProgressBar, SilentDetail, SortHeader, StateIcon, TitleLine,
} from "widgets.slint";
import { Size, Words } from "cleaner-model.slint";
import { DashboardWords } from "dashboard-widgets.slint";
import { AppData, AppDetail, AppLine, AppOrigin, AppSource, Apps, AppsFilter, AppsSort, AppsTab, CopyLine, ForgetOutcome, LeftoverLine, Leftovers, LeftoversBlock, OldVersions, SourceShown, UninstallStep, UninstallWhy } from "apps-model.slint";
import { OldVersionsConfirm, OldVersionsView } from "old-versions.slint";

export global AppWords {
    pure public function source(source: AppSource) -> string {
        source == AppSource.deb ? @tr("Ubuntu") : source == AppSource.snap ? @tr("Snap") : @tr("Flatpak")
    }

    pure public function app-size(line: AppLine) -> string {
        line.app-known ? Words.size(line.app-size) : @tr("Mesure en cours")
    }

    // What the "Données" column says; nothing for a deb, whose data no
    // folder surely holds.
    pure public function data(state: AppData, size: Size) -> string {
        state == AppData.measured ? Words.size(size)
            : state == AppData.partial ? @tr("au moins {}", Words.size(size))
            : state == AppData.measuring ? @tr("Mesure en cours")
            : state == AppData.not-measured ? @tr("Données illisibles")
            : state == AppData.none ? @tr("Aucune")
            : ""
    }

    // What a screen reader says of a line.
    pure public function spoken(line: AppLine) -> string {
        @tr("{}, {}, {}", line.name, self.source(line.source), self.app-size(line))
            + (line.data == AppData.unknown || line.data == AppData.none ? ""
                : line.data == AppData.measuring ? @tr(", données en cours de mesure")
                : line.data == AppData.not-measured ? @tr(", données illisibles")
                : @tr(", données {}", self.data(line.data, line.data-size)))
            + (line.has-old ? @tr(", anciennes versions {}", Words.size(line.old-size)) : "")
            + (line.system ? @tr(", fait partie du système") : "")
            + (line.uninstalling ? @tr(", désinstallation en cours") : "")
    }

    // The first names of `names`, and how many more.
    pure public function names(names: [string]) -> string {
        names.length == 0 ? ""
            : names.length == 1 ? names[0]
            : names.length == 2 ? @tr("{}, {}", names[0], names[1])
            : names.length == 3 ? @tr("{}, {}", @tr("{}, {}", names[0], names[1]), names[2])
            : @tr("{}, et {} de plus", @tr("{}, {}", @tr("{}, {}", names[0], names[1]), names[2]), names.length - 3)
    }

    pure public function origin(origin: AppOrigin) -> string {
        origin == AppOrigin.by-user ? @tr("Installée par vous")
            : origin == AppOrigin.as-dependency ? @tr("Installée avec une autre appli")
            : origin == AppOrigin.with-system ? @tr("Installée avec le système") : ""
    }

    pure public function why(why: UninstallWhy, detail: string) -> string {
        why == UninstallWhy.absent ? @tr("Le service de désinstallation est absent de ce système.")
            : why == UninstallWhy.not-authorized ? @tr("L'autorisation n'a pas été donnée.")
            : why == UninstallWhy.busy ? @tr("Une autre installation est en cours : réessayez dans un moment.")
            : why == UninstallWhy.unanswered ? @tr("Le service de désinstallation ne répond pas.")
            : why == UninstallWhy.timed-out ? @tr("Le système n'a pas répondu à temps. Si vous avez donné votre mot de passe, la désinstallation peut encore aboutir.")
            // The title says it.
            : why == UninstallWhy.not-found ? ""
            : why == UninstallWhy.unclear ? @tr("Okapi n'a pas pu savoir ce qui serait retiré avec elle : rien n'a été touché.")
            : why == UninstallWhy.still-open ? @tr("Elle n'a pas pu être fermée.")
            : @tr("Le système a refusé : {}", detail)
    }
}

// The icon of an application, or a grey window when it has none.
component AppIcon inherits Rectangle {
    in property <image> source;
    in property <bool> has-source;
    in property <bool> large;
    width: large ? Theme.app-icon-large : Theme.app-icon;
    height: self.width;
    border-radius: large ? Theme.app-icon-radius-large : Theme.app-icon-radius;
    background: has-source ? transparent : Theme.surface-2;
    border-width: has-source ? 0 : Theme.border-width;
    border-color: Theme.border;
    accessible-role: none;
    if root.has-source: Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        accessible-role: none;
    }
    if !root.has-source: Icon {
        source: @image-url("../assets/icons/app-window.svg");
        colorize: Theme.text-3;
    }
}

component AppRow inherits Rectangle {
    in property <AppLine> line;
    in property <int> index;
    in property <bool> focused;

    height: Theme.app-row-height;
    background: Apps.chosen == root.index ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-label: AppWords.spoken(line);
    accessible-item-selectable: true;
    accessible-item-selected: Apps.chosen == root.index;
    accessible-action-default => {
        Apps.choose(root.index);
    }

    touch := TouchArea {
        clicked => {
            Apps.current = root.index;
            Apps.choose(root.index);
        }
        changed has-hover => {
            Apps.point(self.has-hover ? root.index : -1);
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: Theme.border-width;
        background: Theme.border;
    }
    FocusRing {
        shown: root.focused;
        border-radius: Theme.radius-small;
    }
    HorizontalLayout {
        padding-left: Theme.spacing-l;
        padding-right: Theme.spacing-l;
        spacing: Theme.spacing-m;
        AppIcon {
            source: line.icon;
            has-source: line.has-icon;
            cross-axis-self-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.spacing-xxs;
            name := Text {
                text: line.name;
                accessible-role: none;
                color: Theme.text;
                font-size: Theme.font-label;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                alignment: start;
                Text {
                    text: AppWords.source(line.source);
                    accessible-role: none;
                    color: Theme.text-2;
                    font-size: Theme.font-caption;
                }
                if line.system: StateIcon {
                    icon: @image-url("../assets/icons/lock.svg");
                    label: @tr("Fait partie du système");
                    width: Theme.icon-badge;
                    height: Theme.icon-badge;
                    cross-axis-self-alignment: center;
                }
                if line.uninstalling: StateIcon {
                    icon: @image-url("../assets/icons/loader.svg");
                    label: @tr("Désinstallation en cours");
                    width: Theme.icon-badge;
                    height: Theme.icon-badge;
                    cross-axis-self-alignment: center;
                }
                if line.has-old && !line.system && !line.uninstalling: Text {
                    text: @tr("· Anciennes versions : {}", Words.size(line.old-size));
                    accessible-role: none;
                    color: Theme.text-2;
                    font-size: Theme.font-caption;
                    overflow: elide;
                }
            }
        }
        Text {
            width: Theme.app-col-size;
            text: AppWords.app-size(line);
            accessible-role: none;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: line.app-known ? Theme.text : Theme.text-2;
            font-size: line.app-known ? Theme.font-label : Theme.font-caption;
        }
        Text {
            width: Theme.app-col-data;
            text: AppWords.data(line.data, line.data-size);
            accessible-role: none;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: line.data == AppData.measured ? Theme.text : Theme.text-2;
            font-size: line.data == AppData.measured ? Theme.font-label : Theme.font-caption;
            overflow: elide;
        }
        Rectangle {
            width: Screen.narrow ? Theme.app-bar-width-narrow : Theme.app-bar-width;
            height: Theme.disk-bar-height;
            cross-axis-self-alignment: center;
            border-radius: Theme.radius-pill;
            background: Theme.track;
            Rectangle {
                x: 0;
                width: parent.width * clamp(line.bar, 0, 1);
                height: parent.height;
                border-radius: parent.border-radius;
                background: Theme.size-bar;
            }
        }
    }
    // A name cut short is said whole on hover.
    if name.width < name.preferred-width && touch.has-hover: Tooltip {
        text: @markdown("\{line.name}");
    }
}

// The lines, by the keyboard too: the arrows move, Enter opens the detail.
component Lines inherits FocusScope {
    accessible-role: list;
    accessible-label: @tr("Applications installées");
    // Shown, it takes the keyboard: the arrows move in it at once. Hidden
    // behind the other tab, never: a key would go nowhere.
    property <bool> shown: Apps.tab == AppsTab.installed;
    init => {
        if self.shown {
            self.focus();
        }
    }
    changed shown => {
        if self.shown {
            self.focus();
        }
    }

    function show(index: int) {
        let place = index * Theme.app-row-height;
        if place < -view.content-y {
            view.content-y = -place;
        } else if place + Theme.app-row-height > -view.content-y + view.visible-height {
            view.content-y = view.visible-height - place - Theme.app-row-height;
        }
    }

    // The line of the keyboard brought into view, after a sort moved it.
    public function reveal() {
        root.show(Apps.current);
    }

    function move(index: int) {
        if Apps.lines.length == 0 {
            return;
        }
        Apps.current = clamp(index, 0, Apps.lines.length - 1);
        root.show(Apps.current);
        Apps.move-to(Apps.current);
        Apps.list-focus(true);
    }

    key-pressed(event) => {
        if event.text == Key.DownArrow {
            root.move(Apps.current + 1);
            return accept;
        }
        if event.text == Key.UpArrow {
            root.move(Apps.current - 1);
            return accept;
        }
        if event.text == Key.Home {
            root.move(0);
            return accept;
        }
        if event.text == Key.End {
            root.move(Apps.lines.length - 1);
            return accept;
        }
        if event.text == Key.Return && Apps.lines.length > 0 {
            Apps.choose(Apps.current);
            return accept;
        }
        reject
    }
    changed has-focus => {
        if !self.has-focus {
            Apps.list-focus(false);
        }
    }

    view := ListView {
        for line[index] in Apps.lines: AppRow {
            line: line;
            index: index;
            focused: root.has-focus && Apps.current == index;
        }
    }
}

// "Système et composants": what is no application, pinned under the list.
component Rest inherits Rectangle {
    background: Theme.surface-2;
    VerticalLayout {
        Rectangle {
            height: Theme.border-width;
            background: Theme.border-strong;
        }
        HorizontalLayout {
            height: Theme.app-sum-height;
            padding-left: Theme.spacing-l;
            padding-right: Theme.spacing-s;
            spacing: Theme.spacing-m;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: @tr("Système et composants");
                    color: Theme.text;
                    font-weight: Theme.weight-semibold;
                    font-size: Theme.font-label;
                }
                Detail {
                    property <string> debs: Apps.debs == SourceShown.read ? @tr("paquets : {} ({})", Apps.rest-packages, Words.size(Apps.rest-packages-size))
                        : Apps.debs == SourceShown.reading ? @tr("paquets Ubuntu pas encore lus")
                        : Apps.debs == SourceShown.absent ? ""
                        : @tr("paquets Ubuntu illisibles");
                    property <string> snaps: Apps.snaps == SourceShown.read ? @tr("composants snap : {} ({})", Apps.rest-snaps, Words.size(Apps.rest-snaps-size))
                        : Apps.snaps == SourceShown.reading ? @tr("composants snap pas encore lus")
                        : Apps.snaps == SourceShown.absent ? ""
                        : @tr("composants snap illisibles");
                    text: self.debs == "" ? self.snaps : self.snaps == "" ? self.debs : @tr("{} ; {}", self.debs, self.snaps);
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
            ActionButton {
                kind: ButtonKind.ghost;
                text: @tr("C'est quoi ?");
                accessible-expandable: true;
                accessible-expanded: Apps.rest-open;
                cross-axis-self-alignment: center;
                clicked => {
                    Apps.rest-open = !Apps.rest-open;
                }
            }
        }
        if Apps.rest-open: Detail {
            text: @tr("Ce qui fait tourner le système et les applis sans apparaître dans le menu : les bibliothèques, partagées par plusieurs programmes ; les environnements communs aux applis (bureau GNOME, pilotes graphiques, socles des snaps) ; les outils sans icône dans le menu, utilisés en ligne de commande ou par le système. Okapi ne les détaille pas un par un et ne propose pas de les désinstaller.");
            wrap: word-wrap;
        }
        if Apps.rest-open: Rectangle {
            height: Theme.spacing-m;
        }
    }
}

// A fact of the detail: its name, then what it says.
component Fact inherits VerticalLayout {
    in property <string> name;
    in property <string> value;
    spacing: Theme.spacing-xxs;
    Detail {
        text: root.name;
        font-size: Theme.font-caption;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: Theme.font-label;
        wrap: word-wrap;
    }
}

component Panel inherits Card {
    width: Screen.narrow ? Theme.disk-panel-width-narrow : Theme.disk-panel-width;
    VerticalLayout {
        padding: Theme.spacing-l;
        spacing: Theme.spacing-m;
        HorizontalLayout {
            spacing: Theme.spacing-m;
            AppIcon {
                source: Apps.detail.icon;
                has-source: Apps.detail.has-icon;
                large: true;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: Apps.detail.name;
                    color: Theme.text;
                    font-size: Theme.font-heading;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }
                Detail {
                    text: Apps.detail.version == "" ? AppWords.source(Apps.detail.source)
                        : @tr("{}, version {}", AppWords.source(Apps.detail.source), Apps.detail.version);
                }
            }
            IconButton {
                icon: @image-url("../assets/icons/x.svg");
                label: @tr("Fermer le détail");
                clicked => {
                    Apps.close-detail();
                }
            }
        }
        if Apps.detail.publisher != "": Fact {
            name: @tr("Éditeur");
            value: Apps.detail.publisher;
        }
        if Apps.detail.origin != AppOrigin.none: Fact {
            name: @tr("Origine");
            value: AppWords.origin(Apps.detail.origin);
        }
        Fact {
            name: @tr("Paquet");
            value: Apps.detail.package;
        }
        VerticalLayout {
            spacing: Theme.spacing-xxs;
            Detail {
                text: @tr("Place prise");
                font-size: Theme.font-caption;
            }
            Text {
                text: @tr("Appli : {}", Apps.detail.app-known ? Words.size(Apps.detail.app-size) : @tr("Mesure en cours"));
                color: Theme.text;
            }
            if Apps.detail.data != AppData.unknown: Text {
                text: Apps.detail.data == AppData.none ? @tr("Données : aucune") : @tr("Données : {}", AppWords.data(Apps.detail.data, Apps.detail.data-size));
                color: Theme.text;
            }
            if Apps.detail.has-old: Text {
                text: @tr("Anciennes versions : {}", Words.size(Apps.detail.old-size));
                color: Theme.text;
            }
            Text {
                text: @tr("Au total : {}", Words.size(Apps.detail.total));
                color: Theme.text;
                font-weight: Theme.weight-semibold;
            }
            if Apps.detail.has-old: Detail {
                text: Apps.detail.old-versions == 1
                    ? @tr("Version précédente gardée par le système.")
                    : @tr("{} versions précédentes gardées par le système.", Apps.detail.old-versions);
                wrap: word-wrap;
            }
        }
        if Apps.detail.uninstallable: ActionButton {
            text: @tr("Désinstaller");
            icon: @image-url("../assets/icons/trash-2.svg");
            kind: ButtonKind.danger;
            enabled: !Apps.busy;
            clicked => {
                Apps.uninstall();
            }
        }
        if Apps.detail.uninstalling: ActionButton {
            text: @tr("Voir la désinstallation en cours");
            kind: ButtonKind.ghost;
            wrapped: true;
            clicked => {
                Apps.uninstall();
            }
        }
        if Apps.detail.system: Detail {
            text: @tr("Le bureau a besoin de {} pour fonctionner. Okapi ne propose donc pas de la désinstaller.", Apps.detail.name);
            wrap: word-wrap;
        }
        if Apps.detail.for-account-only: Detail {
            text: @tr("Installée pour votre compte seulement : Okapi ne sait pas la désinstaller.");
            wrap: word-wrap;
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}

// The uninstallation: what goes, asked once, followed, then said. Closed by
// its buttons or Escape, never by a click outside; closing it stops nothing.
component Uninstall inherits ModalFrame {
    // Gone already: nothing left to say nor to try again.
    property <bool> already-gone: Apps.step == UninstallStep.failed && Apps.why == UninstallWhy.not-found;
    property <bool> failed: Apps.step == UninstallStep.failed && !self.already-gone;
    label: title.text;
    escaped => {
        Apps.close-modal();
    }
    title := Text {
        text: Apps.step == UninstallStep.checking ? @tr("Vérification…")
            : Apps.step == UninstallStep.refused ? @tr("{} ne peut pas être désinstallée", Apps.target)
            : Apps.step == UninstallStep.running ? @tr("Désinstallation de {}…", Apps.target)
            : Apps.step == UninstallStep.closing-app ? @tr("Fermeture de {}…", Apps.target)
            : Apps.step == UninstallStep.not-closed ? @tr("{} ne s'est pas fermée", Apps.target)
            : root.already-gone ? @tr("{} est déjà désinstallée", Apps.target)
            : root.failed ? @tr("{} n'a pas été désinstallée", Apps.target)
            : @tr("Désinstaller {} ?", Apps.target);
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        wrap: word-wrap;
    }
    if Apps.step == UninstallStep.checking || Apps.step == UninstallStep.closing-app || Apps.step == UninstallStep.running: ProgressBar {
        indeterminate: true;
        label: title.text;
    }
    if Apps.step == UninstallStep.confirm && Apps.app-open: Detail {
        text: @tr("{} est ouverte : Okapi va la fermer. Enregistrez d'abord votre travail.", Apps.target);
        wrap: word-wrap;
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.deb && !Apps.freed-known: Detail {
        text: Apps.going.length > 2
            ? @tr("{} et les paquets qui en dépendent partiront. Place libérée : inconnue.", Apps.target)
            : Apps.going.length == 2
            ? @tr("{} et un paquet qui en dépend partiront. Place libérée : inconnue.", Apps.target)
            : @tr("Place libérée : inconnue.");
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.deb && Apps.freed-known: Detail {
        text: Apps.going.length > 2
            ? @tr("{} et {} paquets qui en dépendent partiront. Place libérée : {}.", Apps.target, Apps.going.length - 1, Words.size(Apps.freed))
            : Apps.going.length == 2
            ? @tr("{} et un paquet qui en dépend partiront. Place libérée : {}.", Apps.target, Words.size(Apps.freed))
            : @tr("Place libérée : {}.", Words.size(Apps.freed));
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.flatpak: Detail {
        text: Apps.freed-known ? @tr("Place libérée : {}.", Words.size(Apps.freed)) : @tr("Place libérée : inconnue.");
    }
    // A flatpak's named one by one too: flatpak's helper removes them as root.
    if (Apps.step == UninstallStep.confirm && (Apps.target-source == AppSource.deb || Apps.target-source == AppSource.flatpak) && Apps.going.length > 1) || (Apps.step == UninstallStep.refused && Apps.going.length > 0): Detail {
        text: @tr("Ce qui partirait : {}", AppWords.names(Apps.going));
        wrap: word-wrap;
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.deb: Detail {
        text: @tr("Ses réglages dans votre dossier personnel restent en place : vous les retrouvez si vous la réinstallez.");
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.flatpak: Detail {
        text: @tr("Ses données dans votre dossier personnel restent en place, ainsi que les environnements qu'elle utilisait.");
        wrap: word-wrap;
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.snap: Detail {
        text: Apps.freed-known ? @tr("Place libérée : {}, anciennes versions comprises.", Words.size(Apps.freed))
            : @tr("Place libérée : inconnue.");
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.snap: data-box := Rectangle {
        accessible-role: checkbox;
        accessible-checkable: true;
        accessible-checked: Apps.purge;
        accessible-label: data-text.text;
        accessible-action-default => {
            Apps.purge = !Apps.purge;
        }
        forward-focus: data-keys;
        data-keys := FocusScope {
            key-pressed(event) => {
                if !event.repeat && event.text == Key.Space {
                    Apps.purge = !Apps.purge;
                    return accept;
                }
                reject
            }
        }
        TouchArea {
            clicked => {
                Apps.purge = !Apps.purge;
            }
        }
        FocusRing {
            shown: data-keys.has-focus;
            border-radius: Theme.radius-medium;
        }
        HorizontalLayout {
            padding: Theme.spacing-xs;
            spacing: Theme.spacing-s;
            CheckMark {
                checked: Apps.purge;
                cross-axis-self-alignment: center;
            }
            data-text := SilentDetail {
                text: Apps.has-data ? @tr("Supprimer aussi ses données ({})", Words.size(Apps.data-size)) : @tr("Supprimer aussi ses données");
                vertical-alignment: center;
            }
        }
    }
    if Apps.step == UninstallStep.confirm && Apps.target-source == AppSource.snap: Detail {
        text: Apps.purge ? @tr("Ses données partent tout de suite, pour tous les comptes et celles du système, sans copie gardée.")
            : @tr("Une copie de ses données (de tous les comptes et du système) est gardée 31 jours par le système.");
    }
    if Apps.step == UninstallStep.confirm: Detail {
        text: Apps.target-source == AppSource.flatpak ? @tr("Votre mot de passe peut vous être demandé.") : @tr("Votre mot de passe vous sera demandé.");
    }
    if Apps.step == UninstallStep.refused: Detail {
        text: @tr("La désinstaller retirerait aussi des paquets dont le système a besoin. Rien n'a été modifié.");
    }
    if Apps.step == UninstallStep.running: Detail {
        text: Apps.closing && Apps.target-source == AppSource.flatpak ? @tr("Une désinstallation est en cours. Fermez encore Okapi pour le quitter quand même : elle peut rester inachevée, et ne sera pas inscrite à l'historique.")
            : Apps.closing ? @tr("Une désinstallation est en cours. Fermez encore Okapi pour le quitter quand même : elle se terminera sans lui, et ne sera pas inscrite à l'historique.")
            : Apps.waiting ? @tr("Une autre installation est en cours : Okapi attend son tour.")
            : Apps.too-late ? @tr("Trop tard pour annuler : le système termine.")
            : @tr("Fermer cette fenêtre n'arrête pas la désinstallation.");
    }
    if Apps.step == UninstallStep.closing-app && Apps.closing: Detail {
        text: @tr("Fermez encore Okapi pour le quitter quand même : {} ne sera pas désinstallée.", Apps.target);
        wrap: word-wrap;
    }
    if Apps.step == UninstallStep.not-closed: Detail {
        text: @tr("Si vous la forcez à se fermer, ce qu'elle n'a pas enregistré sera perdu.");
        wrap: word-wrap;
    }
    if root.failed: Detail {
        text: AppWords.why(Apps.why, Apps.why-detail);
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        close := ActionButton {
            text: Apps.step == UninstallStep.confirm || Apps.step == UninstallStep.checking || Apps.step == UninstallStep.not-closed ? @tr("Annuler") : @tr("Fermer");
            kind: ButtonKind.ghost;
            clicked => {
                Apps.close-modal();
            }
        }
        if Apps.step == UninstallStep.running && Apps.target-source == AppSource.deb: ActionButton {
            text: @tr("Annuler la désinstallation");
            enabled: Apps.cancellable;
            clicked => {
                Apps.cancel();
            }
        }
        if root.failed: ActionButton {
            text: @tr("Réessayer");
            clicked => {
                Apps.retry();
            }
        }
        if Apps.step == UninstallStep.not-closed: ActionButton {
            text: @tr("Forcer la fermeture");
            kind: ButtonKind.danger;
            clicked => {
                Apps.force();
            }
        }
        if Apps.step == UninstallStep.confirm: ActionButton {
            text: Apps.app-open ? @tr("Fermer et désinstaller") : @tr("Désinstaller");
            kind: ButtonKind.danger;
            clicked => {
                Apps.confirm();
            }
        }
    }
    init => {
        close.focus();
    }
}

// What an uninstallation done says, for a while.
component Toast inherits Rectangle {
    property <bool> held: touch.has-hover || dismiss.focused;
    changed held => {
        Apps.toast-held(self.held);
    }
    width: Theme.toast-width;
    height: line.preferred-height;
    border-radius: Theme.radius-large;
    background: Theme.surface;
    border-width: Theme.border-width;
    border-color: Theme.border-strong;
    drop-shadow-color: Theme.shadow-1;
    drop-shadow-blur: Theme.shadow-1-blur;
    drop-shadow-offset-y: Theme.shadow-1-offset;
    accessible-role: AccessibleRole.text;
    accessible-label: words.text;
    accessible-live-region: polite;
    touch := TouchArea { }
    line := HorizontalLayout {
        padding: Theme.spacing-m;
        padding-left: Theme.spacing-l;
        spacing: Theme.spacing-m;
        words := Text {
            horizontal-stretch: 1;
            property <string> gone: Apps.toast-freed-known ? @tr("{} désinstallée : {} libérés", Apps.toast-name, Words.size(Apps.toast-freed))
                : @tr("{} désinstallée", Apps.toast-name);
            property <string> done: Apps.toast-partly ? @tr("{}. Certaines de ses extensions sont restées installées", self.gone) : self.gone;
            text: Apps.toast-recorded ? self.done : @tr("{}. Elle n'a pas pu être inscrite à l'historique.", self.done);
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
        dismiss := ActionButton {
            kind: ButtonKind.ghost;
            icon: @image-url("../assets/icons/x.svg");
            text: "";
            accessible-label: @tr("Fermer la notification");
            clicked => {
                Apps.close-toast();
            }
        }
    }
}

// A tab: the one shown bold, underlined with the accent, said chosen.
component Tab inherits Rectangle {
    in property <string> text;
    in property <AppsTab> tab;
    // Said beside its name when not empty.
    in property <string> badge;
    property <bool> chosen: Apps.tab == root.tab;
    height: Theme.app-tab-height;
    accessible-role: AccessibleRole.tab;
    accessible-label: root.badge == "" ? root.text : @tr("{}, {}", root.text, root.badge);
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-action-default => {
        Apps.tab = root.tab;
    }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                Apps.tab = root.tab;
                return accept;
            }
            reject
        }
    }
    TouchArea {
        clicked => {
            Apps.tab = root.tab;
        }
    }
    FocusRing {
        shown: keys.has-focus;
        border-radius: Theme.radius-medium;
    }
    HorizontalLayout {
        padding-left: Theme.spacing-m;
        padding-right: Theme.spacing-m;
        spacing: Theme.spacing-s;
        Text {
            text: root.text;
            accessible-role: none;
            color: root.chosen ? Theme.text : Theme.text-2;
            font-weight: root.chosen ? Theme.weight-semibold : Theme.weight-medium;
            vertical-alignment: center;
        }
        if root.badge != "": Badge {
            text: root.badge;
            tone: Theme.text-2;
            tone-soft: Theme.surface-2;
            y: (parent.height - self.height) / 2;
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: Theme.focus-width;
        background: root.chosen ? Theme.accent : transparent;
    }
}

// A folder an application uninstalled left: checked to go to the trash,
// or, too large to be checked, only shown.
component LeftoverRow inherits Rectangle {
    in property <LeftoverLine> line;
    in property <int> index;
    // The current line of the list that has the keyboard.
    in property <bool> focused;
    property <string> label: line.source == AppSource.snap
        ? (line.known ? @tr("Données de {} (snap désinstallé)", line.name) : @tr("Données de {} (aucun snap de ce nom)", line.name))
        : (line.known ? @tr("Données de {} (flatpak désinstallé)", line.name) : @tr("Données de {} (aucun flatpak de ce nom)", line.name));
    property <bool> toggles: line.checkable && !Leftovers.busy;
    // Fixed: the list scrolls to a line by its rank.
    height: Theme.app-row-height;
    accessible-role: list-item;
    accessible-checkable: line.checkable;
    accessible-checked: line.checked;
    accessible-label: line.checkable ? @tr("{}, {}, {}", root.label, line.path, Words.size(line.size))
        : @tr("{}, {}, trop de fichiers pour être vérifié", root.label, line.path);
    accessible-action-default => {
        if root.toggles {
            Leftovers.toggle(root.index);
        }
    }
    TouchArea {
        enabled: root.toggles;
        clicked => {
            Leftovers.toggle(root.index);
        }
    }
    FocusRing {
        shown: root.focused;
        border-radius: Theme.radius-medium;
    }
    HorizontalLayout {
        padding-left: Theme.spacing-l;
        padding-right: Theme.spacing-l;
        spacing: Theme.spacing-m;
        if line.checkable: CheckMark {
            checked: line.checked;
            y: (parent.height - self.height) / 2;
        }
        Icon {
            source: @image-url("../assets/icons/folder.svg");
            colorize: Theme.text-2;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.label;
                accessible-role: none;
                color: Theme.text;
                overflow: elide;
            }
            SilentDetail {
                text: line.checkable ? line.path : @tr("Trop de fichiers pour être vérifié : {}", line.path);
                overflow: elide;
            }
        }
        if line.checkable: Text {
            text: Words.size(line.size);
            accessible-role: none;
            color: Theme.text;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: Theme.border-width;
        background: Theme.border;
    }
}

// A copy snapd keeps of a snap no longer installed, to forget.
component CopyRow inherits Rectangle {
    in property <CopyLine> line;
    in property <int> index;
    // Fixed: its list is as high as a few of them.
    height: Theme.app-row-height;
    HorizontalLayout {
        padding-left: Theme.spacing-l;
        padding-right: Theme.spacing-l;
        spacing: Theme.spacing-m;
        Icon {
            source: @image-url("../assets/icons/history.svg");
            colorize: Theme.text-2;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Copie automatique de {}, faite {}", line.name, DashboardWords.moment(line.made));
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: Words.size(line.size);
            color: Theme.text;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
        ActionButton {
            text: @tr("Oublier");
            kind: ButtonKind.ghost;
            accessible-label: @tr("Oublier la copie de {}", line.name);
            // Never while folders are checked: they hold the reading after.
            enabled: !Leftovers.busy && Leftovers.checked-count == 0;
            y: (parent.height - self.height) / 2;
            clicked => {
                Leftovers.forget(root.index);
            }
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: Theme.border-width;
        background: Theme.border;
    }
}

// The leftovers, by the keyboard too: the arrows move, Space ticks.
component LeftoverLines inherits FocusScope {
    accessible-role: list;
    accessible-label: @tr("Données laissées dans votre dossier personnel");
    property <int> current;
    // A list grown shorter keeps its line in it.
    property <int> count: Leftovers.lines.length;
    changed count => {
        root.current = max(0, min(root.current, root.count - 1));
    }

    function show(index: int) {
        let place = index * Theme.app-row-height;
        if place < -view.content-y {
            view.content-y = -place;
        } else if place + Theme.app-row-height > -view.content-y + view.visible-height {
            view.content-y = view.visible-height - place - Theme.app-row-height;
        }
    }

    function move(index: int) {
        if Leftovers.lines.length == 0 {
            return;
        }
        root.current = clamp(index, 0, Leftovers.lines.length - 1);
        root.show(root.current);
    }

    key-pressed(event) => {
        if event.text == Key.DownArrow {
            root.move(root.current + 1);
            return accept;
        }
        if event.text == Key.UpArrow {
            root.move(root.current - 1);
            return accept;
        }
        if event.text == Key.Home {
            root.move(0);
            return accept;
        }
        if event.text == Key.End {
            root.move(Leftovers.lines.length - 1);
            return accept;
        }
        if event.text == Key.Space && !event.repeat && Leftovers.lines.length > 0 {
            Leftovers.toggle(root.current);
            return accept;
        }
        reject
    }

    view := ListView {
        for line[index] in Leftovers.lines: LeftoverRow {
            line: line;
            index: index;
            focused: root.has-focus && root.current == index;
        }
    }
}

// What applications uninstalled left: the folders to move to the trash,
// the packages' settings the system keeps, or nothing.
component LeftoversView inherits VerticalLayout {
    spacing: Theme.spacing-l;
    if Leftovers.blocked == LeftoversBlock.settings: Banner {
        warning: true;
        text: @tr("Les réglages d'Okapi n'ont pas pu être lus : aucun reste n'est proposé. Le détail est dans le journal.");
    }
    if Leftovers.blocked == LeftoversBlock.variables: Banner {
        warning: true;
        text: @tr("Les dossiers du système n'ont pas pu être vérifiés : aucun reste n'est proposé. Le détail est dans le journal.");
    }
    if Leftovers.snaps-unread: Banner {
        warning: true;
        text: @tr("Les données des snaps n'ont pas pu être vérifiées : aucune n'est proposée. Le détail est dans le journal.");
    }
    if Leftovers.flatpaks-unread: Banner {
        warning: true;
        text: @tr("Les données des flatpaks n'ont pas pu être vérifiées : aucune n'est proposée. Le détail est dans le journal.");
    }
    if Leftovers.analysis-failed: Banner {
        warning: true;
        text: Leftovers.searched ? @tr("La dernière recherche des restes n'a pas abouti : la liste peut être ancienne. Le détail est dans le journal.")
            : @tr("La recherche des restes n'a pas abouti. Le détail est dans le journal.");
    }
    if Leftovers.receipt: Banner {
        warning: Leftovers.trash-failed || Leftovers.trash-interrupted || Leftovers.kept > 0 || Leftovers.unchecked > 0;
        text: Leftovers.trash-failed ? @tr("Rien n'a été mis à la corbeille. Le détail est dans le journal.")
            : Leftovers.trash-interrupted ? @tr("La mise à la corbeille s'est interrompue : regardez la corbeille pour savoir ce qui y est. Le détail est dans le journal.")
            : Leftovers.kept == 0 && Leftovers.unchecked == 0
            ? (Leftovers.trashed == 1 ? @tr("Un dossier mis à la corbeille : {}.", Words.size(Leftovers.trashed-size))
                : @tr("{} dossiers mis à la corbeille : {}.", Leftovers.trashed, Words.size(Leftovers.trashed-size)))
            : Leftovers.unchecked == 0
            ? @tr("Mis à la corbeille : {} ({}). Laissés en place : {}. Le détail est dans le journal.",
                Leftovers.trashed, Words.size(Leftovers.trashed-size), Leftovers.kept)
            : @tr("Mis à la corbeille : {} ({}). Laissés en place : {}. À vérifier dans la corbeille : {}. Le détail est dans le journal.",
                Leftovers.trashed, Words.size(Leftovers.trashed-size), Leftovers.kept, Leftovers.unchecked);
        ActionButton {
            kind: ButtonKind.ghost;
            icon: @image-url("../assets/icons/x.svg");
            text: "";
            accessible-label: @tr("Fermer le message");
            clicked => {
                Leftovers.close-receipt();
            }
        }
    }
    if Leftovers.withheld > 0: Banner {
        warning: true;
        text: Leftovers.withheld == 1 ? @tr("Un dossier n'est pas proposé par sécurité : un montage ou des fichiers d'un autre utilisateur, ou une lecture impossible. Le détail est dans le journal.")
            : @tr("{} dossiers ne sont pas proposés par sécurité : un montage ou des fichiers d'un autre utilisateur, ou une lecture impossible. Le détail est dans le journal.", Leftovers.withheld);
    }
    if Leftovers.copies-unread: Banner {
        warning: true;
        text: @tr("Les copies gardées par snapd n'ont pas pu être lues. Le détail est dans le journal.");
    }
    if Leftovers.forgot != ForgetOutcome.none: Banner {
        warning: Leftovers.forgot != ForgetOutcome.forgotten && Leftovers.forgot != ForgetOutcome.gone;
        text: Leftovers.forgot == ForgetOutcome.forgotten ? @tr("Copie de {} oubliée : {} rendus.", Leftovers.forgot-name, Words.size(Leftovers.forgot-size))
            : Leftovers.forgot == ForgetOutcome.gone ? @tr("La copie de {} n'est plus là : snapd l'a sans doute déjà effacée.", Leftovers.forgot-name)
            : Leftovers.forgot == ForgetOutcome.reinstalled ? @tr("{} est de nouveau installé : sa copie est gardée.", Leftovers.forgot-name)
            : Leftovers.forgot == ForgetOutcome.refused ? @tr("La copie de {} est gardée : les droits n'ont pas été donnés.", Leftovers.forgot-name)
            : Leftovers.forgot == ForgetOutcome.busy ? @tr("snapd est occupé par une autre opération : la copie de {} est gardée. Réessayez dans un moment.", Leftovers.forgot-name)
            : Leftovers.forgot == ForgetOutcome.unknown ? @tr("snapd n'a pas dit à temps si la copie de {} est oubliée : la liste relue le montre.", Leftovers.forgot-name)
            : @tr("La copie de {} n'a pas pu être oubliée. Le détail est dans le journal.", Leftovers.forgot-name);
        ActionButton {
            kind: ButtonKind.ghost;
            icon: @image-url("../assets/icons/x.svg");
            text: "";
            accessible-label: @tr("Fermer le message");
            clicked => {
                Leftovers.close-forgot();
            }
        }
    }
    if Leftovers.forgetting: ProgressBar {
        indeterminate: true;
        label: @tr("snapd efface la copie…");
    }
    if Leftovers.trashing: ProgressBar {
        indeterminate: true;
        label: @tr("Mise à la corbeille…");
    }
    if Leftovers.lines.length > 0: Card {
        vertical-stretch: 1;
        VerticalLayout {
            HorizontalLayout {
                padding: Theme.spacing-l;
                spacing: Theme.spacing-m;
                Text {
                    horizontal-stretch: 1;
                    text: @tr("Données laissées dans votre dossier personnel");
                    color: Theme.text;
                    font-weight: Theme.weight-semibold;
                }
                if Leftovers.has-total: Detail {
                    text: Words.size(Leftovers.total);
                }
            }
            Rectangle {
                height: Theme.border-width;
                background: Theme.border;
            }
            LeftoverLines {
                vertical-stretch: 1;
            }
            Rectangle {
                background: Theme.surface-2;
                HorizontalLayout {
                    padding: Theme.spacing-m;
                    padding-left: Theme.spacing-l;
                    spacing: Theme.spacing-m;
                    Detail {
                        horizontal-stretch: 1;
                        accessible-role: text;
                        // What is checked, never a phrase beside the button.
                        text: Leftovers.checked-count == 0 ? ""
                            : Leftovers.checked-count == 1 ? @tr("Un dossier coché : {}.", Words.size(Leftovers.checked-size))
                            : @tr("{} dossiers cochés : {}.", Leftovers.checked-count, Words.size(Leftovers.checked-size));
                        vertical-alignment: center;
                    }
                    ActionButton {
                        text: @tr("Mettre à la corbeille");
                        kind: ButtonKind.danger;
                        enabled: Leftovers.checked-count > 0 && !Leftovers.busy;
                        clicked => {
                            Leftovers.trash();
                        }
                    }
                }
            }
        }
    }
    if Leftovers.copies.length > 0: Card {
        // Its own height: the folders' list takes what is left.
        vertical-stretch: 0;
        VerticalLayout {
            alignment: start;
            VerticalLayout {
                padding: Theme.spacing-l;
                spacing: Theme.spacing-xs;
                Text {
                    text: @tr("Copies automatiques gardées par le système");
                    color: Theme.text;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }
                Detail {
                    text: @tr("snapd garde 31 jours (sauf réglage) une copie des données d'un snap désinstallé, pour tous les comptes.");
                    wrap: word-wrap;
                }
            }
            Rectangle {
                height: Theme.border-width;
                background: Theme.border;
            }
            // A few rows high, scrolled past: many copies never push the
            // window's minimum.
            ListView {
                height: min(Leftovers.copies.length, Theme.copies-shown) * Theme.app-row-height;
                for line[index] in Leftovers.copies: CopyRow {
                    line: line;
                    index: index;
                }
            }
        }
    }
    if Leftovers.residual > 0: Card {
        VerticalLayout {
            padding: Theme.spacing-l;
            spacing: Theme.spacing-xs;
            Text {
                text: Leftovers.residual == 1 ? @tr("Réglages système laissés par un paquet Ubuntu désinstallé")
                    : @tr("Réglages système laissés par {} paquets Ubuntu désinstallés", Leftovers.residual);
                color: Theme.text;
                font-weight: Theme.weight-semibold;
                wrap: word-wrap;
            }
            Detail {
                text: @tr("Gardés pour une réinstallation. Okapi n'y touche pas.");
                wrap: word-wrap;
            }
        }
    }
    if Leftovers.searched && !Leftovers.analysing && !Leftovers.snaps-unread && !Leftovers.flatpaks-unread && Leftovers.withheld == 0 && Leftovers.lines.length == 0 && Leftovers.residual == 0 && Leftovers.copies.length == 0 && !Leftovers.copies-unread: Card {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            padding: Theme.spacing-xxl;
            spacing: Theme.spacing-s;
            Text {
                text: @tr("Aucun reste trouvé");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
            }
        }
    }
    if Leftovers.lines.length == 0: Rectangle {
        vertical-stretch: 1;
    }
}

// Asked once before folders go to the trash. Closed by its buttons or
// Escape, never by a click outside.
component LeftoversConfirm inherits ModalFrame {
    label: question.text;
    escaped => {
        Leftovers.cancel();
    }
    question := Text {
        text: Leftovers.checked-count == 1 ? @tr("Mettre un dossier à la corbeille ?")
            : @tr("Mettre {} dossiers à la corbeille ?", Leftovers.checked-count);
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        wrap: word-wrap;
    }
    Detail {
        text: Leftovers.checked-count == 1 ? @tr("{}. Vous pourrez le restaurer depuis la corbeille.", Words.size(Leftovers.checked-size))
            : @tr("{}. Vous pourrez les restaurer depuis la corbeille.", Words.size(Leftovers.checked-size));
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        cancel := ActionButton {
            text: @tr("Annuler");
            kind: ButtonKind.ghost;
            clicked => {
                Leftovers.cancel();
            }
        }
        ActionButton {
            text: @tr("Mettre à la corbeille");
            kind: ButtonKind.danger;
            clicked => {
                Leftovers.confirm();
            }
        }
    }
    init => {
        cancel.focus();
    }
}

// Asked before snapd forgets a copy: for every account, for good. Closed by
// its buttons or Escape, never by a click outside.
component ForgetConfirm inherits ModalFrame {
    label: question.text;
    escaped => {
        Leftovers.cancel-forget();
    }
    question := Text {
        text: @tr("Oublier la copie de {} ?", Leftovers.forget-name);
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        wrap: word-wrap;
    }
    Detail {
        text: @tr("{}. snapd l'efface pour tous les comptes : c'est définitif.", Words.size(Leftovers.forget-size));
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        cancel := ActionButton {
            text: @tr("Annuler");
            kind: ButtonKind.ghost;
            clicked => {
                Leftovers.cancel-forget();
            }
        }
        ActionButton {
            text: @tr("Oublier");
            kind: ButtonKind.danger;
            clicked => {
                Leftovers.confirm-forget();
            }
        }
    }
    init => {
        cancel.focus();
    }
}

// A filter of the segmented control: the one chosen raised, bold, ticked.
component Segment inherits Rectangle {
    in property <string> text;
    in property <AppsFilter> filter;
    property <bool> chosen: Apps.filter == root.filter;
    height: Theme.app-seg-height;
    border-radius: Theme.radius-medium;
    background: chosen ? Theme.surface : transparent;
    border-width: chosen ? Theme.border-width : 0;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    accessible-action-default => {
        Apps.filter = root.filter;
        Apps.filtered();
    }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                Apps.filter = root.filter;
                Apps.filtered();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        clicked => {
            Apps.filter = root.filter;
            Apps.filtered();
        }
    }
    FocusRing {
        shown: keys.has-focus;
        border-radius: root.border-radius;
    }
    HorizontalLayout {
        padding-left: Theme.spacing-m;
        padding-right: Theme.spacing-m;
        spacing: Theme.spacing-xs;
        if root.chosen: Icon {
            source: @image-url("../assets/icons/check.svg");
            colorize: Theme.text;
            width: Theme.icon-badge;
            height: Theme.icon-badge;
            cross-axis-self-alignment: center;
        }
        Text {
            text: root.text;
            accessible-role: none;
            color: root.chosen ? Theme.text : Theme.text-2;
            font-size: Theme.font-small;
            font-weight: root.chosen ? Theme.weight-semibold : Theme.weight-medium;
            vertical-alignment: center;
        }
    }
}

export component AppsPage inherits Rectangle {
    // Opened and closed by Rust, which keeps what it follows; a page built
    // again shows the uninstallation still open.
    property <bool> asking: Apps.step != UninstallStep.closed;
    init => {
        if self.asking {
            uninstall.show();
        }
        if self.confirming {
            confirm.show();
        }
        if self.forget-asking {
            forget.show();
        }
        if self.retire-asking {
            retire.show();
        }
    }
    changed asking => {
        if self.asking {
            uninstall.show();
        } else {
            uninstall.close();
        }
    }
    property <bool> detail-shown: Apps.chosen >= 0;

    uninstall := Uninstall {
        x: (root.width - Theme.modal-width) / 2;
        y: root.height / 4;
        width: Theme.modal-width;
    }

    // Opened and closed by Rust too.
    property <bool> confirming: Leftovers.confirming;
    changed confirming => {
        if self.confirming {
            confirm.show();
        } else {
            confirm.close();
        }
    }
    confirm := LeftoversConfirm {
        x: (root.width - Theme.modal-width) / 2;
        y: root.height / 4;
        width: Theme.modal-width;
    }

    property <bool> forget-asking: Leftovers.forget-asking;
    changed forget-asking => {
        if self.forget-asking {
            forget.show();
        } else {
            forget.close();
        }
    }
    forget := ForgetConfirm {
        x: (root.width - Theme.modal-width) / 2;
        y: root.height / 4;
        width: Theme.modal-width;
    }

    property <bool> retire-asking: OldVersions.confirming;
    changed retire-asking => {
        if self.retire-asking {
            retire.show();
        } else {
            retire.close();
        }
    }
    retire := OldVersionsConfirm {
        x: (root.width - Theme.modal-width) / 2;
        y: root.height / 6;
        width: Theme.modal-width;
    }

    keys := FocusScope {
        key-pressed(event) => {
            if Apps.tab == AppsTab.installed && event.modifiers.control && (event.text == "f" || event.text == "F") {
                search.focus();
                return accept;
            }
            if event.text == Key.Escape && Apps.tab == AppsTab.installed && root.detail-shown {
                Apps.close-detail();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: Screen.page-margin;
            spacing: Theme.spacing-l;
            HorizontalLayout {
                spacing: Theme.spacing-s;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.spacing-xs;
                    TitleLine {
                        text: @tr("Applications");
                        loading: Apps.reading || (Apps.tab == AppsTab.leftovers && Leftovers.analysing)
                            || (Apps.tab == AppsTab.old-versions && OldVersions.finding);
                        loading-text: Apps.reading ? @tr("Lecture des applis installées…")
                            : Apps.tab == AppsTab.leftovers ? @tr("Recherche des restes…")
                            : @tr("Recherche des anciennes versions…");
                    }
                    Detail {
                        text: Apps.minutes-ago < 0 ? ""
                            : Apps.minutes-ago < 1 ? @tr("Applis : {}, lues à l'instant", Apps.app-count)
                            : @tr("Applis : {}, lues il y a {} min", Apps.app-count, Apps.minutes-ago);
                    }
                }
                ActionButton {
                    text: @tr("Actualiser");
                    icon: @image-url("../assets/icons/rotate-ccw.svg");
                    enabled: !Apps.reading && !Apps.busy;
                    cross-axis-self-alignment: center;
                    clicked => {
                        Apps.refresh();
                    }
                }
            }
            VerticalLayout {
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.spacing-xs;
                    Tab {
                        text: @tr("Installées");
                        tab: AppsTab.installed;
                    }
                    Tab {
                        text: @tr("Restes d'applis désinstallées");
                        tab: AppsTab.leftovers;
                        badge: Leftovers.has-total ? Words.size(Leftovers.total) : "";
                    }
                    Tab {
                        text: @tr("Anciennes versions");
                        tab: AppsTab.old-versions;
                        badge: OldVersions.has-total ? Words.size(OldVersions.total) : "";
                    }
                }
                Rectangle {
                    height: Theme.border-width;
                    background: Theme.border;
                }
            }
            // Both tabs stay built, the other one hidden: the list keeps what
            // it holds and where it was scrolled, and the window's minimum
            // is that of either.
            Rectangle {
                vertical-stretch: 1;
                LeftoversView {
                    visible: Apps.tab == AppsTab.leftovers;
                }
                OldVersionsView {
                    visible: Apps.tab == AppsTab.old-versions;
                }
                VerticalLayout {
                    visible: Apps.tab == AppsTab.installed;
                    spacing: Theme.spacing-l;
                    if Apps.debs == SourceShown.busy: Banner {
                        warning: true;
                        text: @tr("Les paquets Ubuntu ne sont pas lisibles pour l'instant : une installation est en cours.");
                    }
                    if Apps.debs == SourceShown.failed: Banner {
                        warning: true;
                        text: @tr("Les paquets Ubuntu n'ont pas pu être lus. Le détail est dans le journal.");
                    }
                    if Apps.snaps == SourceShown.failed: Banner {
                        warning: true;
                        text: @tr("Les snaps ne sont pas lisibles : le service snapd ne répond pas.");
                    }
                    if Apps.flatpaks == SourceShown.failed: Banner {
                        warning: true;
                        text: @tr("Les flatpaks n'ont pas pu être lus. Le détail est dans le journal.");
                    }
                    if Apps.flatpaks == SourceShown.partial: Banner {
                        warning: true;
                        text: @tr("Une partie des flatpaks n'a pas pu être lue : certains peuvent manquer. Le détail est dans le journal.");
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing-m;
                        search := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: @tr("Chercher une appli ou un paquet");
                            text <=> Apps.search;
                            edited => {
                                Apps.searched();
                            }
                        }
                        Rectangle {
                            border-radius: Theme.radius-medium;
                            background: Theme.surface-2;
                            border-width: Theme.border-width;
                            border-color: Theme.border-strong;
                            accessible-role: groupbox;
                            accessible-label: @tr("Source");
                            HorizontalLayout {
                                padding: Theme.spacing-xxs;
                                spacing: Theme.spacing-xxs;
                                Segment {
                                    text: @tr("Toutes");
                                    filter: AppsFilter.all;
                                }
                                Segment {
                                    text: @tr("Ubuntu");
                                    filter: AppsFilter.deb;
                                }
                                Segment {
                                    text: @tr("Snap");
                                    filter: AppsFilter.snap;
                                }
                                if Apps.has-flatpak: Segment {
                                    text: @tr("Flatpak");
                                    filter: AppsFilter.flatpak;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: Theme.spacing-l;
                        if !(Screen.narrow && root.detail-shown): card := Card {
                            horizontal-stretch: 1;
                            // Sorted by `column`, the line of the keyboard kept in view.
                            function sort-by(column: AppsSort) {
                                Apps.sort-by(column);
                                lines.reveal();
                            }
                            VerticalLayout {
                                padding-top: Theme.spacing-xs;
                                HorizontalLayout {
                                    padding-left: Theme.spacing-l + Theme.app-icon + Theme.spacing-m;
                                    padding-right: Theme.spacing-l;
                                    spacing: Theme.spacing-m;
                                    height: Theme.control-height;
                                    SortHeader {
                                        horizontal-stretch: 1;
                                        text: @tr("Nom");
                                        applied: Apps.sort == AppsSort.name;
                                        descending: Apps.descending;
                                        sorted => {
                                            card.sort-by(AppsSort.name);
                                        }
                                    }
                                    SortHeader {
                                        width: Theme.app-col-size;
                                        text: @tr("Appli");
                                        applied: Apps.sort == AppsSort.app;
                                        descending: Apps.descending;
                                        trailing: true;
                                        sorted => {
                                            card.sort-by(AppsSort.app);
                                        }
                                    }
                                    SortHeader {
                                        width: Theme.app-col-data;
                                        text: @tr("Données");
                                        applied: Apps.sort == AppsSort.data;
                                        descending: Apps.descending;
                                        trailing: true;
                                        sorted => {
                                            card.sort-by(AppsSort.data);
                                        }
                                    }
                                    SortHeader {
                                        width: Screen.narrow ? Theme.app-bar-width-narrow : Theme.app-bar-width;
                                        text: @tr("Place prise");
                                        applied: Apps.sort == AppsSort.total;
                                        descending: Apps.descending;
                                        trailing: true;
                                        sorted => {
                                            card.sort-by(AppsSort.total);
                                        }
                                    }
                                }
                                Rectangle {
                                    height: Theme.border-width;
                                    background: Theme.border;
                                }
                                // Never built again while a search is typed: it would take
                                // the keyboard from the search.
                                Rectangle {
                                    vertical-stretch: 1;
                                    lines := Lines {
                                        visible: Apps.lines.length > 0 || Apps.search == "";
                                    }
                                    if Apps.lines.length == 0 && Apps.search != "": VerticalLayout {
                                    alignment: center;
                                    padding: Theme.spacing-xxl;
                                    spacing: Theme.spacing-s;
                                    Text {
                                        text: @tr("Aucune appli ne correspond à « {} »", Apps.search);
                                        color: Theme.text;
                                        font-weight: Theme.weight-semibold;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                    Detail {
                                        text: @tr("La recherche porte sur le nom de l'appli et sur le nom de son paquet, dans toutes les sources.");
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        ActionButton {
                                            text: @tr("Effacer la recherche");
                                            kind: ButtonKind.ghost;
                                            clicked => {
                                                Apps.search = "";
                                                Apps.searched();
                                            }
                                        }
                                    }
                                }
                                }
                                Rest { }
                            }
                        }
                        if root.detail-shown: Panel { }
                    }
                }
            }
        }
    }

    if Apps.toast: Toast {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - Theme.spacing-xl;
    }
}
