// What the cleaner shows, as Rust fills it (src/cleaner.rs), and the words
// every part of it shares.
import { Theme } from "theme.slint";
import { Banner } from "widgets.slint";

export enum CategoryKind { system, browsers, apps, gaming, gpu }

export struct CategoryChoice {
    kind: CategoryKind,
    checked: bool,
    // None of its rules is chosen by default: cache resets (invariant 5).
    to-choose: bool,
}

// Why an analysis or a cleaning cannot start; the detail is in the journal.
export enum SetupProblem { none, variables, rules, settings, min-age, exclusion, history, start, rights-changed }

export enum CleanerStep { idle, planning, scanning, cancelling, outcome, results, cleaning, receipt }

export enum SizeUnit { byte, kilobyte, megabyte, gigabyte, terabyte }

// A size scaled by Rust (`okapi_engine::ByteSize`), worded here.
export struct Size {
    whole: int,
    tenths: int,
    has-tenths: bool,
    unit: SizeUnit,
}

// Where a line of work stands; not done: a cleaning step that ended short.
export enum RowState { waiting, running, done, not-done }

export struct ScanRow {
    kind: CategoryKind,
    state: RowState,
    // How far the running one is, from 0 to 1.
    progress: float,
    entries: int,
    size: Size,
    // The entry the running one reached.
    path: string,
}

export enum OutcomeKind { nothing-looked, nothing-to-clean, failed }

export enum StopReason { unsupported-system, missing-variable, unreadable-variable, min-age-beyond-clock }

export struct StopShown {
    reason: StopReason,
    // The variable a reason names, as the rules write it (`HOME`).
    variable: string,
}

export enum CheckState { checked, unchecked, partial }

// What a group of the results is: offered checked, left to the user (a
// cache reset, invariant 5), or out of reach without the administrator.
export enum ResultBadge { preselected, to-choose, admin }

// What a line of the results is: a category, a browser under the browsers'
// category, or a group.
export enum RowKind { category, browser, group }

// Where a group that needs the administrator stands: none for another;
// waiting for the rights; never the helper's to clean; nothing for root to
// clean; or unlocked by root's scan, to check by hand.
export enum AdminRow { none, locked, unreachable, nothing, unlocked }

// Where the rights asked for stand: their question open (the system asks for
// the password), root's scan under way, or cancelled and awaited.
export enum RightsStep { idle, authenticating, scanning, cancelling }

// Why the rights, or the administrator's part of a cleaning, gave nothing.
export enum RightsProblem {
    none, cancelled, dismissed, not-authorized, not-installed, outdated, failed, stopped, changed, unknown,
}

// Where the question about an open browser stands.
export enum BrowserStep {
    // Okapi can close it.
    ask,
    // Okapi cannot vouch for what holds its lock: it does not close it.
    unverified,
    // Asked to close, its lock awaited.
    closing,
    // Still open when the wait ended.
    not-closed,
    // The system refused to pass it the request.
    refused,
}

// One line of the results. The list never changes length: folding a category
// or a browser hides what is below.
export struct ResultRow {
    kind: RowKind,
    // A group under its browser's line.
    nested: bool,
    category: CategoryKind,
    // A group's label, from the rules.
    label: string,
    state: CheckState,
    // Its checkbox does something.
    enabled: bool,
    folded: bool,
    hidden: bool,
    badge: ResultBadge,
    admin: AdminRow,
    entries: int,
    size: Size,
}

export enum IssueKind {
    age-beyond-clock, unsupported, unresolvable, unreadable-root, unsafe-root, protected-root,
    excluded, depth-limit, entries-limit,
}

// A note of the analysis, and the path it is about (none for a rule).
export struct IssueShown {
    kind: IssueKind,
    path: string,
}

export enum CleanStepKind { admin, check, remove, history }

// A step of a cleaning: root's part, the check of each entry, their removal,
// the history line. Its bar runs `done` of `total`; with no total, a running
// step sweeps.
export struct CleanStep {
    kind: CleanStepKind,
    state: RowState,
    done: int,
    total: int,
}

export enum CleanEnding { done, cancelled, stopped, interrupted }

// What became of the history line of a cleaning.
export enum HistoryState { recorded, failed, unavailable, not-written }

export enum ReceiptKind {
    removed, partial, gone, recent, changed, replaced, excluded, protected, refused, cancelled,
    browser-open, unknown,
}

// An entry of a receipt line, and what kept it, or part of it, if anything.
export struct PathShown {
    path: string,
    blocked: string,
}

export struct ReceiptLineShown {
    kind: ReceiptKind,
    count: int,
    size: Size,
    paths: [PathShown],
    // How many more than the paths listed.
    more: int,
}

export global Cleaner {
    in property <CleanerStep> step;
    // The analysis under way covers the categories checked by default: its
    // result replaces the Home page's estimate.
    in property <bool> replaces-estimate;

    in property <[CategoryChoice]> choices;
    in property <int> chosen-count;
    in property <int> min-age-minutes;
    in property <int> exclusion-count;
    in property <SetupProblem> problem;
    // Set when an analysis is left: the focus then goes back to the
    // categories, once.
    in-out property <bool> back-from-analysis;

    in property <[ScanRow]> rows;
    in property <int> rows-done;
    in property <float> progress;
    in property <Size> found;
    in property <int> issues;

    in property <OutcomeKind> outcome;
    in property <[StopShown]> stops;

    in property <[ResultRow]> results;
    in property <[IssueShown]> notes;
    in property <Size> selected-size;
    in property <int> selected-entries;
    in property <int> result-entries;
    // The groups waiting for the rights, and where asking for them stands.
    in property <int> rights-waiting;
    in property <RightsStep> rights-step;
    in property <RightsProblem> rights-problem;

    // The confirmation: what it would remove.
    in property <bool> confirming;
    in property <int> confirm-entries;
    // The checkbox of the confirmation: Rust deletes nothing without it.
    in-out property <bool> understood;
    in property <Size> confirm-size;
    // Groups that need the administrator are confirmed: the system may ask
    // for the password.
    in property <bool> confirm-admin;
    // The question about an open browser, before a cleaning: the browser,
    // the labels of its caches the cleaning takes, and their size.
    in property <bool> browser-asking;
    in property <string> browser-name;
    in property <string> browser-caches;
    in property <Size> browser-size;
    in property <BrowserStep> browser-step;

    // The cleaning under way, step by step; ended, what each came to.
    in property <[CleanStep]> clean-steps;
    in property <Size> freed;
    in property <bool> clean-cancel-asked;
    // The administrator's part under way: its question, then root's work.
    in property <RightsStep> clean-rights;

    // The receipt.
    in property <CleanEnding> ending;
    in property <int> removed;
    in property <int> partial;
    in property <int> gone;
    in property <int> kept;
    in property <[ReceiptLineShown]> receipt-lines;
    in property <HistoryState> history;
    // The deletion log the user asked for is not written.
    in property <bool> deletion-log-lost;
    // The file of the user's choices among the results, when it could not
    // be read (empty otherwise): the results start as by default, and no
    // change is kept.
    in property <string> choices-unreadable;
    // The last change of the boxes could not be kept.
    in property <bool> choices-unsaved;
    // Why the administrator's part of the cleaning was not done.
    in property <RightsProblem> receipt-rights;

    callback toggle(int);
    callback confirm-delete();
    callback cancel-confirmation();
    callback ignore-browser();
    callback close-browser();
    callback cancel-browser();
    callback cancel-cleaning();
    callback finish();
    callback toggle-result(int);
    callback fold(int);
    callback deselect-all();
    callback clean();
    callback analyze();
    callback cancel();
    callback choose-again();
    callback obtain-rights();
    callback cancel-rights();
}

// The words and icons of a category, and the words of a size.
export global Words {
    pure public function category(kind: CategoryKind) -> string {
        if kind == CategoryKind.system {
            return @tr("Système");
        }
        if kind == CategoryKind.apps {
            return @tr("Applications");
        }
        if kind == CategoryKind.browsers {
            return @tr("Navigateurs");
        }
        if kind == CategoryKind.gaming {
            return @tr("Jeux");
        }
        // The GPU caches, the one kind left.
        return @tr("Caches GPU");
    }

    pure public function description(kind: CategoryKind) -> string {
        if kind == CategoryKind.system {
            return @tr("Journaux, fichiers temporaires, miniatures et caches de paquets.");
        }
        if kind == CategoryKind.apps {
            return @tr("Caches des applications installées.");
        }
        if kind == CategoryKind.browsers {
            return @tr("Caches de Chrome, Edge, Brave et des autres navigateurs Chromium.");
        }
        if kind == CategoryKind.gaming {
            return @tr("Steam, Heroic, Lutris et itch.io : journaux et caches.");
        }
        return @tr("Shaders Mesa et NVIDIA. Recréés ensuite : le prochain lancement des jeux sera plus lent.");
    }

    pure public function icon(kind: CategoryKind) -> image {
        if kind == CategoryKind.system {
            return @image-url("../assets/icons/monitor.svg");
        }
        if kind == CategoryKind.apps {
            return @image-url("../assets/icons/app-window.svg");
        }
        if kind == CategoryKind.browsers {
            return @image-url("../assets/icons/globe.svg");
        }
        if kind == CategoryKind.gaming {
            return @image-url("../assets/icons/gamepad.svg");
        }
        return @image-url("../assets/icons/cpu.svg");
    }

    // Why nothing was looked at, or touched.
    pure public function stop(stop: StopShown) -> string {
        if stop.reason == StopReason.unsupported-system {
            return @tr("Ce système ne permet pas de distinguer les points de montage et les fichiers remplacés.");
        }
        if stop.reason == StopReason.missing-variable {
            return @tr("La variable {} n'est pas définie : ce qu'elle protège ne peut pas être garanti.", stop.variable);
        }
        if stop.reason == StopReason.unreadable-variable {
            return @tr("Le dossier de la variable {} est illisible : ce qu'il protège ne peut pas être garanti.", stop.variable);
        }
        return @tr("L'âge minimal remonte avant l'horloge : rien ne serait assez ancien.");
    }

    // Why the rights, or the administrator's part, gave nothing.
    pure public function rights(problem: RightsProblem) -> string {
        if problem == RightsProblem.dismissed {
            return @tr("L'authentification a été annulée.");
        }
        if problem == RightsProblem.cancelled {
            return @tr("La demande a été annulée avant la fin.");
        }
        if problem == RightsProblem.not-authorized {
            return @tr("Les droits administrateur ont été refusés, ou la demande n'a pas pu aboutir. Le détail est dans le journal.");
        }
        if problem == RightsProblem.not-installed {
            return @tr("L'assistant administrateur n'est pas installé : lancez packaging/linux/install-helper.sh.");
        }
        if problem == RightsProblem.outdated {
            return @tr("L'assistant administrateur installé n'est pas à jour : relancez packaging/linux/install-helper.sh.");
        }
        if problem == RightsProblem.stopped {
            return @tr("L'assistant administrateur s'est arrêté avant d'avoir fini. Le détail est dans le journal.");
        }
        if problem == RightsProblem.changed {
            return @tr("Une partie de ce que l'assistant administrateur devait nettoyer a changé depuis l'obtention des droits : elle n'a pas été nettoyée en entier. Le détail est dans le journal.");
        }
        if problem == RightsProblem.unknown {
            return @tr("L'assistant administrateur s'est interrompu : des éléments ont pu être supprimés. Le détail est dans le journal.");
        }
        return @tr("L'assistant administrateur a échoué. Le détail est dans le journal.");
    }

    pure public function unit(unit: SizeUnit) -> string {
        if unit == SizeUnit.byte {
            return @tr("o");
        }
        if unit == SizeUnit.kilobyte {
            return @tr("ko");
        }
        if unit == SizeUnit.megabyte {
            return @tr("Mo");
        }
        if unit == SizeUnit.gigabyte {
            return @tr("Go");
        }
        return @tr("To");
    }

    pure public function size(size: Size) -> string {
        if size.has-tenths {
            return @tr("{},{} {}", size.whole, size.tenths, unit(size.unit));
        }
        return @tr("{} {}", size.whole, unit(size.unit));
    }
}

// Why nothing can start, said over the cleaner's screens.
export component ProblemBanner inherits Banner {
    warning: true;
    text: Cleaner.problem == SetupProblem.variables
        ? @tr("Les dossiers de la session sont introuvables : rien ne peut démarrer. Le détail est dans le journal.")
        : Cleaner.problem == SetupProblem.rules
        ? @tr("Les règles de nettoyage sont illisibles : rien ne peut démarrer. Le détail est dans le journal.")
        : Cleaner.problem == SetupProblem.settings
        ? @tr("Les réglages sont illisibles : rien ne peut démarrer. Le détail est dans le journal.")
        : Cleaner.problem == SetupProblem.min-age
        ? @tr("L'âge minimal des réglages remonte avant l'horloge : rien ne serait assez ancien.")
        : Cleaner.problem == SetupProblem.start
        ? @tr("Le travail n'a pas pu démarrer : rien n'est supprimé. Le détail est dans le journal.")
        : Cleaner.problem == SetupProblem.rights-changed
        ? @tr("Les réglages ont changé depuis l'obtention des droits administrateur : rien n'est supprimé, obtenez-les à nouveau.")
        : Cleaner.problem == SetupProblem.history
        ? @tr("L'historique ne peut pas être tenu alors que vous demandez le journal des suppressions : rien n'est supprimé. Le détail est dans le journal.")
        : @tr("Une exclusion des réglages est refusée : rien ne peut démarrer. Le détail est dans le journal.");
}
