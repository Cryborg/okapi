// What the Home page shows, set by Rust (`crates/app/src/dashboard.rs`).
import { Size } from "cleaner-model.slint";

export enum WidgetKind { reclaimable, disks, memory, processor, system }

export enum WidgetSize { small, wide, tall, large, full }

// Where something sits in a grid of a number of columns, in columns and
// rows (Rust: `dashboard/layout.rs`).
export struct CellPlace {
    column: int,
    row: int,
    width: int,
    height: int,
}

// A widget of the dashboard: one row of the model for as long as the
// widget is there, its places in 1 to as many columns as the grid may have.
export struct WidgetCell {
    kind: WidgetKind,
    size: WidgetSize,
    // The sizes it is drawn in (Rust: `dashboard/catalog.rs`).
    accepted: [WidgetSize],
    places: [CellPlace],
}

// A widget the dashboard does not show, and the size it would come at.
export struct AddableWidget {
    kind: WidgetKind,
    size: WidgetSize,
}

// The note after a widget was removed, with "Annuler".
export struct Toast {
    shown: bool,
    kind: WidgetKind,
}

// What the focus is asked to go to, once: a widget of a row (its first stop
// in the mode), the mode's button, or the empty dashboard's "Ajouter".
export enum FocusPart { none, widget, customize, empty-add }

export struct FocusRequest {
    row: int,
    part: FocusPart,
    // Above 0 when asked; told back by `focus-taken`.
    generation: int,
}

export enum DayKind { today, yesterday, other }

// An instant in the local time zone (Rust: `dates.rs`), worded here.
export struct Moment {
    day: DayKind,
    day-of-month: int,
    // 1 to 12.
    month: int,
    hour: int,
    minute: int,
}

// What the Récupérable widget knows: the summary of an analysis of this
// session (current) or an earlier one (estimate), a cleaning since, or
// nothing read.
export enum ReclaimableState { none, current, estimate, cleaned, unavailable }

export struct Reclaimable {
    state: ReclaimableState,
    size: Size,
    entries: int,
    at: Moment,
    // The cleaning since: what it freed and when, when known.
    freed-known: bool,
    freed: Size,
    cleaned-at-known: bool,
    cleaned-at: Moment,
}

export enum ReadingState { reading, read, unavailable }

export struct SystemShown {
    state: ReadingState,
    // Each part empty when it could not be read.
    distribution: string,
    kernel: string,
    desktop: string,
    session: string,
    uptime-known: bool,
    uptime-days: int,
    // Within the day: 0 to 23.
    uptime-hours: int,
    uptime-minutes: int,
}

// How a volume is named: the words for the system's and the home's, its
// own name for the others.
export enum VolumeNaming { system, home, own }

export enum VolumePlace { local, removable, network }

// What is known of a volume's space: read, no answer in time, or an error.
export enum SpaceState { known, not-responding, failed }

export struct VolumeShown {
    naming: VolumeNaming,
    name: string,
    mount-point: string,
    filesystem: string,
    place: VolumePlace,
    space: SpaceState,
    free: Size,
    total: Size,
    used: Size,
    // Used, from 0 to 100.
    percent: int,
    nearly-full: bool,
}

export struct DisksShown {
    state: ReadingState,
    volumes: [VolumeShown],
    // The two fullest whose space is known, the fullest first.
    fullest: [VolumeShown],
    // The volumes beyond those, and how many of them did not answer.
    others: int,
    others-not-responding: int,
}

export struct ApplicationShown {
    name: string,
    size: Size,
}

export struct MemoryShown {
    state: ReadingState,
    used: Size,
    total: Size,
    available: Size,
    percent: int,
    has-swap: bool,
    swap-used: Size,
    swap-total: Size,
    swap-percent: int,
    // The applications holding the most: reading until a first list comes.
    applications-state: ReadingState,
    applications: [ApplicationShown],
}

export struct ProcessorShown {
    state: ReadingState,
    // The use read last, from 0 to 100.
    percent: int,
    load-known: bool,
    // The load average over a minute, as a whole and hundredths.
    load-whole: int,
    load-hundredths: int,
    // The curve of the last uses: its scale (50 or 100), and the commands
    // of its line and of the area under it, in a box `curve-span` wide and
    // as high as its scale.
    scale: int,
    line: string,
    area: string,
    // Fewer readings than the curve holds: it is filling.
    filling: bool,
    lowest: int,
    highest: int,
}

export global Dashboard {
    // The widgets, and the rows they fill in 1 to as many columns as the
    // grid may have.
    in property <[WidgetCell]> cells;
    in property <[int]> rows;
    // In the Personnaliser mode, the tile "Ajouter un widget" ends the
    // grid: its places, and the rows filled with it.
    in property <[CellPlace]> tile;
    in property <[int]> rows-with-tile;
    // The widgets that can be added, in the catalog's order.
    in property <[AddableWidget]> addable;
    in property <Toast> toast;
    // The layout kept could not be read: the default one is shown.
    in property <bool> layout-unreadable;
    in property <Reclaimable> reclaimable;
    in property <SystemShown> system;
    in property <DisksShown> disks;
    in property <MemoryShown> memory;
    in property <ProcessorShown> processor;
    // How many readings the processor's curve holds, minus one: the width
    // of its box.
    in property <int> curve-span;
    // No reading reaches the window any more.
    in property <bool> readings-lost;
    // The Personnaliser mode.
    in property <bool> editing;
    // The last change of the layout could not be kept.
    in property <bool> save-failed;
    in property <FocusRequest> focus-request;

    callback analyze();
    callback customize(bool);
    callback resize(int, WidgetSize);
    callback remove(int);
    callback add(WidgetKind);
    callback reset();
    // "Annuler" of the toast, or Ctrl+Z while it shows.
    callback undo();
    callback dismiss-toast();
    // The toast has the pointer or the focus: it waits.
    callback toast-held(bool);
    callback focus-taken(int);
}
