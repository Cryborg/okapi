// The Home page: a header, then the widgets of the layout in a grid whose
// columns follow the width (docs/design/tableau-de-bord/project/Dashboard.dc.html).
import { Theme, Screen } from "theme.slint";
import { Title, Detail, Icon, ScrolledList, ActionButton, ButtonKind, Banner, FocusRing, ModalFrame } from "widgets.slint";
import { AddableWidget, CellPlace, Dashboard, FocusPart, MoveCancel, ReadingState, ReclaimableState, WidgetKind, WidgetSize } from "dashboard-model.slint";
import { DashboardWords, DisksWidget, MemoryWidget, ProcessorWidget, ReclaimableWidget, SystemWidget } from "dashboard-widgets.slint";

// The tile that ends the grid in the Personnaliser mode.
component AddTile inherits Rectangle {
    callback clicked;
    border-radius: Theme.radius-large;
    border-width: Theme.add-tile-border;
    border-color: Theme.border-strong;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: label.text;
    accessible-action-default => {
        root.clicked();
    }
    keys := FocusScope {
        key-pressed(event) => {
            if !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: Theme.spacing-m;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: Theme.add-dot;
                height: Theme.add-dot;
                border-radius: self.width / 2;
                background: Theme.surface-2;
                border-width: Theme.border-width;
                border-color: Theme.border;
                Icon {
                    source: @image-url("../assets/icons/plus.svg");
                    colorize: Theme.text-2;
                }
            }
        }
        label := Text {
            text: @tr("Ajouter un widget");
            horizontal-alignment: center;
            color: touch.has-hover ? Theme.text : Theme.text-2;
            font-size: Theme.font-label;
            font-weight: Theme.weight-medium;
            accessible-role: none;
        }
    }
    FocusRing {
        shown: keys.has-focus;
        border-radius: root.border-radius;
    }
}

// A dialog of the page: its title over what it asks.
component Dialog inherits ModalFrame {
    in property <string> title;
    label: title;
    Text {
        text: root.title;
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        wrap: word-wrap;
    }
    @children
}

// The widgets the dashboard lacks, each to add.
component AddDialog inherits Dialog {
    title: @tr("Ajouter un widget");
    escaped => {
        self.close();
    }
    if Dashboard.addable.length == 0: Detail {
        text: @tr("Tous les widgets sont déjà sur votre tableau de bord.");
    }
    for widget in Dashboard.addable: HorizontalLayout {
        spacing: Theme.spacing-m;
        Rectangle {
            width: Theme.icon-box;
            height: Theme.icon-box;
            border-radius: Theme.radius-medium;
            background: Theme.surface-2;
            Icon {
                source: DashboardWords.icon(widget.kind);
                colorize: Theme.text-2;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing-xxs;
            Text {
                text: DashboardWords.title(widget.kind);
                color: Theme.text;
                font-size: Theme.font-label;
                font-weight: Theme.weight-semibold;
                accessible-role: none;
            }
            Detail {
                text: DashboardWords.description(widget.kind);
            }
            Text {
                text: @tr("Taille de départ : {}", DashboardWords.size-name(widget.size));
                color: Theme.text-3;
                font-size: Theme.font-caption;
            }
        }
        ActionButton {
            y: (parent.height - self.height) / 2;
            text: @tr("Ajouter");
            accessible-label: @tr("Ajouter {}", DashboardWords.title(widget.kind));
            clicked => {
                // Closed first: the focus then goes to the widget added.
                root.close();
                Dashboard.add(widget.kind);
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        close-button := ActionButton {
            text: @tr("Fermer");
            clicked => {
                root.close();
            }
        }
    }
    init => {
        close-button.focus();
    }
}

// Asks before the default layout replaces the one shown.
component ResetDialog inherits Dialog {
    title: @tr("Rétablir la disposition par défaut ?");
    escaped => {
        self.close();
    }
    Detail {
        text: @tr("Votre disposition actuelle sera remplacée par celle de départ : Récupérable, Disques, Mémoire, Processeur et Système, chacun à sa taille d'origine.");
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        back := ActionButton {
            text: @tr("Annuler");
            clicked => {
                root.close();
            }
        }
        ActionButton {
            text: @tr("Rétablir");
            kind: ButtonKind.primary;
            clicked => {
                root.close();
                Dashboard.reset();
            }
        }
    }
    init => {
        back.focus();
    }
}

// The note of a widget removed, with "Annuler"; it goes by itself unless
// held by the pointer or the focus.
component Toast inherits Rectangle {
    property <bool> held: touch.has-hover || undo.focused || dismiss.focused;
    changed held => {
        Dashboard.toast-held(self.held);
    }
    width: Theme.toast-width;
    border-radius: Theme.radius-large;
    background: Theme.surface;
    border-width: Theme.border-width;
    border-color: Theme.border-strong;
    drop-shadow-color: Theme.shadow-1;
    drop-shadow-blur: Theme.shadow-1-blur;
    drop-shadow-offset-y: Theme.shadow-1-offset;
    accessible-role: AccessibleRole.text;
    accessible-label: words.text;
    accessible-live-region: polite;
    height: line.preferred-height;
    touch := TouchArea { }
    line := HorizontalLayout {
        padding: Theme.spacing-m;
        padding-left: Theme.spacing-l;
        spacing: Theme.spacing-m;
        words := Text {
            horizontal-stretch: 1;
            text: @tr("{} retiré du tableau de bord", DashboardWords.title(Dashboard.toast.kind));
            color: Theme.text;
            font-size: Theme.font-label;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
        undo := ActionButton {
            kind: ButtonKind.ghost;
            text: @tr("Annuler");
            clicked => {
                Dashboard.undo();
            }
        }
        dismiss := ActionButton {
            kind: ButtonKind.ghost;
            icon: @image-url("../assets/icons/x.svg");
            text: "";
            accessible-label: @tr("Fermer la notification");
            clicked => {
                Dashboard.dismiss-toast();
            }
        }
    }
}

// Where the widget dragged would be put down.
component DropSlot inherits Rectangle {
    border-radius: Theme.radius-large;
    border-width: Theme.grab-border;
    border-color: Theme.accent;
    background: Theme.accent-soft;
    accessible-role: none;
    HorizontalLayout {
        alignment: center;
        spacing: Theme.spacing-s;
        Icon {
            source: @image-url("../assets/icons/arrow-down.svg");
            colorize: Theme.accent;
            width: Theme.icon-small;
            height: Theme.icon-small;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: @tr("Déposer ici");
            color: Theme.accent;
            font-size: Theme.font-small;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
}

export component DashboardPage inherits Rectangle {
    // "Voir les derniers résultats": the cleaner's page.
    callback open-cleaner();

    property <length> grid-width: view.visible-width - 2 * Screen.page-margin;
    property <int> columns: max(1, min(Dashboard.rows.length,
        floor((grid-width + Theme.dash-gap) / (Theme.dash-column-min + Theme.dash-gap))));
    property <int> rows: Dashboard.rows[columns - 1];
    property <length> column-width: (grid-width - (columns - 1) * Theme.dash-gap) / columns;
    // How wide, or high, a widget over so many columns, or rows, is.
    pure function span-width(columns: int) -> length {
        columns * column-width + (columns - 1) * Theme.dash-gap
    }
    pure function span-height(rows: int) -> length {
        rows * Theme.dash-row + (rows - 1) * Theme.dash-gap
    }
    property <bool> analyzed: Dashboard.reclaimable.state == ReclaimableState.current
        || Dashboard.reclaimable.state == ReclaimableState.estimate;
    // "Ubuntu 26.04 · dernière analyse aujourd'hui à 9 h 12".
    property <string> header-line: !analyzed ? Dashboard.system.distribution
        : Dashboard.system.distribution != "" ? @tr("{} · dernière analyse {}", Dashboard.system.distribution, DashboardWords.moment(Dashboard.reclaimable.at))
        : @tr("Dernière analyse {}", DashboardWords.moment(Dashboard.reclaimable.at));

    // Ctrl+Z puts back the widget just removed, from wherever the focus is
    // in the page. While a widget is dragged, it has the keys: Escape puts
    // the widget back.
    FocusScope {
        // The focus asked for it, once.
        property <int> asked: Dashboard.focus-request.part == FocusPart.page
            ? Dashboard.focus-request.generation : 0;
        function take-focus() {
            if self.asked > 0 {
                self.focus();
                Dashboard.focus-taken(self.asked);
            }
        }
        changed asked => {
            self.take-focus();
        }
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            // Ctrl+Maj+Z redoes, by custom: not this. Caps Lock gives "Z".
            if event.modifiers.control && !event.modifiers.shift && (event.text == "z" || event.text == "Z") && Dashboard.toast.shown {
                Dashboard.undo();
                return accept;
            }
            if event.text == Key.Escape && Dashboard.moving.shown && Dashboard.moving.by-pointer {
                Dashboard.cancel-move(MoveCancel.escape);
                return accept;
            }
            reject
        }

        // Reached with Tab, scrolled with the arrows, the pages, Home and End.
        view := ScrolledList {
            // A page, not a list: its widgets are its parts.
            accessible-role: none;
            content-height: page.preferred-height;

            page := VerticalLayout {
                width: view.visible-width;
                padding: Screen.page-margin;
                spacing: Theme.spacing-xl;

                HorizontalLayout {
                    spacing: Theme.spacing-l;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacing-xs;
                        Title {
                            text: @tr("Accueil");
                        }
                        if root.header-line != "": Detail {
                            text: root.header-line;
                        }
                    }
                    if Dashboard.editing: ActionButton {
                        y: 0;
                        kind: ButtonKind.ghost;
                        text: @tr("Rétablir la disposition par défaut");
                        icon: @image-url("../assets/icons/rotate-ccw.svg");
                        clicked => {
                            reset-dialog.show();
                        }
                    }
                    if Dashboard.editing: ActionButton {
                        y: 0;
                        text: @tr("Ajouter un widget");
                        icon: @image-url("../assets/icons/plus.svg");
                        clicked => {
                            add-dialog.show();
                        }
                    }
                    // One button, in or out of the mode: the focus stays on it.
                    customize := ActionButton {
                        // The focus asked for it, once.
                        property <int> asked: Dashboard.focus-request.part == FocusPart.customize
                            ? Dashboard.focus-request.generation : 0;
                        function take-focus() {
                            if self.asked > 0 {
                                self.focus();
                                Dashboard.focus-taken(self.asked);
                            }
                        }
                        init => {
                            self.take-focus();
                        }
                        changed asked => {
                            self.take-focus();
                        }
                        y: 0;
                        text: Dashboard.editing ? @tr("Terminé") : @tr("Personnaliser");
                        icon: Dashboard.editing ? @image-url("../assets/icons/check.svg") : @image-url("../assets/icons/layout-dashboard.svg");
                        kind: Dashboard.editing ? ButtonKind.primary : ButtonKind.secondary;
                        clicked => {
                            Dashboard.customize(!Dashboard.editing);
                        }
                    }
                }

                if Dashboard.editing && Dashboard.cells.length > 0: Banner {
                    text: @tr("Mode Personnaliser. Glissez un widget par sa poignée, ou placez le focus sur sa poignée et appuyez sur Entrée pour le saisir.");
                }

                if Dashboard.layout-unreadable: Banner {
                    warning: true;
                    text: @tr("Votre disposition n'a pas pu être lue, la disposition par défaut est affichée.");
                }

                if Dashboard.save-failed: Banner {
                    warning: true;
                    text: @tr("Votre disposition n'a pas pu être enregistrée.");
                }

                if Dashboard.cells.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: Theme.spacing-s;
                    padding-top: Theme.spacing-xxl;
                    Text {
                        text: @tr("Votre tableau de bord est vide");
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                    }
                    Detail {
                        text: @tr("Ajoutez les widgets que vous voulez suivre : espace récupérable, disques, mémoire, processeur ou système.");
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        padding-top: Theme.spacing-s;
                        ActionButton {
                            // The focus asked for it after the last widget went.
                            property <int> asked: Dashboard.focus-request.part == FocusPart.empty-add
                                ? Dashboard.focus-request.generation : 0;
                            function take-focus() {
                                if self.asked > 0 {
                                    self.focus();
                                    Dashboard.focus-taken(self.asked);
                                }
                            }
                            init => {
                                self.take-focus();
                            }
                            changed asked => {
                                self.take-focus();
                            }
                            text: @tr("Ajouter un widget");
                            kind: ButtonKind.primary;
                            clicked => {
                                add-dialog.show();
                            }
                        }
                    }
                }

                if Dashboard.cells.length > 0: grid := Rectangle {
                    property <int> filled: Dashboard.editing ? Dashboard.rows-with-tile[root.columns - 1] : root.rows;
                    // A widget dragged by its grip: the pointer and where
                    // it was pressed, in the window; where it took the
                    // card; whether it went far enough to be a drag.
                    property <bool> dragging: Dashboard.moving.shown && Dashboard.moving.by-pointer;
                    property <length> pointer-x;
                    property <length> pointer-y;
                    property <length> pressed-x;
                    property <length> pressed-y;
                    property <length> taken-x;
                    property <length> taken-y;
                    property <bool> travelled;
                    property <CellPlace> dragged-at: Dashboard.cells[Dashboard.moving.row].places[root.columns - 1];
                    // The dragged card's corner, in the grid.
                    property <length> card-x: self.pointer-x - self.absolute-position.x - self.taken-x;
                    property <length> card-y: self.pointer-y - self.absolute-position.y - self.taken-y;
                    // Near the list's edge, it scrolls while it can: up when
                    // above 0, down below.
                    property <length> scroll-step: !self.dragging || !self.travelled ? 0
                        : view.above && self.pointer-y < view.absolute-position.y + Theme.drag-scroll-edge ? Theme.drag-scroll-step
                        : view.below && self.pointer-y > view.absolute-position.y + view.visible-height - Theme.drag-scroll-edge ? -Theme.drag-scroll-step
                        : 0;

                    // Shows the dragged widget where its card's centre is.
                    function drag() {
                        Dashboard.drag-to(
                            (self.card-x + root.span-width(self.dragged-at.width) / 2) / (root.column-width + Theme.dash-gap),
                            (self.card-y + root.span-height(self.dragged-at.height) / 2) / (Theme.dash-row + Theme.dash-gap),
                            root.columns);
                    }

                    height: self.filled * Theme.dash-row + max(0, self.filled - 1) * Theme.dash-gap;

                    Timer {
                        interval: Theme.drag-scroll-every;
                        running: grid.scroll-step != 0;
                        triggered => {
                            view.scroll-by(grid.scroll-step);
                            grid.drag();
                        }
                    }

                    if Dashboard.editing: AddTile {
                        property <CellPlace> at: Dashboard.tile[root.columns - 1];
                        x: self.at.column * (root.column-width + Theme.dash-gap);
                        y: self.at.row * (Theme.dash-row + Theme.dash-gap);
                        width: root.column-width;
                        height: Theme.dash-row;
                        clicked => {
                            add-dialog.show();
                        }
                    }

                    for cell[index] in Dashboard.cells: placed := Rectangle {
                        property <CellPlace> at: cell.places[root.columns - 1];
                        property <bool> moving: Dashboard.moving.shown && Dashboard.moving.row == index;
                        property <bool> dragged: self.moving && Dashboard.moving.by-pointer;
                        x: self.at.column * (root.column-width + Theme.dash-gap);
                        y: self.at.row * (Theme.dash-row + Theme.dash-gap);
                        width: root.span-width(self.at.width);
                        height: root.span-height(self.at.height);
                        // Dragged, the card follows the pointer.
                        property <length> shift-x: self.dragged ? grid.card-x - self.x : 0;
                        property <length> shift-y: self.dragged ? grid.card-y - self.y : 0;
                        // What moves floats over the others.
                        z: self.moving ? 1 : 0;

                        function show() {
                            view.bring-into-view(grid.y + self.y, self.height);
                        }

                        // Moved by the keyboard, it shows where it goes; put
                        // back, where it was. Out of view, its grip would
                        // lose the focus.
                        changed at => {
                            if self.moving && !self.dragged {
                                self.show();
                            }
                        }
                        changed moving => {
                            if !self.moving {
                                self.show();
                            }
                        }
                        // Drawn anew (put down, added, put back) with the
                        // focus asked for it: in view, or Slint takes it
                        // away.
                        init => {
                            if Dashboard.focus-request.part == FocusPart.widget && Dashboard.focus-request.row == index {
                                self.show();
                            }
                        }

                        if placed.dragged: DropSlot { }

                        // The card, under the pointer while dragged.
                        Rectangle {
                            x: placed.shift-x;
                            y: placed.shift-y;

                            if cell.kind == WidgetKind.reclaimable: ReclaimableWidget {
                                slot: index;
                                size: cell.size;
                                accepted: cell.accepted;
                                // Alone in its row, it keeps a full width's
                                // words only where they fit beside the
                                // button.
                                full: cell.size == WidgetSize.full && root.columns > 1;
                                see-results => {
                                    root.open-cleaner();
                                }
                            }
                            if cell.kind == WidgetKind.system: SystemWidget {
                                slot: index;
                                size: cell.size;
                                accepted: cell.accepted;
                            }
                            if cell.kind == WidgetKind.disks: DisksWidget {
                                slot: index;
                                size: cell.size;
                                accepted: cell.accepted;
                            }
                            if cell.kind == WidgetKind.memory: MemoryWidget {
                                slot: index;
                                size: cell.size;
                                accepted: cell.accepted;
                            }
                            if cell.kind == WidgetKind.processor: ProcessorWidget {
                                slot: index;
                                size: cell.size;
                                accepted: cell.accepted;
                            }
                        }

                        // Over the card's grip (centred in its bar): it drags
                        // the widget.
                        if Dashboard.editing: TouchArea {
                            x: Theme.grip-inset + placed.shift-x;
                            y: (Theme.edit-bar - Theme.grip-height) / 2 + placed.shift-y;
                            width: Theme.grip-width;
                            height: Theme.grip-height;
                            mouse-cursor: placed.dragged ? MouseCursor.grabbing : MouseCursor.grab;
                            pointer-event(event) => {
                                // Slint gives no button with a press taken away.
                                if event.kind == PointerEventKind.cancel {
                                    if placed.dragged {
                                        Dashboard.cancel-move(MoveCancel.pointer);
                                    }
                                    return;
                                }
                                if event.button != PointerEventButton.left {
                                    return;
                                }
                                if event.kind == PointerEventKind.down {
                                    // A drag under way keeps its own; Rust
                                    // refuses the press, and says why.
                                    if !Dashboard.moving.shown {
                                        grid.pointer-x = self.absolute-position.x + self.mouse-x;
                                        grid.pointer-y = self.absolute-position.y + self.mouse-y;
                                        grid.pressed-x = grid.pointer-x;
                                        grid.pressed-y = grid.pointer-y;
                                        grid.taken-x = self.x + self.mouse-x;
                                        grid.taken-y = self.y + self.mouse-y;
                                        grid.travelled = false;
                                    }
                                    Dashboard.grab(index, true);
                                } else if event.kind == PointerEventKind.up && placed.dragged {
                                    // Let go out of the list: put back.
                                    if grid.pointer-x < view.absolute-position.x
                                        || grid.pointer-x > view.absolute-position.x + view.visible-width
                                        || grid.pointer-y < view.absolute-position.y
                                        || grid.pointer-y > view.absolute-position.y + view.visible-height {
                                        Dashboard.cancel-move(MoveCancel.outside);
                                    } else {
                                        Dashboard.put-down();
                                    }
                                }
                            }
                            moved => {
                                if placed.dragged {
                                    grid.pointer-x = self.absolute-position.x + self.mouse-x;
                                    grid.pointer-y = self.absolute-position.y + self.mouse-y;
                                    // A press that hardly moves is a click: it
                                    // never scrolls the list.
                                    grid.travelled = grid.travelled
                                        || abs(grid.pointer-x - grid.pressed-x) > Theme.drag-threshold
                                        || abs(grid.pointer-y - grid.pressed-y) > Theme.drag-threshold;
                                    grid.drag();
                                }
                            }
                        }
                    }
                }
            }
        }

        // Where the widget picked up is shown, said as it changes; out of
        // the page's layout, which it would push.
        if Dashboard.moving.shown: Rectangle {
            width: 0;
            height: 0;
            accessible-role: AccessibleRole.text;
            accessible-label: @tr("Place {} sur {}", Dashboard.moving.to + 1, Dashboard.cells.length);
            accessible-live-region: polite;
        }

        // In the page's scope: Ctrl+Z works from its buttons too.
        if Dashboard.toast.shown: Toast {
            x: (root.width - self.width) / 2;
            y: root.height - self.height - Theme.spacing-xl;
        }
    }

    add-dialog := AddDialog {
        x: (root.width - Theme.add-dialog-width) / 2;
        y: root.height / 8;
        width: Theme.add-dialog-width;
    }

    reset-dialog := ResetDialog {
        x: (root.width - Theme.modal-width) / 2;
        y: root.height / 4;
        width: Theme.modal-width;
    }

}
