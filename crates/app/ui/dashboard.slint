// The Home page: a header, then the widgets of the layout in a grid whose
// columns follow the width (docs/design/tableau-de-bord/project/Dashboard.dc.html).
import { Theme } from "theme.slint";
import { Title, Detail, Icon, ScrolledList } from "widgets.slint";
import { Dashboard, Placement, ReadingState, ReclaimableState, WidgetKind, WidgetSize } from "dashboard-model.slint";
import { DashboardWords, DisksWidget, MemoryWidget, ReclaimableWidget, SystemWidget, ReadingWidget } from "dashboard-widgets.slint";

export component DashboardPage inherits Rectangle {
    // The window's width, which the page's margin follows.
    in property <length> window-width;
    // "Voir les derniers résultats": the cleaner's page.
    callback open-cleaner();

    property <length> margin: window-width < Theme.dash-narrow-below ? Theme.spacing-xl : Theme.spacing-xxl;
    property <length> grid-width: view.visible-width - 2 * margin;
    property <int> columns: max(1, min(Dashboard.placements.length,
        floor((grid-width + Theme.dash-gap) / (Theme.dash-column-min + Theme.dash-gap))));
    property <Placement> placement: Dashboard.placements[columns - 1];
    property <length> column-width: (grid-width - (columns - 1) * Theme.dash-gap) / columns;
    property <bool> analyzed: Dashboard.reclaimable.state == ReclaimableState.current
        || Dashboard.reclaimable.state == ReclaimableState.estimate;
    // "Ubuntu 26.04 · dernière analyse aujourd'hui à 9 h 12".
    property <string> header-line: !analyzed ? Dashboard.system.distribution
        : Dashboard.system.distribution != "" ? @tr("{} · dernière analyse {}", Dashboard.system.distribution, DashboardWords.moment(Dashboard.reclaimable.at))
        : @tr("Dernière analyse {}", DashboardWords.moment(Dashboard.reclaimable.at));

    changed columns => {
        Dashboard.columns-shown(self.columns);
    }

    // Reached with Tab, scrolled with the arrows, the pages, Home and End.
    view := ScrolledList {
        // A page, not a list: its widgets are its parts.
        accessible-role: none;
        content-height: page.preferred-height;

        page := VerticalLayout {
            width: view.visible-width;
            padding: root.margin;
            spacing: Theme.spacing-xl;

            VerticalLayout {
                spacing: Theme.spacing-xs;
                Title {
                    text: @tr("Accueil");
                }
                if root.header-line != "": Detail {
                    text: root.header-line;
                }
            }

            if Dashboard.layout-unreadable: Rectangle {
                background: Theme.warning-soft;
                border-radius: Theme.radius-medium;
                accessible-role: text;
                accessible-label: unreadable.text;
                HorizontalLayout {
                    padding: Theme.spacing-m;
                    padding-left: Theme.spacing-l;
                    spacing: Theme.spacing-m;
                    Icon {
                        source: @image-url("../assets/icons/triangle-alert.svg");
                        colorize: Theme.warning;
                        width: Theme.icon-small;
                        height: Theme.icon-small;
                        y: (parent.height - self.height) / 2;
                    }
                    unreadable := Detail {
                        horizontal-stretch: 1;
                        text: @tr("Votre disposition n'a pas pu être lue, la disposition par défaut est affichée.");
                        color: Theme.text;
                        accessible-role: none;
                    }
                }
            }

            if root.placement.cells.length == 0: VerticalLayout {
                alignment: center;
                spacing: Theme.spacing-s;
                padding-top: Theme.spacing-xxl;
                Text {
                    text: @tr("Votre tableau de bord est vide");
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                }
                Detail {
                    text: @tr("Ajoutez les widgets que vous voulez suivre : espace récupérable, disques, mémoire, processeur ou système.");
                    horizontal-alignment: center;
                }
            }

            if root.placement.cells.length > 0: Rectangle {
                height: root.placement.rows * Theme.dash-row + max(0, root.placement.rows - 1) * Theme.dash-gap;

                for cell in root.placement.cells: Rectangle {
                    x: cell.column * (root.column-width + Theme.dash-gap);
                    y: cell.row * (Theme.dash-row + Theme.dash-gap);
                    width: cell.width * root.column-width + (cell.width - 1) * Theme.dash-gap;
                    height: cell.height * Theme.dash-row + (cell.height - 1) * Theme.dash-gap;

                    if cell.kind == WidgetKind.reclaimable: ReclaimableWidget {
                        // Alone in its row, it keeps a full width's words
                        // only where they fit beside the button.
                        full: cell.size == WidgetSize.full && root.columns > 1;
                        see-results => {
                            root.open-cleaner();
                        }
                    }
                    if cell.kind == WidgetKind.system: SystemWidget { }
                    if cell.kind == WidgetKind.disks: DisksWidget {
                        size: cell.size;
                    }
                    if cell.kind == WidgetKind.memory: MemoryWidget {
                        size: cell.size;
                    }
                    if cell.kind == WidgetKind.processor: ReadingWidget {
                        kind: cell.kind;
                    }
                }
            }
        }
    }
}
