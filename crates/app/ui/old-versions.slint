// The tab of the old versions the package managers keep: a snap's revisions
// kept to go back to, and the flatpak runtimes no application uses. Nothing
// is checked beforehand (invariant 5); what goes is named before the yes,
// and removed by snapd or flatpak's helper, never by Okapi.
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ActionButton, Banner, ButtonKind, Card, CheckMark, Detail, FocusRing, Icon, ModalFrame, ProgressBar } from "widgets.slint";
import { Words } from "cleaner-model.slint";
import { DashboardWords } from "dashboard-widgets.slint";
import { AppSource, OldOutcome, OldRoom, OldVersionLine, OldVersions } from "apps-model.slint";

export global OldWords {
    // What a line says under its name.
    pure public function detail(line: OldVersionLine) -> string {
        line.source == AppSource.snap
            ? (line.has-since ? @tr("Révision {} · version actuelle installée {}", line.revision, DashboardWords.moment(line.since))
                : @tr("Révision {}", line.revision))
            + (line.room == OldRoom.later ? @tr(" · rendue plus tard par snapd")
                : line.room == OldRoom.shared ? @tr(" · fichier partagé avec un autre snap : ne libère rien")
                : line.room == OldRoom.unknown ? @tr(" · place inconnue") : "")
            : @tr("Branche {}", line.version)
    }

    // What its size column says.
    pure public function size(line: OldVersionLine) -> string {
        line.room == OldRoom.unknown ? "" : line.room == OldRoom.about ? @tr("environ {}", Words.size(line.size)) : Words.size(line.size)
    }

    pure public function title(line: OldVersionLine) -> string {
        line.source == AppSource.snap ? @tr("{}, version {}", line.name, line.version) : line.name
    }
}

// One old version, ticked by a click, Space or Return.
component OldRow inherits Rectangle {
    in property <OldVersionLine> line;
    property <bool> toggles: !OldVersions.busy;
    height: Theme.app-row-height;
    accessible-role: list-item;
    accessible-checkable: true;
    accessible-checked: line.checked;
    accessible-label: @tr("{}, {}, {}", OldWords.title(line), OldWords.detail(line), OldWords.size(line));
    accessible-action-default => {
        if root.toggles {
            OldVersions.toggle(line.index);
        }
    }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if root.toggles && !event.repeat && (event.text == Key.Space || event.text == Key.Return) {
                OldVersions.toggle(line.index);
                return accept;
            }
            reject
        }
    }
    TouchArea {
        enabled: root.toggles;
        clicked => {
            OldVersions.toggle(line.index);
        }
    }
    FocusRing {
        shown: keys.has-focus;
        border-radius: Theme.radius-medium;
    }
    HorizontalLayout {
        padding-left: Theme.spacing-l;
        padding-right: Theme.spacing-l;
        spacing: Theme.spacing-m;
        CheckMark {
            checked: line.checked;
            y: (parent.height - self.height) / 2;
        }
        Icon {
            source: line.source == AppSource.snap ? @image-url("../assets/icons/history.svg") : @image-url("../assets/icons/package.svg");
            colorize: Theme.text-2;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: OldWords.title(line);
                accessible-role: none;
                color: Theme.text;
                overflow: elide;
            }
            Detail {
                text: OldWords.detail(line);
                accessible-role: none;
                overflow: elide;
            }
        }
        Text {
            text: OldWords.size(line);
            accessible-role: none;
            color: line.room == OldRoom.shared ? Theme.text-2 : Theme.text;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: Theme.border-width;
        background: Theme.border;
    }
}

// A card: its title, what it says, then its lines, a few high, scrolled.
component OldCard inherits Card {
    in property <string> title;
    in property <string> explained;
    in property <[OldVersionLine]> lines;
    in property <string> note;
    VerticalLayout {
        alignment: start;
        VerticalLayout {
            padding: Theme.spacing-l;
            spacing: Theme.spacing-xs;
            Text {
                text: root.title;
                color: Theme.text;
                font-weight: Theme.weight-semibold;
                wrap: word-wrap;
            }
            Detail {
                text: root.explained;
                wrap: word-wrap;
            }
            if root.note != "": Detail {
                text: root.note;
                color: Theme.warning;
                wrap: word-wrap;
            }
        }
        Rectangle {
            height: Theme.border-width;
            background: Theme.border;
        }
        // A few rows high, scrolled past: many versions never push the
        // window's minimum.
        ListView {
            height: min(root.lines.length, Theme.copies-shown) * Theme.app-row-height;
            accessible-role: list;
            accessible-label: root.title;
            for line in root.lines: OldRow {
                line: line;
            }
        }
    }
}

export component OldVersionsView inherits VerticalLayout {
    spacing: Theme.spacing-l;
    Detail {
        text: @tr("Les versions qu'un snap garde après une mise à jour, et les environnements flatpak que plus aucune appli n'utilise. Rien n'est retiré sans votre accord.");
        wrap: word-wrap;
    }
    if OldVersions.snaps-unread: Banner {
        warning: true;
        text: @tr("Les anciennes versions des snaps n'ont pas pu être lues : aucune n'est proposée. Le détail est dans le journal.");
    }
    if OldVersions.flatpaks-unread: Banner {
        warning: true;
        text: @tr("Les environnements flatpak n'ont pas pu être vérifiés en entier : aucun n'est proposé. Le détail est dans le journal.");
    }
    if OldVersions.analysis-failed: Banner {
        warning: true;
        text: @tr("La recherche des anciennes versions n'a pas abouti. Le détail est dans le journal.");
    }
    if OldVersions.outcome != OldOutcome.none: Banner {
        warning: OldVersions.outcome != OldOutcome.done || OldVersions.unrecorded;
        text: (OldVersions.outcome == OldOutcome.done
                ? (OldVersions.removed == 1 ? @tr("Une ancienne version retirée.") : @tr("{} anciennes versions retirées.", OldVersions.removed))
            : OldVersions.outcome == OldOutcome.partly ? @tr("Retirées : {}. Gardées : {}. Le détail est dans le journal.", OldVersions.removed, OldVersions.kept)
            : OldVersions.outcome == OldOutcome.refused ? @tr("Rien n'a été retiré : les droits n'ont pas été donnés.")
            : OldVersions.outcome == OldOutcome.interrupted ? @tr("Le retrait s'est interrompu : la liste relue montre ce qui reste. Le détail est dans le journal.")
            : @tr("Rien n'a été retiré. Le détail est dans le journal."))
            + (OldVersions.unrecorded ? @tr(" L'historique n'a pas pu tout garder.") : "");
        ActionButton {
            kind: ButtonKind.ghost;
            icon: @image-url("../assets/icons/x.svg");
            text: "";
            accessible-label: @tr("Fermer le message");
            clicked => {
                OldVersions.close-outcome();
            }
        }
    }
    if OldVersions.finding: ProgressBar {
        indeterminate: true;
        label: @tr("Recherche des anciennes versions… Rien n'est modifié.");
    }
    if OldVersions.retiring: ProgressBar {
        indeterminate: true;
        label: @tr("snapd et flatpak retirent ce qui est coché…");
    }
    if OldVersions.snaps.length > 0: OldCard {
        title: @tr("Anciennes versions des snaps");
        explained: @tr("À chaque mise à jour, snapd garde la version d'avant pour pouvoir y revenir. La retirer rend la place, mais il ne sera plus possible d'y revenir ; snapd en gardera une nouvelle à la prochaine mise à jour.");
        lines: OldVersions.snaps;
    }
    if OldVersions.flatpaks.length > 0: OldCard {
        title: @tr("Environnements flatpak inutilisés");
        explained: @tr("Ce dont des applis flatpak désinstallées avaient besoin, et que plus aucune appli installée n'utilise.");
        note: OldVersions.other-accounts ? @tr("D'autres comptes utilisent cet ordinateur : Okapi ne voit pas les applis installées pour eux seuls, et l'une d'elles pourrait avoir besoin de ces environnements.") : "";
        lines: OldVersions.flatpaks;
    }
    if OldVersions.for-account-only > 0: Detail {
        text: OldVersions.for-account-only == 1 ? @tr("Un environnement installé pour votre compte seulement n'est pas proposé : Okapi ne sait pas modifier cette installation.")
            : @tr("{} environnements installés pour votre compte seulement ne sont pas proposés : Okapi ne sait pas modifier cette installation.", OldVersions.for-account-only);
        wrap: word-wrap;
    }
    if OldVersions.snaps.length + OldVersions.flatpaks.length > 0: Card {
        background: Theme.surface-2;
        HorizontalLayout {
            padding: Theme.spacing-m;
            padding-left: Theme.spacing-l;
            spacing: Theme.spacing-m;
            Detail {
                horizontal-stretch: 1;
                accessible-role: text;
                text: OldVersions.checked-count == 0 ? @tr("Rien de coché. Cochez ce que vous voulez retirer.")
                    : OldVersions.checked-count == 1 ? @tr("Un élément coché : {}.", Words.size(OldVersions.checked-size))
                    : @tr("{} éléments cochés : {}.", OldVersions.checked-count, Words.size(OldVersions.checked-size));
                vertical-alignment: center;
            }
            ActionButton {
                text: @tr("Retirer la sélection");
                kind: ButtonKind.danger;
                enabled: OldVersions.checked-count > 0 && !OldVersions.busy;
                clicked => {
                    OldVersions.retire();
                }
            }
        }
    }
    if OldVersions.searched && !OldVersions.finding && !OldVersions.snaps-unread && !OldVersions.flatpaks-unread && OldVersions.snaps.length == 0 && OldVersions.flatpaks.length == 0: Card {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            padding: Theme.spacing-xxl;
            spacing: Theme.spacing-s;
            Text {
                text: @tr("Aucune ancienne version à retirer");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
            }
            Detail {
                text: @tr("Les snaps ne gardent aucune ancienne version, et aucun environnement flatpak n'est inutilisé.");
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
    }
}

// Asked once before the daemons remove what is checked: each named, with
// what it gives back and when. Closed by its buttons or Escape, never by a
// click outside.
export component OldVersionsConfirm inherits ModalFrame {
    label: question.text;
    escaped => {
        OldVersions.cancel();
    }
    question := Text {
        text: OldVersions.checked-count == 1 ? @tr("Retirer une ancienne version ?")
            : @tr("Retirer {} anciennes versions ?", OldVersions.checked-count);
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        wrap: word-wrap;
    }
    // Each named: a few high, scrolled past.
    ListView {
        height: min(OldVersions.going.length, Theme.copies-shown) * Theme.control-height;
        for line in OldVersions.going: HorizontalLayout {
            height: Theme.control-height;
            spacing: Theme.spacing-m;
            Detail {
                horizontal-stretch: 1;
                text: OldWords.title(line);
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Detail {
                text: OldWords.size(line);
                vertical-alignment: center;
            }
        }
    }
    if OldVersions.checked-snaps: Detail {
        text: @tr("Vous ne pourrez plus revenir à ces versions des snaps. Leurs données (celles de ces versions, pour tous les comptes) partent avec elles.");
        wrap: word-wrap;
    }
    if OldVersions.checked-snaps: Detail {
        text: (OldVersions.has-now ? @tr("Libéré tout de suite : {}. ", Words.size(OldVersions.checked-now)) : "")
            + (OldVersions.has-later ? @tr("Rendu plus tard par snapd, quand il vide son cache de téléchargements (sous un jour pour une version de plus de 30 jours, au plus 30 jours sinon) : {}. La ligne « Cache de Snap » du Nettoyeur le rend aussi.", Words.size(OldVersions.checked-later)) : "")
            + (OldVersions.has-shared ? @tr(" Un fichier partagé avec un autre snap ne libère rien.") : "")
            + (OldVersions.has-unknown ? @tr(" La place de certaines est inconnue.") : "");
        wrap: word-wrap;
    }
    if OldVersions.checked-runtimes: Detail {
        text: @tr("Environnements flatpak : environ {}, rendus une fois que flatpak a élagué son dépôt.", Words.size(OldVersions.checked-about));
        wrap: word-wrap;
    }
    if OldVersions.checked-runtimes && OldVersions.other-accounts: Detail {
        text: @tr("D'autres comptes utilisent cet ordinateur : Okapi ne voit pas les applis installées pour eux seuls, et l'une d'elles pourrait avoir besoin de ces environnements.");
        color: Theme.warning;
        wrap: word-wrap;
    }
    Detail {
        text: @tr("Votre mot de passe peut vous être demandé, parfois plusieurs fois.");
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        cancel := ActionButton {
            text: @tr("Annuler");
            kind: ButtonKind.ghost;
            clicked => {
                OldVersions.cancel();
            }
        }
        ActionButton {
            text: @tr("Retirer");
            kind: ButtonKind.danger;
            clicked => {
                OldVersions.confirm();
            }
        }
    }
    init => {
        cancel.focus();
    }
}
