// The tab of the old versions the package managers keep: a snap's revisions
// kept to go back to, and the flatpak runtimes no application uses. Nothing
// is checked beforehand (invariant 5); what goes is named before the yes,
// and removed by snapd or flatpak's helper, never by Okapi.
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ActionButton, Banner, ButtonKind, Card, CheckMark, Detail, FocusRing, Icon, ModalFrame, ProgressBar } from "widgets.slint";
import { Words } from "cleaner-model.slint";
import { DashboardWords } from "dashboard-widgets.slint";
import { AppSource, OldOutcome, OldRoom, OldVersionLine, OldVersions } from "apps-model.slint";

export global OldWords {
    // What a line says under its name: a snap's version in use, since when.
    pure public function detail(line: OldVersionLine) -> string {
        line.source == AppSource.snap
            ? (line.has-since ? @tr("Révision {} · version actuelle depuis le {}", line.revision, DashboardWords.date(line.since))
                : @tr("Révision {}", line.revision))
            : @tr("Branche {}", line.version)
    }

    // What its size column says: what it gives back, when known.
    pure public function size(line: OldVersionLine) -> string {
        line.room == OldRoom.unknown ? @tr("inconnue")
            : line.room == OldRoom.shared ? @tr("partagée")
            : line.room == OldRoom.about ? @tr("environ {}", Words.size(line.size))
            : Words.size(line.size)
    }

    pure public function title(line: OldVersionLine) -> string {
        line.source == AppSource.snap ? @tr("{}, version {}", line.name, line.version) : line.name
    }
}

// One old version, ticked by a click, Space or Return.
component OldRow inherits Rectangle {
    in property <OldVersionLine> line;
    property <bool> toggles: !OldVersions.busy;
    height: Theme.app-row-height;
    accessible-role: list-item;
    accessible-checkable: true;
    accessible-checked: line.checked;
    accessible-label: @tr("{}, {}, {}", OldWords.title(line), OldWords.detail(line), OldWords.size(line));
    accessible-action-default => {
        if root.toggles {
            OldVersions.toggle(line.index);
        }
    }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if root.toggles && !event.repeat && (event.text == Key.Space || event.text == Key.Return) {
                OldVersions.toggle(line.index);
                return accept;
            }
            reject
        }
    }
    TouchArea {
        enabled: root.toggles;
        clicked => {
            OldVersions.toggle(line.index);
        }
    }
    FocusRing {
        shown: keys.has-focus;
        border-radius: Theme.radius-medium;
    }
    HorizontalLayout {
        padding-left: Theme.spacing-l;
        padding-right: Theme.spacing-l;
        spacing: Theme.spacing-m;
        CheckMark {
            checked: line.checked;
            y: (parent.height - self.height) / 2;
        }
        Icon {
            source: line.source == AppSource.snap ? @image-url("../assets/icons/history.svg") : @image-url("../assets/icons/package.svg");
            colorize: Theme.text-2;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: OldWords.title(line);
                accessible-role: none;
                color: Theme.text;
                overflow: elide;
            }
            Detail {
                text: OldWords.detail(line);
                accessible-role: none;
                overflow: elide;
            }
        }
        Text {
            text: OldWords.size(line);
            accessible-role: none;
            color: line.room == OldRoom.shared ? Theme.text-2 : Theme.text;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: Theme.border-width;
        background: Theme.border;
    }
}

// A card: its title, what it says if anything, then its lines, a few high,
// scrolled.
component OldCard inherits Card {
    in property <string> title;
    in property <string> explained;
    in property <[OldVersionLine]> lines;
    // Its own height: never stretched past its lines.
    vertical-stretch: 0;
    VerticalLayout {
        alignment: start;
        VerticalLayout {
            padding: Theme.spacing-l;
            spacing: Theme.spacing-xs;
            Text {
                text: root.title;
                color: Theme.text;
                font-weight: Theme.weight-semibold;
                wrap: word-wrap;
            }
            if root.explained != "": Detail {
                text: root.explained;
                wrap: word-wrap;
            }
        }
        Rectangle {
            height: Theme.border-width;
            background: Theme.border;
        }
        // A few rows high, scrolled past: many versions never push the
        // window's minimum.
        ListView {
            height: min(root.lines.length, Theme.copies-shown) * Theme.app-row-height;
            accessible-role: list;
            accessible-label: root.title;
            for line in root.lines: OldRow {
                line: line;
            }
        }
    }
}

export component OldVersionsView inherits VerticalLayout {
    spacing: Theme.spacing-l;
    if OldVersions.snaps-unread: Banner {
        warning: true;
        text: @tr("Les anciennes versions des snaps n'ont pas pu être lues. Le détail est dans le journal.");
    }
    if OldVersions.flatpaks-unread: Banner {
        warning: true;
        text: @tr("Les environnements flatpak n'ont pas pu être vérifiés. Le détail est dans le journal.");
    }
    if OldVersions.analysis-failed: Banner {
        warning: true;
        text: @tr("La recherche des anciennes versions n'a pas abouti. Le détail est dans le journal.");
    }
    if OldVersions.outcome != OldOutcome.none: Banner {
        warning: OldVersions.outcome != OldOutcome.done || OldVersions.unrecorded || OldVersions.unpruned;
        text: (OldVersions.outcome == OldOutcome.done
                ? (OldVersions.removed == 1 ? @tr("Un élément retiré.") : @tr("{} éléments retirés.", OldVersions.removed))
            : OldVersions.outcome == OldOutcome.partly ? @tr("Retirés : {}. Gardés : {}. Le détail est dans le journal.", OldVersions.removed, OldVersions.kept)
            : OldVersions.outcome == OldOutcome.refused ? @tr("Rien n'a été retiré : les droits n'ont pas été donnés.")
            : OldVersions.outcome == OldOutcome.interrupted ? @tr("Le retrait s'est interrompu : la liste relue montre ce qui reste. Le détail est dans le journal.")
            : @tr("Rien n'a été retiré. Le détail est dans le journal."))
            + (OldVersions.unpruned ? @tr(" Flatpak n'a pas encore rendu la place des environnements.") : "")
            + (OldVersions.unrecorded ? @tr(" L'historique n'a pas pu tout garder.") : "");
        ActionButton {
            kind: ButtonKind.ghost;
            icon: @image-url("../assets/icons/x.svg");
            text: "";
            accessible-label: @tr("Fermer le message");
            clicked => {
                OldVersions.close-outcome();
            }
        }
    }
    if OldVersions.retiring: ProgressBar {
        indeterminate: true;
        label: @tr("Retrait en cours…");
    }
    if OldVersions.snaps.length > 0: OldCard {
        title: @tr("Anciennes versions des snaps");
        explained: @tr("snapd garde la version d'avant à chaque mise à jour, pour pouvoir y revenir.");
        lines: OldVersions.snaps;
    }
    if OldVersions.flatpaks.length > 0: OldCard {
        title: @tr("Environnements flatpak inutilisés");
        lines: OldVersions.flatpaks;
    }
    if OldVersions.for-account-only > 0: Detail {
        text: OldVersions.for-account-only == 1 ? @tr("Un environnement installé pour votre compte seulement n'est pas proposé.")
            : @tr("{} environnements installés pour votre compte seulement ne sont pas proposés.", OldVersions.for-account-only);
        wrap: word-wrap;
    }
    if OldVersions.snaps.length + OldVersions.flatpaks.length > 0: HorizontalLayout {
        alignment: end;
        ActionButton {
            text: @tr("Retirer la sélection");
            kind: ButtonKind.danger;
            enabled: OldVersions.checked-count > 0 && !OldVersions.busy;
            clicked => {
                OldVersions.retire();
            }
        }
    }
    if OldVersions.searched && !OldVersions.finding && !OldVersions.analysis-failed && !OldVersions.snaps-unread && !OldVersions.flatpaks-unread && OldVersions.snaps.length == 0 && OldVersions.flatpaks.length == 0: Card {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            padding: Theme.spacing-xxl;
            spacing: Theme.spacing-s;
            Text {
                text: @tr("Aucune ancienne version à retirer");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
    }
}

// Asked once before the daemons remove what is checked: each named, with
// what it gives back and when. Closed by its buttons or Escape, never by a
// click outside.
export component OldVersionsConfirm inherits ModalFrame {
    label: question.text;
    escaped => {
        OldVersions.cancel();
    }
    question := Text {
        text: OldVersions.checked-count == 1 ? @tr("Retirer un élément ?")
            : @tr("Retirer {} éléments ?", OldVersions.checked-count);
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
        wrap: word-wrap;
    }
    // Each named: a few high, scrolled past.
    ListView {
        height: min(OldVersions.going.length, Theme.copies-shown) * Theme.control-height;
        for line in OldVersions.going: HorizontalLayout {
            height: Theme.control-height;
            spacing: Theme.spacing-m;
            Detail {
                horizontal-stretch: 1;
                text: OldWords.title(line);
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Detail {
                text: OldWords.size(line);
                vertical-alignment: center;
            }
        }
    }
    if OldVersions.checked-snaps: Detail {
        text: @tr("Vous ne pourrez plus revenir à ces versions. Les données de ces versions partent aussi, pour tous les comptes.");
        wrap: word-wrap;
    }
    if OldVersions.has-now: Detail {
        text: @tr("Libéré tout de suite : {}.", Words.size(OldVersions.checked-now));
        wrap: word-wrap;
    }
    if OldVersions.has-later: Detail {
        text: @tr("Rendu par snapd dans les 30 jours, ou par la ligne « Cache de Snap » du Nettoyeur : {}.", Words.size(OldVersions.checked-later));
        wrap: word-wrap;
    }
    if OldVersions.has-about: Detail {
        text: @tr("Environnements flatpak : environ {}.", Words.size(OldVersions.checked-about));
        wrap: word-wrap;
    }
    if OldVersions.checked-runtimes && OldVersions.other-accounts: Detail {
        text: @tr("D'autres comptes de cet ordinateur peuvent en avoir besoin.");
        color: Theme.warning;
        wrap: word-wrap;
    }
    Detail {
        text: @tr("Votre mot de passe peut vous être demandé, parfois plusieurs fois.");
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        cancel := ActionButton {
            text: @tr("Annuler");
            kind: ButtonKind.ghost;
            clicked => {
                OldVersions.cancel();
            }
        }
        ActionButton {
            text: @tr("Retirer");
            kind: ButtonKind.danger;
            clicked => {
                OldVersions.confirm();
            }
        }
    }
    init => {
        cancel.focus();
    }
}
