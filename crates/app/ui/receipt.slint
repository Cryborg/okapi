// The cleaning under way, and its receipt.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    ActionButton, ButtonKind, Card, Detail, Footer, FocusRing, Icon, Line, ProgressBar, Title,
} from "widgets.slint";
import {
    CleanEnding, CleanStep, CleanStepKind, Cleaner, HistoryState, ReceiptKind, ReceiptLineShown,
    RightsProblem, RightsStep, RowState, Words,
} from "cleaner-model.slint";

// A step of a cleaning: waiting, under way, done, or not done; the bar of a
// pass stays shown at every state, and the receipt lists the steps again.
component CleanStepRow inherits Rectangle {
    in property <CleanStep> step;
    in property <bool> last;
    property <string> name: step.kind == CleanStepKind.admin ? @tr("Nettoyage des éléments administrateur")
        : step.kind == CleanStepKind.check ? @tr("Vérification de chaque élément")
        : step.kind == CleanStepKind.remove ? @tr("Suppression des éléments vérifiés")
        : @tr("Enregistrement dans l'historique");
    property <color> state-color: step.state == RowState.done ? Theme.success
        : step.state == RowState.not-done ? Theme.warning
        : step.state == RowState.running ? Theme.accent : Theme.text-3;
    property <string> state-text: step.state == RowState.done ? @tr("Fait")
        : step.state == RowState.not-done ? @tr("Non fait")
        : step.state == RowState.running ? @tr("En cours") : @tr("En attente");
    property <bool> counted: step.total > 0;

    background: step.state == RowState.running ? Theme.surface-2 : transparent;
    accessible-role: list-item;
    accessible-label: name;
    accessible-description: counted
        ? @tr("{}, éléments : {} sur {}", state-text, step.done, step.total)
        : state-text;

    if !last: Rectangle {
        y: parent.height - self.height;
        height: Theme.border-width;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Theme.spacing-l;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        spacing: Theme.spacing-s;
        HorizontalLayout {
            spacing: Theme.spacing-m;
            Icon {
                source: step.state == RowState.done ? @image-url("../assets/icons/circle-check.svg")
                    : step.state == RowState.not-done ? @image-url("../assets/icons/triangle-alert.svg")
                    : step.state == RowState.running ? @image-url("../assets/icons/loader.svg")
                    : @image-url("../assets/icons/clock.svg");
                colorize: state-color;
                width: Theme.icon-small;
                height: Theme.icon-small;
                y: (parent.height - self.height) / 2;
            }
            Text {
                horizontal-stretch: 1;
                text: name;
                accessible-role: none;
                color: step.state == RowState.waiting ? Theme.text-2 : Theme.text;
                font-size: Theme.font-heading;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: state-text;
                accessible-role: none;
                color: state-color;
                font-size: Theme.font-small;
                font-weight: Theme.weight-medium;
                vertical-alignment: center;
            }
        }
        if step.kind != CleanStepKind.history: HorizontalLayout {
            spacing: Theme.spacing-m;
            ProgressBar {
                horizontal-stretch: 1;
                y: (parent.height - self.height) / 2;
                progress: counted ? step.done / step.total : step.state == RowState.done ? 1 : 0;
                indeterminate: step.state == RowState.running && !counted;
                label: name;
            }
            // On one line, however many entries.
            Detail {
                min-width: Theme.step-count-width;
                horizontal-stretch: 0;
                wrap: no-wrap;
                text: counted ? @tr("{} sur {}", step.done, step.total) : "";
                accessible-role: none;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

// The steps of a cleaning, one under the other.
component CleanSteps inherits Card {
    accessible-role: list;
    accessible-label: @tr("Étapes du nettoyage");
    VerticalLayout {
        for step[index] in Cleaner.clean-steps: CleanStepRow {
            step: step;
            last: index == Cleaner.clean-steps.length - 1;
        }
    }
}

// The cleaning under way: each step, how far, what is freed so far.
export component CleaningPage inherits VerticalLayout {
    init => {
        cancel.focus();
    }

    VerticalLayout {
        vertical-stretch: 1;
        padding: Theme.spacing-xxl;
        spacing: Theme.spacing-xl;
        VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.spacing-xs;
            Title {
                text: Cleaner.clean-cancel-asked ? @tr("Annulation du nettoyage") : @tr("Nettoyage en cours");
            }
            Detail {
                text: Cleaner.clean-rights == RightsStep.authenticating
                    ? @tr("Saisissez le mot de passe dans la fenêtre du système. Annuler n'agit qu'une fois cette fenêtre fermée.")
                    : Cleaner.clean-cancel-asked
                    ? @tr("L'élément en cours se termine ; ce qui n'est pas encore retiré reste.")
                    : @tr("Chaque élément est vérifié, puis revérifié juste avant d'être retiré.");
                accessible-live-region: polite;
            }
        }
        CleanSteps { }
        Rectangle {
            vertical-stretch: 1;
        }
    }
    Footer {
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing-s;
            alignment: start;
            Detail {
                text: @tr("Libéré jusqu'ici");
                vertical-alignment: center;
            }
            Text {
                text: Words.size(Cleaner.freed);
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }
        }
        cancel := ActionButton {
            text: @tr("Annuler le nettoyage");
            enabled: !Cleaner.clean-cancel-asked;
            y: (parent.height - self.height) / 2;
            clicked => {
                Cleaner.cancel-cleaning();
            }
        }
    }
}

// A figure of the receipt.
component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    horizontal-stretch: 1;
    padding: Theme.spacing-m;
    padding-left: Theme.spacing-l;
    spacing: Theme.spacing-xs;
    accessible-role: text;
    accessible-label: @tr("{} : {}", label, value);
    Detail {
        text: root.label;
        accessible-role: none;
    }
    Text {
        text: root.value;
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
    }
}

// A line of the receipt: a result, or why entries were kept; unfolded, its
// entries.
component ReceiptLine inherits VerticalLayout {
    in property <ReceiptLineShown> line;
    property <bool> open;
    property <string> name: line.kind == ReceiptKind.removed ? @tr("Retirées")
        : line.kind == ReceiptKind.partial ? @tr("Retirées en partie")
        : line.kind == ReceiptKind.gone ? @tr("Déjà parties")
        : line.kind == ReceiptKind.recent ? @tr("Gardées : modifiées trop récemment")
        : line.kind == ReceiptKind.changed ? @tr("Gardées : leur contenu a changé")
        : line.kind == ReceiptKind.replaced ? @tr("Gardées : remplacées depuis l'analyse")
        : line.kind == ReceiptKind.excluded ? @tr("Gardées : exclues par vos réglages")
        : line.kind == ReceiptKind.protected ? @tr("Gardées : protégées")
        : line.kind == ReceiptKind.refused ? @tr("Gardées : refus du système")
        : line.kind == ReceiptKind.cancelled ? @tr("Gardées : nettoyage annulé avant leur tour")
        : line.kind == ReceiptKind.browser-open ? @tr("Gardées : leur navigateur est ouvert")
        : @tr("Gardées : inconnues de cette analyse");

    // Its result, how many and how much: a button that unfolds its entries.
    Rectangle {
        min-height: Theme.results-row-height;
        background: touch.has-hover ? Theme.surface-hover : transparent;
        accessible-role: button;
        accessible-label: root.open ? @tr("Replier {}", root.name) : @tr("Déplier {}", root.name);
        accessible-description: @tr("Éléments : {}. Taille : {}.", line.count, Words.size(line.size));
        accessible-expandable: true;
        accessible-expanded: root.open;
        accessible-action-default => {
            root.open = !root.open;
        }
        forward-focus: keys;
        keys := FocusScope {
            key-pressed(event) => {
                if !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                    root.open = !root.open;
                    return accept;
                }
                reject
            }
        }
        touch := TouchArea {
            clicked => {
                root.open = !root.open;
            }
        }
        FocusRing {
            shown: keys.has-focus;
            border-radius: Theme.radius-medium;
        }
        Rectangle {
            y: parent.height - self.height;
            height: Theme.border-width;
            background: Theme.border;
        }
        HorizontalLayout {
            padding-left: Theme.spacing-m;
            padding-right: Theme.spacing-l;
            spacing: Theme.spacing-m;
            Icon {
                source: root.open ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg");
                colorize: Theme.text-2;
                width: Theme.icon-small;
                height: Theme.icon-small;
                y: (parent.height - self.height) / 2;
            }
            Line {
                horizontal-stretch: 1;
                text: root.name;
                accessible-role: none;
                vertical-alignment: center;
            }
            Detail {
                width: Theme.results-entries-width;
                text: line.count;
                accessible-role: none;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Line {
                width: Theme.results-size-width;
                text: Words.size(line.size);
                accessible-role: none;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
    if root.open: VerticalLayout {
        padding-left: Theme.results-indent;
        padding-top: Theme.spacing-s;
        padding-bottom: Theme.spacing-s;
        spacing: Theme.spacing-xxs;
        for entry in line.paths: VerticalLayout {
            Detail {
                text: entry.path;
                color: Theme.text;
                overflow: elide;
            }
            if entry.blocked != "": Detail {
                text: @tr("Gardé à cause de : {}", entry.blocked);
                overflow: elide;
            }
        }
        if line.more > 0: Detail {
            text: @tr("Autres : {}. Le journal les liste toutes.", line.more);
        }
    }
}

// What a cleaning did.
export component ReceiptPage inherits VerticalLayout {
    init => {
        done.focus();
    }

    VerticalLayout {
        vertical-stretch: 1;
        padding: Theme.spacing-xxl;
        padding-bottom: Theme.spacing-l;
        spacing: Theme.spacing-l;
        VerticalLayout {
            spacing: Theme.spacing-xs;
            Title {
                text: Cleaner.ending == CleanEnding.done ? @tr("Nettoyage terminé")
                    : Cleaner.ending == CleanEnding.cancelled ? @tr("Nettoyage annulé")
                    : Cleaner.ending == CleanEnding.stopped ? @tr("Nettoyage arrêté")
                    : @tr("Nettoyage interrompu");
                accessible-live-region: polite;
            }
            Detail {
                text: Cleaner.ending == CleanEnding.interrupted
                    ? @tr("Le nettoyage s'est interrompu sans reçu. Ce qui a été supprimé est dans le journal technique.")
                    : Cleaner.ending == CleanEnding.stopped
                    ? @tr("Rien n'a été touché.")
                    : Cleaner.ending == CleanEnding.cancelled
                    ? @tr("Ce qui n'était pas encore retiré est resté.")
                    : Cleaner.removed + Cleaner.partial == 0
                    ? @tr("Rien n'a été retiré : le détail par résultat est ci-dessous.")
                    : @tr("Chaque élément a été vérifié juste avant d'être retiré.");
            }
            Detail {
                text: Cleaner.history == HistoryState.recorded ? @tr("Le reçu est enregistré dans l'historique.")
                    : Cleaner.history == HistoryState.failed ? @tr("Le reçu n'a pas pu être enregistré dans l'historique. Le détail est dans le journal.")
                    : Cleaner.history == HistoryState.unavailable ? @tr("L'historique est indisponible : ce reçu n'y est pas ajouté. Le détail est dans le journal.")
                    : @tr("L'historique n'a pas été écrit.");
                color: Cleaner.history == HistoryState.recorded ? Theme.text-2 : Theme.warning;
            }
            if Cleaner.receipt-rights != RightsProblem.none: Line {
                text: @tr("La partie administrateur ne s'est pas terminée. {}", Words.rights(Cleaner.receipt-rights));
                color: Theme.warning;
                accessible-live-region: polite;
            }
            if Cleaner.deletion-log-lost: Line {
                text: @tr("Le journal des suppressions que vous demandez n'a pas été écrit : ce qui a été supprimé n'est listé que dans le journal technique.");
                color: Theme.danger;
                accessible-live-region: assertive;
            }
        }
        if Cleaner.stops.length > 0: VerticalLayout {
            spacing: Theme.spacing-xs;
            for stop in Cleaner.stops: Line {
                text: Words.stop(stop);
            }
        }
        if Cleaner.ending != CleanEnding.interrupted: Card {
            HorizontalLayout {
                Stat {
                    label: @tr("Espace libéré");
                    value: Words.size(Cleaner.freed);
                }
                Stat {
                    label: @tr("Retirées");
                    value: Cleaner.removed;
                }
                Stat {
                    label: @tr("Retirées en partie");
                    value: Cleaner.partial;
                }
                Stat {
                    label: @tr("Déjà parties");
                    value: Cleaner.gone;
                }
                Stat {
                    label: @tr("Gardées");
                    value: Cleaner.kept;
                }
            }
        }
        CleanSteps { }
        if Cleaner.receipt-lines.length > 0: Card {
            vertical-stretch: 1;
            accessible-role: list;
            accessible-label: @tr("Détail par résultat");
            // The lines at their own height, scrolled.
            receipt-view := ScrollView {
                content-width: self.visible-width;
                content-height: receipt-lines.preferred-height;
                receipt-lines := VerticalLayout {
                    width: receipt-view.visible-width;
                    padding: Theme.spacing-s;
                    alignment: start;
                    for line in Cleaner.receipt-lines: ReceiptLine {
                        line: line;
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: Cleaner.receipt-lines.length > 0 ? 0 : 1;
        }
    }
    Footer {
        Rectangle {
            horizontal-stretch: 1;
        }
        done := ActionButton {
            text: @tr("Terminer");
            kind: ButtonKind.primary;
            large: true;
            y: (parent.height - self.height) / 2;
            clicked => {
                Cleaner.finish();
            }
        }
    }
}
