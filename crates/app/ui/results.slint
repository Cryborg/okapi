// What an analysis found: the groups by category, which are checked, the
// notes of the analysis, and what a cleaning would take.
import { ScrollView } from "std-widgets.slint";
import { Theme, Screen } from "theme.slint";
import {
    ActionButton, Banner, ButtonKind, Badge, Card, CheckMark, Detail, Footer, FocusRing, Icon,
    IconButton, IconNote, Line, ModalFrame, Title,
} from "widgets.slint";
import {
    AdminRow, BrowserStep, CheckState, Cleaner, IssueKind, IssueShown, ProblemBanner, ResultBadge,
    ResultRow, RightsProblem, RightsStep, RowKind, SetupProblem, Words,
} from "cleaner-model.slint";

// What waits for the administrator's rights, and the button that asks for
// them; while they are asked, where it stands; then why they gave nothing.
component RightsBanner inherits Rectangle {
    background: Theme.admin-soft;
    border-radius: Theme.radius-medium;
    accessible-role: text;
    accessible-label: said.text;
    accessible-live-region: polite;
    HorizontalLayout {
        padding: Theme.spacing-m;
        padding-left: Theme.spacing-l;
        spacing: Theme.spacing-m;
        Icon {
            source: @image-url("../assets/icons/shield.svg");
            colorize: Theme.admin;
            y: (parent.height - self.height) / 2;
        }
        said := Line {
            horizontal-stretch: 1;
            accessible-role: none;
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
            text: Cleaner.rights-step == RightsStep.authenticating
                ? @tr("Saisissez le mot de passe dans la fenêtre du système. Annuler n'agit qu'une fois cette fenêtre fermée.")
                : Cleaner.rights-step == RightsStep.scanning
                ? @tr("Analyse avec les droits administrateur…")
                : Cleaner.rights-step == RightsStep.cancelling
                ? @tr("Annulation de la demande des droits : elle prend effet une fois la fenêtre du système fermée.")
                : Cleaner.rights-problem != RightsProblem.none
                ? @tr("{} Groupes qui les demandent toujours : {}.", Words.rights(Cleaner.rights-problem), Cleaner.rights-waiting)
                : @tr("Certaines opérations demandent les droits administrateur. Groupes ci-dessous : {}.", Cleaner.rights-waiting);
        }
        if Cleaner.rights-step == RightsStep.idle: ActionButton {
            text: @tr("Obtenir les droits");
            kind: ButtonKind.secondary;
            y: (parent.height - self.height) / 2;
            clicked => {
                Cleaner.obtain-rights();
            }
        }
        if Cleaner.rights-step == RightsStep.authenticating || Cleaner.rights-step == RightsStep.scanning: ActionButton {
            text: @tr("Annuler");
            kind: ButtonKind.ghost;
            y: (parent.height - self.height) / 2;
            clicked => {
                Cleaner.cancel-rights();
            }
        }
    }
}

// The button that folds or unfolds a category.
component Fold inherits IconButton {
    in property <bool> folded;
    in property <string> category;

    icon: folded ? @image-url("../assets/icons/chevron-right.svg") : @image-url("../assets/icons/chevron-down.svg");
    label: folded ? @tr("Déplier {}", category) : @tr("Replier {}", category);
    accessible-expandable: true;
    accessible-expanded: !folded;
}

// One line of the results: a category or a browser (its fold and its
// checkbox) or a group (a checkbox), each indented below the one above. A
// layout of its own height: a hidden line takes no room and no focus.
component ResultLine inherits VerticalLayout {
    in property <ResultRow> line;
    in property <int> index;
    // Where the focused line sits, for the list to bring it into view.
    callback focused(length, length);

    // A group left to the user has no badge: its note, a warning, says why.
    property <string> badge-text: line.badge == ResultBadge.preselected ? @tr("Présélectionné")
        : @tr("Administrateur");
    property <bool> is-group: line.kind == RowKind.group;
    property <string> name: line.kind == RowKind.category ? Words.category(line.category) : line.label;
    // Why a group is left to the user, or out of reach.
    property <string> note: line.badge == ResultBadge.to-choose
        ? @tr("Le prochain démarrage sera plus lent, le temps de recréer ce cache.")
        : line.admin == AdminRow.nothing
        ? @tr("Rien à nettoyer avec les droits administrateur.")
        : line.admin == AdminRow.unlocked
        ? @tr("Droits obtenus : à cocher vous-même.")
        : line.admin == AdminRow.unreachable
        ? @tr("Hors de portée de l'assistant administrateur.")
        : @tr("Demande les droits administrateur : « Obtenir les droits » ci-dessus.");

    if !line.hidden: Rectangle {
        min-height: Theme.results-row-height;
        Rectangle {
            y: parent.height - self.height;
            height: Theme.border-width;
            background: Theme.border;
        }
        HorizontalLayout {
            padding-left: Theme.spacing-s;
            padding-right: Theme.spacing-l;
            // Room for a badge and a note, clear of the lines between rows.
            padding-top: Theme.spacing-m;
            padding-bottom: Theme.spacing-m;
            spacing: Theme.spacing-m;
            // A browser's fold sits further in than its category's, a group's
            // checkbox further in than the fold above it.
            if line.kind == RowKind.browser: Rectangle {
                width: Theme.results-indent;
            }
            if !root.is-group: Fold {
                folded: line.folded;
                category: root.name;
                clicked => {
                    Cleaner.fold(root.index);
                }
            }
            if root.is-group: Rectangle {
                width: Theme.icon-box + (line.nested ? 2 : 1) * Theme.results-indent;
            }
            check := Rectangle {
                horizontal-stretch: 1;
                accessible-role: checkbox;
                accessible-checkable: true;
                accessible-checked: line.state == CheckState.checked;
                accessible-enabled: line.enabled;
                accessible-label: root.name;
                accessible-description: line.state == CheckState.partial ? @tr("sélection partielle")
                    : !root.is-group ? (line.enabled ? "" : @tr("À choisir groupe par groupe"))
                    : line.badge == ResultBadge.preselected ? root.badge-text
                    : line.badge == ResultBadge.to-choose ? root.note
                    : @tr("{} : {}", root.badge-text, root.note);
                accessible-action-default => {
                    if line.enabled {
                        Cleaner.toggle-result(root.index);
                    }
                }
                forward-focus: keys;

                keys := FocusScope {
                    focus-on-tab-navigation: line.enabled;
                    key-pressed(event) => {
                        if line.enabled && !event.repeat && event.text == Key.Space {
                            Cleaner.toggle-result(root.index);
                            return accept;
                        }
                        reject
                    }
                    changed has-focus => {
                        if self.has-focus {
                            root.focused(root.y, root.height);
                        }
                    }
                }

                TouchArea {
                    enabled: line.enabled;
                    clicked => {
                        Cleaner.toggle-result(root.index);
                    }
                }

                FocusRing {
                    shown: keys.has-focus;
                    border-radius: Theme.radius-medium;
                }

                HorizontalLayout {
                    padding-left: Theme.spacing-xs;
                    spacing: Theme.spacing-m;
                    CheckMark {
                        checked: line.state == CheckState.checked;
                        partial: line.state == CheckState.partial;
                        enabled: line.enabled;
                        y: (parent.height - self.height) / 2;
                    }
                    if line.kind == RowKind.category: Icon {
                        source: Words.icon(line.category);
                        colorize: Theme.text-2;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Theme.spacing-xxs;
                        HorizontalLayout {
                            spacing: Theme.spacing-s;
                            alignment: start;
                            Text {
                                text: root.name;
                                accessible-role: none;
                                color: Theme.text;
                                font-size: Theme.font-label;
                                font-weight: root.is-group ? Theme.weight-medium : Theme.weight-semibold;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.is-group && line.badge != ResultBadge.to-choose: Badge {
                                text: root.badge-text;
                                icon: line.badge == ResultBadge.preselected ? @image-url("../assets/icons/check.svg")
                                    : @image-url("../assets/icons/shield.svg");
                                tone: line.badge == ResultBadge.preselected ? Theme.accent : Theme.admin;
                                tone-soft: line.badge == ResultBadge.preselected ? Theme.accent-soft : Theme.admin-soft;
                                accessible-role: none;
                            }
                        }
                        if root.is-group && line.badge == ResultBadge.to-choose: IconNote {
                            text: root.note;
                            icon: @image-url("../assets/icons/triangle-alert.svg");
                            tone: Theme.warning;
                        }
                        if root.is-group && line.badge == ResultBadge.admin: Detail {
                            text: root.note;
                            accessible-role: none;
                        }
                    }
                }
            }
            Detail {
                width: Theme.results-entries-width;
                accessible-role: none;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: line.entries;
            }
            Line {
                width: Theme.results-size-width;
                accessible-role: none;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: Words.size(line.size);
            }
        }
    }
}

// A note of the analysis, worded by its kind.
component NoteLine inherits HorizontalLayout {
    in property <IssueShown> note;
    spacing: Theme.spacing-s;
    Icon {
        source: @image-url("../assets/icons/info.svg");
        colorize: Theme.text-2;
        width: Theme.icon-small;
        height: Theme.icon-small;
    }
    Detail {
        horizontal-stretch: 1;
        text: note.kind == IssueKind.unreadable-root ? @tr("Dossier illisible, non compté : {}", note.path)
            : note.kind == IssueKind.unsafe-root ? @tr("Dossier qui n'est pas ce que la règle attend, laissé de côté : {}", note.path)
            : note.kind == IssueKind.protected-root ? @tr("Dossier qui contient un dossier protégé, laissé de côté : {}", note.path)
            : note.kind == IssueKind.excluded ? @tr("Dossier exclu par vos réglages : {}", note.path)
            : note.kind == IssueKind.depth-limit ? @tr("Profondeur maximale atteinte, la suite n'est pas comptée : {}", note.path)
            : note.kind == IssueKind.entries-limit ? @tr("Trop d'éléments parcourus, la suite n'est pas comptée : {}", note.path)
            : note.kind == IssueKind.age-beyond-clock ? @tr("Une règle demande un âge qui remonte avant l'horloge : elle ne propose rien.")
            : note.kind == IssueKind.unsupported ? @tr("Une règle n'est pas encore prise en charge : elle ne propose rien.")
            : @tr("Un chemin d'une règle ne peut pas être résolu : elle ne propose rien.");
    }
}

// The confirmation of a cleaning: irreversible, so a checkbox says it is
// understood before "Supprimer" acts. Closed by its buttons or Escape, never
// by a click outside.
component Confirmation inherits ModalFrame {
    label: title.text;
    init => {
        back.focus();
    }
    escaped => {
        Cleaner.cancel-confirmation();
    }

    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: Theme.icon-box;
            height: Theme.icon-box;
            border-radius: Theme.radius-medium;
            background: Theme.danger-soft;
            Icon {
                source: @image-url("../assets/icons/triangle-alert.svg");
                colorize: Theme.danger;
            }
        }
    }
    title := Text {
        text: @tr("Supprimer définitivement ?");
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
    }
    Detail {
        text: @tr("Taille : {}. Éléments : {}. Rien ne passe par la corbeille : cette action est irréversible.", Words.size(Cleaner.confirm-size), Cleaner.confirm-entries);
    }
    if Cleaner.confirm-admin: Detail {
        text: @tr("Une fenêtre du système peut vous demander votre mot de passe pour les éléments administrateur. Ils sont mesurés de nouveau juste avant d'être retirés : leur nombre a pu changer depuis l'obtention des droits.");
    }
    understood-box := Rectangle {
        accessible-role: checkbox;
        accessible-checkable: true;
        accessible-checked: Cleaner.understood;
        accessible-label: understood-text.text;
        accessible-action-default => {
            Cleaner.understood = !Cleaner.understood;
        }
        forward-focus: understood-keys;
        understood-keys := FocusScope {
            key-pressed(event) => {
                if !event.repeat && event.text == Key.Space {
                    Cleaner.understood = !Cleaner.understood;
                    return accept;
                }
                reject
            }
        }
        TouchArea {
            clicked => {
                Cleaner.understood = !Cleaner.understood;
            }
        }
        FocusRing {
            shown: understood-keys.has-focus;
            border-radius: Theme.radius-medium;
        }
        HorizontalLayout {
            padding: Theme.spacing-xs;
            spacing: Theme.spacing-s;
            CheckMark {
                checked: Cleaner.understood;
                y: (parent.height - self.height) / 2;
            }
            understood-text := Detail {
                text: @tr("J'ai compris que c'est définitif");
                accessible-role: none;
                vertical-alignment: center;
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        back := ActionButton {
            text: @tr("Annuler");
            kind: ButtonKind.ghost;
            clicked => {
                Cleaner.cancel-confirmation();
            }
        }
        ActionButton {
            text: @tr("Supprimer définitivement");
            kind: ButtonKind.danger;
            enabled: Cleaner.understood;
            clicked => {
                Cleaner.confirm-delete();
            }
        }
    }
}

// A browser open when its caches are to be cleaned: leave them out this time,
// or have Okapi close it and go on. Closed by its buttons or Escape (which
// cancels the cleaning), never by a click outside.
component BrowserQuestion inherits ModalFrame {
    // Its buttons change with what it says, and with the browser asked
    // about: the focus goes back to Ignorer, never left on a Fermer.
    property <BrowserStep> step: Cleaner.browser-step;
    changed step => {
        ignore.focus();
    }
    property <string> name: Cleaner.browser-name;
    changed name => {
        ignore.focus();
    }
    label: title.text;
    init => {
        ignore.focus();
    }
    escaped => {
        Cleaner.cancel-browser();
    }

    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: Theme.icon-box;
            height: Theme.icon-box;
            border-radius: Theme.radius-medium;
            background: Theme.warning-soft;
            Icon {
                source: @image-url("../assets/icons/globe.svg");
                colorize: Theme.warning;
            }
        }
    }
    title := Text {
        text: @tr("{} est ouvert", Cleaner.browser-name);
        accessible-role: none;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: Theme.weight-semibold;
    }
    Detail {
        text: @tr("{} se sert encore de son cache. Fermez-le pour que ce cache soit nettoyé, ou laissez-le de côté cette fois : le reste du nettoyage continue.", Cleaner.browser-name);
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.spacing-m;
        Line {
            horizontal-stretch: 1;
            text: @tr("{} : {}", Cleaner.browser-name, Cleaner.browser-caches);
            wrap: word-wrap;
        }
        Line {
            text: Words.size(Cleaner.browser-size);
            horizontal-alignment: right;
        }
    }
    if Cleaner.browser-step != BrowserStep.ask: Line {
        text: Cleaner.browser-step == BrowserStep.closing ? @tr("Fermeture de {}…", Cleaner.browser-name)
            : Cleaner.browser-step == BrowserStep.not-closed ? @tr("{} ne s'est pas fermé : fermez-le, puis relancez le nettoyage.", Cleaner.browser-name)
            : Cleaner.browser-step == BrowserStep.refused ? @tr("Le système a refusé de demander à {} de se fermer : fermez-le, puis relancez le nettoyage.", Cleaner.browser-name)
            : @tr("Okapi ne peut pas fermer {} lui-même : fermez-le, puis relancez le nettoyage.", Cleaner.browser-name);
        color: Cleaner.browser-step == BrowserStep.closing ? Theme.text-2 : Theme.warning;
        wrap: word-wrap;
        accessible-live-region: polite;
    }
    Detail {
        text: @tr("Échap annule le nettoyage");
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-s;
        ignore := ActionButton {
            text: @tr("Ignorer {}", Cleaner.browser-name);
            kind: ButtonKind.ghost;
            clicked => {
                Cleaner.ignore-browser();
            }
        }
        // Asked once only: a second request could end it at once,
        // in the middle of saving its session.
        if Cleaner.browser-step == BrowserStep.ask || Cleaner.browser-step == BrowserStep.closing: ActionButton {
            text: @tr("Fermer {} et continuer", Cleaner.browser-name);
            kind: ButtonKind.primary;
            enabled: Cleaner.browser-step != BrowserStep.closing;
            clicked => {
                Cleaner.close-browser();
            }
        }
    }
}

export component ResultsPage inherits VerticalLayout {
    property <bool> notes-shown;
    // Opened and closed by Rust, which keeps what it confirms; a page built
    // again shows the confirmation still open.
    property <bool> confirming: Cleaner.confirming;
    init => {
        if self.confirming {
            confirmation.show();
        }
        if self.asking {
            question.show();
        }
    }
    changed confirming => {
        if self.confirming {
            confirmation.show();
        } else {
            confirmation.close();
        }
    }
    // Opened and closed by Rust too, after the confirmation.
    property <bool> asking: Cleaner.browser-asking;
    changed asking => {
        if self.asking {
            question.show();
        } else {
            question.close();
        }
    }

    question := BrowserQuestion {
        x: (root.width - Theme.modal-width) / 2;
        y: root.height / 4;
        width: Theme.modal-width;
    }

    confirmation := Confirmation {
        x: (root.width - Theme.modal-width) / 2;
        y: root.height / 4;
        width: Theme.modal-width;
    }

    VerticalLayout {
        vertical-stretch: 1;
        padding: Screen.page-margin;
        padding-bottom: Theme.spacing-l;
        spacing: Theme.spacing-l;
        HorizontalLayout {
            spacing: Theme.spacing-s;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing-xs;
                Title {
                    text: @tr("Résultats");
                }
                Detail {
                    text: @tr("Trouvé : {}. Éléments : {}.", Words.size(Cleaner.found), Cleaner.result-entries);
                }
            }
            ActionButton {
                text: @tr("Choisir d'autres catégories");
                kind: ButtonKind.ghost;
                y: (parent.height - self.height) / 2;
                clicked => {
                    Cleaner.choose-again();
                }
            }
            ActionButton {
                text: @tr("Nouvelle analyse");
                icon: @image-url("../assets/icons/search.svg");
                kind: ButtonKind.ghost;
                // A refused cleaning does not keep an analysis from starting.
                enabled: Cleaner.problem == SetupProblem.none || Cleaner.problem == SetupProblem.history
                    || Cleaner.problem == SetupProblem.start;
                y: (parent.height - self.height) / 2;
                clicked => {
                    Cleaner.analyze();
                }
            }
        }
        if Cleaner.problem != SetupProblem.none: ProblemBanner { }
        if Cleaner.rights-waiting > 0 || Cleaner.rights-step != RightsStep.idle: RightsBanner { }
        if Cleaner.choices-unreadable != "": Banner {
            warning: true;
            text: @tr("Vos choix précédents n'ont pas pu être lus dans {} : les cases sont comme par défaut, et vos changements ne sont pas retenus pour ne pas écraser ce fichier.", Cleaner.choices-unreadable);
        }
        if Cleaner.choices-unsaved: Banner {
            warning: true;
            text: @tr("Vos derniers changements de cases n'ont pas pu être enregistrés : ils seront oubliés à la fermeture d'Okapi.");
        }
        Card {
            vertical-stretch: 1;
            accessible-role: list;
            accessible-label: @tr("Éléments trouvés");
            VerticalLayout {
                HorizontalLayout {
                    padding-left: Theme.spacing-l + Theme.icon-box;
                    padding-right: Theme.spacing-l;
                    padding-top: Theme.spacing-s;
                    padding-bottom: Theme.spacing-s;
                    spacing: Theme.spacing-m;
                    Detail {
                        horizontal-stretch: 1;
                        text: @tr("Élément");
                        accessible-role: none;
                    }
                    Detail {
                        width: Theme.results-entries-width;
                        horizontal-alignment: right;
                        text: @tr("Éléments");
                        accessible-role: none;
                    }
                    Detail {
                        width: Theme.results-size-width;
                        horizontal-alignment: right;
                        text: @tr("Taille");
                        accessible-role: none;
                    }
                }
                Rectangle {
                    height: Theme.border-width;
                    background: Theme.border;
                }
                // The lines at their own height, scrolled: never stretched or
                // squeezed to the height shown.
                tree := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: lines.preferred-height;
                    lines := VerticalLayout {
                        width: tree.visible-width;
                        alignment: start;
                        for row[index] in Cleaner.results: ResultLine {
                            line: row;
                            index: index;
                            focused(top, height) => {
                                if top + tree.content-y < 0 {
                                    tree.content-y = -top;
                                } else if top + height + tree.content-y > tree.visible-height {
                                    tree.content-y = tree.visible-height - top - height;
                                }
                            }
                        }
                    }
                }
            }
        }
        if Cleaner.notes.length > 0: VerticalLayout {
            spacing: Theme.spacing-s;
            HorizontalLayout {
                spacing: Theme.spacing-s;
                Icon {
                    source: @image-url("../assets/icons/info.svg");
                    colorize: Theme.text-2;
                    width: Theme.icon-small;
                    height: Theme.icon-small;
                    y: (parent.height - self.height) / 2;
                }
                Detail {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: @tr("Remarques de l'analyse : {}", Cleaner.notes.length);
                }
                ActionButton {
                    text: notes-shown ? @tr("Masquer") : @tr("Afficher");
                    kind: ButtonKind.ghost;
                    clicked => {
                        notes-shown = !notes-shown;
                    }
                }
            }
            if notes-shown: VerticalLayout {
                spacing: Theme.spacing-xs;
                for note in Cleaner.notes: NoteLine {
                    note: note;
                }
            }
        }
    }
    Footer {
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing-s;
            alignment: start;
            Detail {
                text: @tr("Sélectionné");
                vertical-alignment: center;
            }
            Text {
                text: Words.size(Cleaner.selected-size);
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }
            Detail {
                text: @tr("Éléments : {} sur {}", Cleaner.selected-entries, Cleaner.result-entries);
                vertical-alignment: center;
            }
        }
        ActionButton {
            text: @tr("Tout désélectionner");
            kind: ButtonKind.ghost;
            enabled: Cleaner.selected-entries > 0;
            y: (parent.height - self.height) / 2;
            clicked => {
                Cleaner.deselect-all();
            }
        }
        ActionButton {
            text: @tr("Nettoyer");
            icon: @image-url("../assets/icons/sparkles.svg");
            kind: ButtonKind.primary;
            large: true;
            enabled: Cleaner.selected-entries > 0;
            y: (parent.height - self.height) / 2;
            clicked => {
                Cleaner.clean();
            }
        }
    }
}
