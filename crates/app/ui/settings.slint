// The settings screen (docs/design/maquette/project/Settings.dc.html):
// the exclusions, the folders to clean and the general settings, each change
// written at once.
import { ScrollView } from "std-widgets.slint";
import { Theme, Screen } from "theme.slint";
import {
    ActionButton, Badge, Banner, ButtonKind, Card, Detail, FocusRing, Icon, IconButton, Line,
    ScrolledList, Title,
} from "widgets.slint";
import {
    EntryError, LanguageChoice, PathKind, PathList, PathRow, Preferences, SaveRefusal, SettingsState,
    ThemeChoice,
} from "settings-model.slint";

// One choice among a few, its segments side by side, the one chosen raised.
// Each segment is a radio button; Tab reaches each, Enter or Space chooses.
component Segmented inherits Rectangle {
    // The group's name, read with each segment.
    in property <string> label;
    in property <[string]> options;
    // None when -1.
    in property <int> chosen;
    in property <bool> enabled: true;
    callback choose(int);

    height: Theme.segment-height + 2 * Theme.segmented-inset;
    border-radius: Theme.radius-medium;
    background: Theme.surface-2;
    border-width: Theme.border-width;
    border-color: Theme.border;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    accessible-role: groupbox;
    accessible-label: label;

    HorizontalLayout {
        padding: Theme.segmented-inset;
        spacing: Theme.segment-gap;
        for option[index] in root.options: Rectangle {
            property <bool> pressed: index == root.chosen;
            height: Theme.segment-height;
            border-radius: Theme.radius-small;
            background: pressed ? Theme.surface : touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
            drop-shadow-color: pressed ? Theme.shadow-1 : transparent;
            drop-shadow-blur: Theme.shadow-1-blur;
            drop-shadow-offset-y: Theme.shadow-1-offset;
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: pressed;
            accessible-enabled: root.enabled;
            accessible-action-default => {
                if root.enabled {
                    root.choose(index);
                }
            }
            forward-focus: keys;

            keys := FocusScope {
                focus-on-tab-navigation: root.enabled;
                key-pressed(event) => {
                    if root.enabled && !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                        root.choose(index);
                        return accept;
                    }
                    reject
                }
            }

            touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.choose(index);
                }
            }

            FocusRing {
                shown: keys.has-focus;
                border-radius: parent.border-radius;
            }

            HorizontalLayout {
                padding-left: Theme.spacing-m;
                padding-right: Theme.spacing-m;
                Text {
                    text: option;
                    accessible-role: none;
                    color: pressed ? Theme.text : Theme.text-2;
                    font-size: Theme.font-small;
                    font-weight: pressed ? Theme.weight-semibold : Theme.weight-medium;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// On or off, read as a switch; Enter or Space turns it.
component Switch inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled;

    width: Theme.switch-width;
    height: Theme.switch-height;
    border-radius: Theme.radius-pill;
    background: on ? Theme.accent : Theme.track;
    border-width: Theme.border-width;
    border-color: on ? Theme.accent : Theme.border-strong;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: on;
    accessible-enabled: enabled;
    accessible-action-default => {
        if enabled {
            root.toggled();
        }
    }
    forward-focus: keys;

    keys := FocusScope {
        focus-on-tab-navigation: root.enabled;
        key-pressed(event) => {
            if root.enabled && !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                root.toggled();
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled();
        }
    }

    FocusRing {
        x: -Theme.focus-width;
        y: -Theme.focus-width;
        width: parent.width + 2 * Theme.focus-width;
        height: parent.height + 2 * Theme.focus-width;
        shown: keys.has-focus;
        border-radius: Theme.radius-pill;
    }

    Rectangle {
        x: root.on ? root.width - self.width - Theme.switch-inset : Theme.switch-inset;
        width: Theme.switch-knob;
        height: Theme.switch-knob;
        border-radius: Theme.radius-pill;
        background: root.on ? Theme.on-accent : Theme.text-2;
    }
}

// A field to type a line in; Enter says it is done. Bordered in the danger
// colour when what it holds is refused.
component EntryField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> refused;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited;

    height: Theme.control-height;
    border-radius: Theme.radius-medium;
    border-width: input.has-focus || refused ? Theme.focus-width : Theme.border-width;
    border-color: refused ? Theme.danger : input.has-focus ? Theme.focus : Theme.border-strong;
    background: Theme.surface;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    forward-focus: input;

    HorizontalLayout {
        padding-left: Theme.spacing-m;
        padding-right: Theme.spacing-m;
        Rectangle {
            input := TextInput {
                text <=> root.text;
                enabled: root.enabled;
                single-line: true;
                color: Theme.text;
                font-size: Theme.font-label;
                vertical-alignment: center;
                accessible-label: root.label;
                accessible-placeholder-text: root.placeholder;
                accepted => {
                    root.accepted(self.text);
                }
                edited => {
                    root.edited();
                }
            }
            if root.text == "": Text {
                text: root.placeholder;
                // Read with the field.
                accessible-role: none;
                color: Theme.text-3;
                font-size: Theme.font-label;
                vertical-alignment: center;
                x: 0;
            }
        }
    }
}

// A row of the general settings: its name and what it does, its control on
// the right.
component SettingRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> description;
    padding: Theme.spacing-l;
    padding-left: Theme.setting-row-padding;
    padding-right: Theme.setting-row-padding;
    spacing: Theme.spacing-l;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: Theme.spacing-xxs;
        Line {
            text: root.name;
            // The control reads it.
            accessible-role: none;
        }
        Detail {
            text: root.description;
        }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

// A row that only tells: no control names it, its name is read.
component InfoRow inherits VerticalLayout {
    in property <string> name;
    in property <string> description;
    padding: Theme.spacing-l;
    padding-left: Theme.setting-row-padding;
    padding-right: Theme.setting-row-padding;
    spacing: Theme.spacing-xxs;
    Line {
        text: root.name;
    }
    Detail {
        text: root.description;
    }
}

component Separator inherits Rectangle {
    height: Theme.border-width;
    background: Theme.border;
}

// A list of paths the settings hold (the exclusions, the folders to clean):
// its lines, each with what it is and a cross to take it out, and a field to
// add one, typed or chosen. What differs from one list to the other is said
// by its properties; the words of the kinds and refusals are said here once.
component PathListCard inherits Card {
    in property <bool> enabled;
    in property <string> heading;
    // Every line is a folder, whatever is read of it.
    in property <bool> folders-only;
    in property <string> detail;
    in property <string> empty;
    // The field's name, read with it and shown above it.
    in property <string> add-label;
    in property <string> placeholder;
    // What a path the list refuses as written must be.
    in property <string> invalid;
    // What "Parcourir" and "Ajouter" do, read with them.
    in property <string> browse-label;
    in property <string> add-button-label;
    in property <[PathRow]> rows;
    in-out property <string> entry;
    in-out property <EntryError> entry-error;
    // Takes the line out, as a screen reader names it: `Retirer … de …`.
    pure callback remove-label(string) -> string;
    callback add(string);
    callback remove(int);
    callback browse();
    property <bool> refused: entry-error != EntryError.none;

    // What its badge says of a line, read with it.
    pure function kind-word(kind: PathKind) -> string {
        if kind == PathKind.folder {
            return @tr("Dossier");
        }
        if kind == PathKind.file {
            return @tr("Fichier");
        }
        if kind == PathKind.extension {
            return @tr("Extension");
        }
        if kind == PathKind.absent {
            return @tr("Absent");
        }
        if kind == PathKind.reading {
            return @tr("Lecture…");
        }
        if kind == PathKind.link {
            return @tr("Lien");
        }
        if kind == PathKind.not-folder {
            return @tr("Pas un dossier");
        }
        if kind == PathKind.protected {
            return @tr("Protégé");
        }
        if kind == PathKind.trash-unknown {
            return @tr("Corbeille illisible");
        }
        if kind == PathKind.trash {
            return @tr("Corbeille");
        }
        if kind == PathKind.personal {
            return @tr("Dossier personnel");
        }
        if kind == PathKind.not-owned {
            return @tr("Autre compte");
        }
        if kind == PathKind.unsure {
            return @tr("Dates peu sûres");
        }
        if kind == PathKind.unverifiable {
            return @tr("Invérifiable");
        }
        if kind == PathKind.unreadable {
            return @tr("Illisible");
        }
        @tr("Invalide")
    }

    // Whether a line is left alone by the analyses (a folder to clean):
    // said as a warning; an invalid one stops them, said as a danger.
    pure function left-alone(kind: PathKind) -> bool {
        kind == PathKind.link || kind == PathKind.not-folder || kind == PathKind.protected
            || kind == PathKind.personal || kind == PathKind.trash || kind == PathKind.trash-unknown
            || kind == PathKind.not-owned
            || kind == PathKind.unsure || kind == PathKind.unreadable || kind == PathKind.unverifiable
    }

    VerticalLayout {
        padding: Theme.spacing-xl;
        spacing: Theme.spacing-l;

        VerticalLayout {
            spacing: Theme.spacing-xs;
            Text {
                text: root.heading;
                color: Theme.text;
                font-size: Theme.font-heading;
                font-weight: Theme.weight-semibold;
            }
            Detail {
                text: root.detail;
            }
        }

        if root.rows.length == 0: Detail {
            text: root.empty;
        }
        // As high as its lines: the page scrolls when the window is lower.
        if root.rows.length > 0: Rectangle {
            height: root.rows.length * Theme.path-row-height + 2 * Theme.border-width;
            border-radius: Theme.radius-medium;
            border-width: Theme.border-width;
            border-color: Theme.border;
            clip: true;
            ScrolledList {
                label: root.heading;
                ring-radius: Theme.radius-medium;
                content-height: root.rows.length * Theme.path-row-height;
                VerticalLayout {
                    for row[index] in root.rows: Rectangle {
                        height: Theme.path-row-height;
                        accessible-role: list-item;
                        accessible-label: row.text;
                        accessible-description: root.kind-word(row.kind);
                        HorizontalLayout {
                            padding-left: Theme.spacing-m;
                            padding-right: Theme.spacing-s;
                            spacing: Theme.spacing-m;
                            Icon {
                                source: row.kind == PathKind.folder || root.folders-only ? @image-url("../assets/icons/folder.svg") : @image-url("../assets/icons/file.svg");
                                colorize: Theme.text-2;
                                cross-axis-self-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: row.text;
                                // Read by its line.
                                accessible-role: none;
                                color: Theme.text;
                                font-size: Theme.font-label;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                Badge {
                                    text: root.kind-word(row.kind);
                                    tone: row.kind == PathKind.invalid ? Theme.danger
                                        : root.left-alone(row.kind) ? Theme.warning : Theme.text-2;
                                    tone-soft: row.kind == PathKind.invalid ? Theme.danger-soft
                                        : root.left-alone(row.kind) ? Theme.warning-soft : Theme.surface-2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                if root.enabled: IconButton {
                                    icon: @image-url("../assets/icons/x.svg");
                                    label: root.remove-label(row.text);
                                    clicked => {
                                        root.remove(index);
                                    }
                                }
                            }
                        }
                        if index < root.rows.length - 1: Separator {
                            y: parent.height - self.height;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Theme.spacing-s;
            Line {
                text: root.add-label;
                // The field reads it.
                accessible-role: none;
            }
            HorizontalLayout {
                spacing: Theme.spacing-s;
                EntryField {
                    horizontal-stretch: 1;
                    label: root.add-label;
                    placeholder: root.placeholder;
                    text <=> root.entry;
                    refused: root.refused;
                    enabled: root.enabled;
                    accepted(text) => {
                        root.add(text);
                    }
                    edited => {
                        root.entry-error = EntryError.none;
                    }
                }
                ActionButton {
                    text: @tr("Parcourir");
                    spoken: root.browse-label;
                    icon: @image-url("../assets/icons/folder.svg");
                    enabled: root.enabled && !Preferences.browsing;
                    clicked => {
                        root.browse();
                    }
                }
                ActionButton {
                    text: @tr("Ajouter");
                    spoken: root.add-button-label;
                    icon: @image-url("../assets/icons/plus.svg");
                    enabled: root.enabled;
                    clicked => {
                        root.add(root.entry);
                    }
                }
            }
            if root.refused: Text {
                text: root.entry-error == EntryError.invalid ? root.invalid
                    : root.entry-error == EntryError.unreadable ? @tr("Cet emplacement ne se lit pas.")
                    : root.entry-error == EntryError.duplicate ? @tr("Déjà dans la liste.")
                    : root.entry-error == EntryError.not-text ? @tr("Ce chemin a des caractères que les réglages ne savent pas écrire.")
                    : root.entry-error == EntryError.absent ? @tr("Ce dossier n'existe pas.")
                    : root.entry-error == EntryError.link ? @tr("C'est un lien : choisissez le dossier vers lequel il mène.")
                    : root.entry-error == EntryError.not-folder ? @tr("Ce n'est pas un dossier.")
                    : root.entry-error == EntryError.protected ? @tr("Okapi ne vide jamais ce dossier : il est ou contient un dossier dont votre session ou vos applis dépendent (dossier utilisateur, réglages, caches...).")
                    : root.entry-error == EntryError.personal ? @tr("Okapi ne vide jamais un dossier personnel (Documents, Images, Téléchargements...) ni ce qui en contient un : choisissez un dossier à l'intérieur.")
                    : root.entry-error == EntryError.trash ? @tr("Okapi ne vide jamais comme dossier choisi la corbeille, ce qu'elle contient ni ce qui la contient : la ligne « Corbeille » du Nettoyeur vide la corbeille, choisissez un dossier à côté d'elle.")
                    : root.entry-error == EntryError.trash-unknown ? @tr("Okapi ne sait pas lire votre corbeille : il ne peut vérifier aucun dossier à nettoyer.")
                    : root.entry-error == EntryError.not-owned ? @tr("Ce dossier appartient à un autre compte ou au système : Okapi ne le vide pas.")
                    : root.entry-error == EntryError.unsure ? @tr("Sur une clé FAT ou exFAT, un partage réseau ou d'une machine virtuelle, un système FUSE ou superposé, ou un système qu'Okapi ne sait pas dire, l'âge des fichiers n'est pas sûr : Okapi ne les vide pas.")
                    : root.entry-error == EntryError.unverifiable ? @tr("Okapi ne sait pas lire la liste de vos dossiers personnels (user-dirs.dirs) : il ne peut vérifier aucun dossier à nettoyer.")
                    : @tr("Le sélecteur de dossiers n'a pas pu s'ouvrir : écrivez le chemin.");
                accessible-live-region: polite;
                color: Theme.danger;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}

// What Okapi never touches.
component Exclusions inherits PathListCard {
    heading: @tr("Exclusions");
    detail: @tr("Okapi ne touche jamais à ce qui est listé ici. Un dossier exclut tout ce qu'il contient ; une extension s'écrit *.ext.");
    empty: @tr("Aucune exclusion.");
    add-label: @tr("Ajouter une exclusion");
    placeholder: @tr("Chemin ou *.ext");
    invalid: @tr("Un chemin absolu (/… ou ~/…) ou une extension *.ext.");
    browse-label: Preferences.chooser-title;
    add-button-label: @tr("Ajouter l'exclusion");
    rows: Preferences.exclusions;
    entry <=> Preferences.entry;
    entry-error <=> Preferences.entry-error;
    remove-label(text) => {
        @tr("Retirer {} des exclusions", text)
    }
    add(text) => {
        Preferences.add(PathList.exclusions, text);
    }
    remove(index) => {
        Preferences.remove(PathList.exclusions, index);
    }
    browse => {
        Preferences.browse(PathList.exclusions);
    }
}

// The folders the user chose to have emptied.
component Folders inherits PathListCard {
    heading: @tr("Dossiers à nettoyer");
    folders-only: true;
    detail: @tr("À chaque analyse de « Mes dossiers », Okapi propose ce qu'ils contiennent depuis plus longtemps que l'âge minimal, jamais le dossier lui-même. Leurs groupes ne sont jamais cochés d'avance, et ce que vous cochez est supprimé définitivement.");
    empty: @tr("Aucun dossier à nettoyer.");
    add-label: @tr("Ajouter un dossier à nettoyer");
    placeholder: @tr("Chemin d'un dossier");
    invalid: @tr("Un chemin absolu sans .. (/… ou ~/…).");
    browse-label: Preferences.folder-chooser-title;
    add-button-label: @tr("Ajouter le dossier à nettoyer");
    rows: Preferences.folders;
    entry <=> Preferences.folder-entry;
    entry-error <=> Preferences.folder-entry-error;
    remove-label(text) => {
        @tr("Retirer {} des dossiers à nettoyer", text)
    }
    add(text) => {
        Preferences.add(PathList.folders, text);
    }
    remove(index) => {
        Preferences.remove(PathList.folders, index);
    }
    browse => {
        Preferences.browse(PathList.folders);
    }
}

component General inherits Card {
    in property <bool> enabled;

    VerticalLayout {
        SettingRow {
            name: @tr("Âge minimal des fichiers retirés");
            description: Preferences.min-age-chosen < 0
                ? @tr("Un fichier modifié plus récemment n'est jamais retiré. Réglé à {} min dans le fichier.", Preferences.min-age-written)
                : @tr("Un fichier modifié plus récemment n'est jamais retiré. Par défaut : {}.", Preferences.age(Preferences.default-min-age));
            Segmented {
                label: @tr("Âge minimal des fichiers retirés");
                options: Preferences.min-age-options;
                chosen: Preferences.min-age-chosen;
                enabled: root.enabled;
                choose(index) => {
                    Preferences.choose-min-age(index);
                }
            }
        }
        Separator { }
        SettingRow {
            name: @tr("Journal des suppressions");
            description: Preferences.state-directory == ""
                ? @tr("Aucun historique n'est tenu : ni XDG_STATE_HOME ni HOME ne sont utilisables.")
                : @tr("Garde dans l'historique ({}), pour chaque nettoyage, la liste des chemins retirés. Quand l'historique dépasse la taille gardée, ses plus anciens nettoyages, désinstallations et mises à jour partent, avec leur liste.", Preferences.state-directory);
            HorizontalLayout {
                spacing: Theme.spacing-m;
                Detail {
                    text: Preferences.deletion-log ? @tr("Activé") : @tr("Désactivé");
                    // The switch says it.
                    accessible-role: none;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
                Switch {
                    label: @tr("Journal des suppressions");
                    on: Preferences.deletion-log;
                    enabled: root.enabled;
                    toggled => {
                        Preferences.toggle-deletion-log();
                    }
                }
            }
        }
        Separator { }
        InfoRow {
            name: @tr("Journal technique");
            description: Preferences.state-directory == ""
                ? @tr("Aucun journal technique n'est tenu : ni XDG_STATE_HOME ni HOME ne sont utilisables.")
                : @tr("{} et {}, avec leurs copies .1, dans {}, gardent quelques semaines le détail de chaque lancement, dont les chemins analysés, supprimés ou mis à la corbeille, les applis et vos exclusions. Relisez-les avant de les partager. Le réglage « Journal des suppressions » n'y change rien.", Preferences.app-journal, Preferences.cli-journal, Preferences.state-directory);
        }
        Separator { }
        SettingRow {
            name: @tr("Langue");
            description: @tr("S'applique au prochain démarrage d'Okapi.");
            Segmented {
                label: @tr("Langue");
                options: [@tr("Système"), @tr("Français"), @tr("English")];
                chosen: Preferences.language == LanguageChoice.french ? 1 : Preferences.language == LanguageChoice.english ? 2 : 0;
                enabled: root.enabled;
                choose(index) => {
                    Preferences.choose-language(index == 1 ? LanguageChoice.french : index == 2 ? LanguageChoice.english : LanguageChoice.system);
                }
            }
        }
        Separator { }
        SettingRow {
            name: @tr("Thème");
            description: @tr("« Système » suit le thème clair ou sombre du bureau.");
            Segmented {
                label: @tr("Thème");
                options: [@tr("Système"), @tr("Clair"), @tr("Sombre")];
                chosen: Preferences.theme == ThemeChoice.light ? 1 : Preferences.theme == ThemeChoice.dark ? 2 : 0;
                enabled: root.enabled;
                choose(index) => {
                    Preferences.choose-theme(index == 1 ? ThemeChoice.light : index == 2 ? ThemeChoice.dark : ThemeChoice.system);
                }
            }
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    property <bool> enabled: Preferences.state == SettingsState.editable;

    // Made each time the page shows: the file may have changed since.
    init => {
        Preferences.reload();
    }

    // The page scrolls when the window is too low for both lists and the
    // general settings: each list then shows all its lines.
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding: Screen.page-margin;
            spacing: Theme.spacing-xl;
            alignment: start;

            VerticalLayout {
                spacing: Theme.spacing-xs;
                Title {
                    text: @tr("Réglages");
                }
                Detail {
                    text: @tr("Chaque changement est enregistré tout de suite.");
                }
            }

            if Preferences.state == SettingsState.linked: Banner {
                text: @tr("Vos réglages sont un lien : modifiez-les à la main.");
            }
            if Preferences.state == SettingsState.no-writer: Banner {
                warning: true;
                text: @tr("Okapi ne peut pas enregistrer ses réglages : le détail est dans le journal.");
            }
            if Preferences.state == SettingsState.no-directory: Banner {
                warning: true;
                text: @tr("Okapi ne sait pas où ranger ses réglages : ni XDG_CONFIG_HOME ni HOME ne sont utilisables.");
            }
            if Preferences.state == SettingsState.unreadable: HorizontalLayout {
                spacing: Theme.spacing-m;
                Banner {
                    horizontal-stretch: 1;
                    warning: true;
                    text: @tr("{} ne se lit pas : corrigez-le ou supprimez-le. Okapi ne le remplace pas.", Preferences.settings-file);
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: @tr("Relire");
                        icon: @image-url("../assets/icons/rotate-ccw.svg");
                        clicked => {
                            Preferences.read-again();
                        }
                    }
                }
            }
            if Preferences.save-refused != SaveRefusal.none: Banner {
                warning: true;
                text: Preferences.save-refused == SaveRefusal.changed-elsewhere
                    ? @tr("Vos réglages ont été modifiés hors de cet écran : vos derniers changements n'ont pas été enregistrés, pour ne pas effacer ceux faits ailleurs. Refaites-les si besoin.")
                    : @tr("Ce réglage n'a pas pu être enregistré (le détail est dans le journal).");
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.spacing-l;
                alignment: stretch;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: Theme.spacing-l;
                    Exclusions {
                        enabled: root.enabled;
                    }
                    Folders {
                        enabled: root.enabled;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    General {
                        enabled: root.enabled;
                    }
                }
            }
        }
    }
}
