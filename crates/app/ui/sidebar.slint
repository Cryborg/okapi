import { Theme, Brand } from "theme.slint";
import { IconButton } from "widgets.slint";

// The screens the sidebar leads to: only those that exist.
export enum Page { home, cleaner, about }

// One entry of the sidebar: its icon and words carry it, never colour alone.
// Reached with Tab, chosen with Enter or Space, its focus ring visible.
// Folded, its words go to a tooltip, and the current one keeps a mark on
// its edge: its background alone would be colour only.
component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> folded;
    callback clicked;

    height: Theme.control-height;
    border-radius: Theme.radius-medium;
    background: active ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-item-selectable: true;
    accessible-item-selected: active;
    // What a screen reader says of the current entry (Orca ignores the
    // selected state of a button).
    accessible-description: active ? @tr("page affichée") : "";
    accessible-action-default => {
        root.clicked();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        // No focus on a click: the ring shows only for the keyboard.
        clicked => {
            root.clicked();
        }
        // A tooltip's text is styled: the label goes in as it is.
        if root.folded: Tooltip {
            text: @markdown("\{root.label}");
        }
    }

    Rectangle {
        border-radius: root.border-radius;
        border-width: keys.has-focus ? Theme.focus-width : 0;
        border-color: Theme.focus;
    }

    if root.folded && root.active: current := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: Theme.sidebar-mark-width;
        height: Theme.icon;
        border-radius: self.width / 2;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: root.folded ? 0 : Theme.spacing-m;
        spacing: Theme.spacing-m;
        alignment: root.folded ? center : start;
        Image {
            source: icon;
            colorize: active ? Theme.text : Theme.text-2;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
            accessible-role: none;
        }
        if !root.folded: Text {
            text: label;
            accessible-role: none;
            color: active ? Theme.text : Theme.text-2;
            font-size: Theme.font-label;
            font-weight: active ? Theme.weight-semibold : Theme.weight-medium;
            vertical-alignment: center;
        }
    }
}

// Folded, by the user's choice or because the window is narrow, it shows
// its icons only. Narrow, it has no button: the window folds it whatever
// the choice, the button would do nothing.
export component Sidebar inherits Rectangle {
    in property <Page> page;
    // The user's choice, kept while the window is narrow.
    in-out property <bool> chosen-folded;
    in property <bool> narrow;
    callback navigate(Page);
    // The user chose to fold it or not (never said for a value set from
    // outside).
    callback fold-chosen(folded: bool);

    property <bool> folded: chosen-folded || narrow;

    width: folded ? Theme.sidebar-folded-width : Theme.sidebar-width;
    background: Theme.sidebar;

    VerticalLayout {
        padding: Theme.spacing-m;
        spacing: Theme.spacing-xxs;

        HorizontalLayout {
            height: Theme.brand-height;
            spacing: Theme.spacing-m;
            padding-left: root.folded ? 0 : Theme.spacing-xs;
            alignment: root.folded ? center : stretch;
            // Folded by choice, the unfold button takes the mark's place;
            // narrow, there is no button, the mark stays.
            if !root.folded || root.narrow: mark := Image {
                source: @image-url("../assets/okapi.svg");
                width: Theme.mark-small;
                height: Theme.mark-small;
                y: (parent.height - self.height) / 2;
                // Decorates the name beside it.
                accessible-role: none;
            }
            if !root.folded: Text {
                text: Brand.name;
                color: Theme.text;
                font-size: Theme.font-heading;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if !root.narrow: IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.folded ? @image-url("../assets/icons/panel-left-open.svg") : @image-url("../assets/icons/panel-left-close.svg");
                label: root.folded ? @tr("Déplier la barre latérale") : @tr("Replier la barre latérale");
                accessible-expandable: true;
                accessible-expanded: !root.folded;
                clicked => {
                    root.chosen-folded = !root.chosen-folded;
                    root.fold-chosen(root.chosen-folded);
                }
            }
        }

        NavItem {
            icon: @image-url("../assets/icons/home.svg");
            label: @tr("Accueil");
            folded: root.folded;
            active: root.page == Page.home;
            clicked => {
                root.navigate(Page.home);
            }
        }

        NavItem {
            icon: @image-url("../assets/icons/sparkles.svg");
            label: @tr("Nettoyeur");
            folded: root.folded;
            active: root.page == Page.cleaner;
            clicked => {
                root.navigate(Page.cleaner);
            }
        }

        Rectangle { }

        Rectangle {
            height: Theme.border-width;
            background: Theme.border;
        }

        NavItem {
            icon: @image-url("../assets/icons/info.svg");
            label: @tr("À propos");
            folded: root.folded;
            active: root.page == Page.about;
            clicked => {
                root.navigate(Page.about);
            }
        }
    }

    // Its right edge.
    Rectangle {
        x: parent.width - self.width;
        width: Theme.border-width;
        background: Theme.border;
    }
}
