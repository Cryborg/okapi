// The design tokens, mirrored from docs/design/maquette/project/okapi.css:
// the single source for every colour, size and duration of the interface.
import { Palette } from "std-widgets.slint";

export global Theme {
    // Follows the system until the settings let the user choose.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> background: dark ? #151614 : #F5F5F2;
    out property <color> sidebar: dark ? #1A1B19 : #ECEBE6;
    out property <color> surface: dark ? #1F201E : #FFFFFF;
    out property <color> surface-2: dark ? #262724 : #F0EFEB;
    out property <color> surface-hover: dark ? #2E302C : #E7E5DF;
    out property <color> border: dark ? #34362F : #DCDAD3;
    out property <color> border-strong: dark ? #55574F : #B9B6AD;
    out property <color> track: dark ? #33352F : #E4E2DC;
    out property <color> text: dark ? #ECEBE6 : #1C1B19;
    out property <color> text-2: dark ? #B6B3AA : #55524B;
    out property <color> text-3: dark ? #99958C : #6B675F;
    out property <color> accent: dark ? #43C6B0 : #0E7466;
    out property <color> accent-hover: dark ? #66D4C1 : #0A5E53;
    out property <color> accent-soft: dark ? #163D37 : #DCF0EB;
    out property <color> on-accent: dark ? #06201C : #FFFFFF;
    out property <color> warning: dark ? #F0C062 : #8A5A00;
    out property <color> warning-soft: dark ? #382D15 : #FBF0D8;
    out property <color> success: dark ? #7DD39B : #1D7A3B;
    out property <color> success-soft: dark ? #183323 : #E1F2E6;
    out property <color> danger: dark ? #F28B80 : #B42318;
    out property <color> danger-hover: dark ? #F6A59C : #951C13;
    out property <color> danger-soft: dark ? #43211D : #FCE8E6;
    out property <color> on-danger: dark ? #2B0B07 : #FFFFFF;
    out property <length> modal-width: 440px;
    out property <color> admin: dark ? #BBA6F4 : #6340B8;
    out property <color> admin-soft: dark ? #2B2444 : #EEE8FA;
    out property <color> shadow-1: dark ? #00000066 : #1C1B1914;
    // A note of the whole screen (Banner).
    out property <color> info: dark ? #93B6F5 : #245AB8;
    out property <color> info-soft: dark ? #1C2A42 : #E4ECFA;
    // The focus ring, visible everywhere.
    out property <color> focus: dark ? #7EA6FF : #2F6FEB;
    out property <length> focus-width: 2px;
    // What an arrow key scrolls.
    out property <length> scroll-step: 40px;

    // Spacing scale.
    out property <length> spacing-xxs: 2px;
    out property <length> spacing-xs: 4px;
    out property <length> spacing-s: 8px;
    out property <length> spacing-m: 12px;
    out property <length> spacing-l: 16px;
    out property <length> spacing-xl: 24px;
    out property <length> spacing-xxl: 32px;

    out property <length> radius-small: 4px;
    out property <length> radius-medium: 8px;
    out property <length> radius-pill: 999px;
    out property <length> radius-large: 12px;
    out property <length> border-width: 1px;
    out property <length> shadow-1-blur: 3px;
    out property <length> shadow-1-offset: 1px;

    out property <length> font-display: 28px;
    out property <length> font-title: 20px;
    out property <length> font-heading: 16px;
    out property <length> font-label: 14px;
    out property <length> font-small: 13px;
    out property <length> font-caption: 12px;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;

    // The size the mockup draws every screen at.
    out property <length> window-width: 1280px;
    out property <length> window-height: 800px;

    out property <length> sidebar-width: 248px;
    // Folded, the sidebar shows its icons only.
    out property <length> sidebar-folded-width: 64px;
    // Below it, the window is narrow: the sidebar folds, the dashboard's
    // margins narrow.
    out property <length> narrow-below: 1100px;
    out property <length> brand-height: 44px;
    out property <length> control-height: 36px;
    out property <length> control-height-large: 48px;
    out property <length> footer-height: 72px;
    out property <length> icon: 20px;
    out property <length> icon-small: 16px;
    out property <length> icon-badge: 14px;
    out property <length> icon-large: 48px;
    out property <length> icon-box: 40px;
    out property <length> checkbox: 18px;
    out property <length> empty-icon-box: 88px;
    out property <length> radius-empty-icon: 24px;
    out property <length> empty-width: 560px;
    // Slint's own "Made with Slint" mark, at a fixed size: it would grow
    // with the window.
    out property <length> made-with-slint-width: 160px;
    // The columns of an analysis row: name, status, size.
    out property <length> row-name-width: 180px;
    out property <length> row-status-width: 120px;
    out property <length> row-size-width: 90px;
    // The entries a cleaning step went through, "done of all".
    out property <length> step-count-width: 90px;
    // The columns of the results: entries, size; and a group's indent.
    out property <length> results-entries-width: 96px;
    out property <length> results-size-width: 96px;
    out property <length> results-indent: 40px;
    out property <length> results-row-height: 44px;
    out property <length> checkbox-border: 1.5px;
    out property <length> badge-height: 22px;
    out property <length> bar-height: 6px;
    out property <length> bar-height-large: 8px;
    // What a disabled control keeps of its opacity.
    out property <float> disabled-opacity: 0.45;
    // One sweep of an indeterminate bar, and the part of the track it covers.
    out property <duration> indeterminate-sweep: 1400ms;
    out property <float> indeterminate-part: 0.3;
    out property <length> mark-small: 32px;
    out property <length> mark-large: 96px;

    // The dashboard's grid: the narrowest column, a row and the space
    // between them. How many columns it may have is Rust's
    // (`dashboard::layout::MAX_COLUMNS`).
    out property <length> dash-column-min: 300px;
    out property <length> dash-row: 176px;
    out property <length> dash-gap: 16px;
    // A widget: its header, and its body's margins.
    out property <length> widget-header: 24px;
    out property <length> widget-padding: 20px;
    out property <length> widget-padding-top: 16px;
    out property <length> widget-body-top: 12px;
    // The width of the column of the Analyser button, full width and not.
    out property <length> reclaim-actions-full: 240px;
    out property <length> reclaim-actions: 132px;
    // The lists of a widget: a line of a compact one, of a detailed one,
    // the space between volumes, and between the two columns of a wide one.
    out property <length> widget-line: 18px;
    out property <length> widget-line-large: 28px;
    out property <length> volume-gap: 12px;
    out property <length> volume-gap-large: 16px;
    out property <length> volume-column-gap: 24px;
    // The memory: the space between its summary and its applications, and
    // the summary's width beside them at the largest size.
    out property <length> memory-gap: 12px;
    out property <length> memory-gap-wide: 28px;
    out property <length> memory-summary-width: 240px;
    out property <length> bar-height-small: 4px;
    // Room left on the right of a list that scrolls, for its bar; the
    // volumes a widget shows before its list scrolls.
    out property <length> scroll-gutter: 10px;
    out property <int> volumes-in-view: 4;
    // The processor's summary beside its curve, and the curve's line.
    out property <length> processor-summary-width: 180px;
    out property <length> curve-stroke: 2px;
    // The Personnaliser mode: a widget's bar, the width from which "Retirer"
    // says its word, a size button and the shape drawn in it.
    out property <length> edit-bar: 44px;
    out property <length> remove-word-from: 416px;
    out property <length> size-button: 28px;
    out property <length> size-shape: 16px;
    out property <length> size-shape-border: 1.5px;
    // A widget's grip, and how far it sits from its bar's left.
    out property <length> grip-inset: 4px;
    out property <length> grip-width: 28px;
    out property <length> grip-height: 32px;
    // A widget picked up: its border, and the shadow of what floats.
    out property <length> grab-border: 2px;
    out property <color> shadow-3: dark ? #00000099 : #1C1B193D;
    out property <length> shadow-3-blur: dark ? 48px : 40px;
    out property <length> shadow-3-offset: dark ? 20px : 16px;
    // How far the pointer goes before a press on a grip is a drag.
    out property <length> drag-threshold: 4px;
    // A widget dragged this near the list's edge scrolls it by a step,
    // every so often.
    out property <length> drag-scroll-edge: 48px;
    out property <length> drag-scroll-step: 12px;
    out property <duration> drag-scroll-every: 16ms;
    // The tile that adds a widget, its round, its border; the dialog that
    // lists the widgets to add; the note of a removal.
    out property <length> add-dot: 40px;
    out property <length> add-tile-border: 1.5px;
    out property <length> add-dialog-width: 520px;
    out property <length> toast-width: 440px;
    // The names' column of a key-value list.
    out property <length> key-width: 112px;
    out property <length> font-hero: 40px;
    // The loading blocks pulse between full and this opacity; the first
    // stands for a figure, the last for a line, by the part of the width
    // they take.
    out property <float> skeleton-dim: 0.5;
    out property <duration> skeleton-pulse: 1400ms;
    out property <length> skeleton-figure: 28px;
    out property <percent> skeleton-figure-part: 46%;
    out property <percent> skeleton-line-part: 68%;
}

// What the product is called: a name, never translated.
export global Brand {
    out property <string> name: "Okapi";
}
