import { Size } from "cleaner-model.slint";
import { Moment } from "dashboard-model.slint";

// Where the screen stands: never searched yet, searching, read.
export enum UpdatesStep { idle, searching, read }

// What a source came to: not on this system, read, or failed.
export enum SourceState { absent, read, failed }

// Why a source failed, as the user is told (`okapi_tools::updates::Failure`).
export enum SourceFailure { busy, offline, refused, unanswered, broken }

// How an update matters, in the order shown.
export enum UpdateKind { security, other, blocked }

// A package of the system with an update waiting: its version as the
// package names it, and as a screen reader says it (`3.5.1`).
export struct SystemLine {
    name: string,
    summary: string,
    version: string,
    spoken-version: string,
    kind: UpdateKind,
}

// Where an installation stands: none, what it would remove awaiting the
// user, under way, or its outcome read again.
export enum InstallStep { idle, confirm, running, verifying }

// What an installation updates: the system's packages, or snaps.
export enum InstallTarget { system, snaps }

// What an installation under way does (`okapi_tools::updates::install::Phase`).
export enum InstallPhase { preparing, waiting, authorizing, downloading, installing, cancelling }

// How the last installation ended: done (some may wait still), cancelled,
// failed (the system: nothing installed; snaps: some wait still), or
// stopped while dpkg installed.
export enum InstallEnd { done, cancelled, failed, stopped }

// Why the updates were not installed (`okapi_tools::updates::install::Why`).
// `none` when it did not fail.
export enum InstallWhy { none, busy, interrupted, offline, no-space, refused, changed, apps-open, unsigned, unanswered, broken }

// A package an update would take away.
export struct RemovedLine {
    name: string,
    summary: string,
}

// A snap with a newer revision waiting.
export struct SnapLine {
    title: string,
    publisher: string,
    verified: bool,
    version: string,
    size: Size,
    has-size: bool,
}

// The updates screen: Rust fills it, the page shows it and calls back.
export global Updates {
    in property <UpdatesStep> step;
    // The search downloads the package lists first.
    in property <bool> refreshing;
    // Another program holds the package manager: the search waits for it.
    in property <bool> waiting;
    // A list was read before: shown, faded, while a search runs; and it is
    // still that one (no source has told the new one yet).
    in property <bool> has-read;
    in property <bool> previous-shown;
    // Since the last reading: minutes, then the moment.
    in property <int> minutes;
    in property <Moment> read-at;
    // The distribution's name, if known.
    in property <string> distribution;

    in property <SourceState> system-state;
    in property <SourceFailure> system-failure;
    // Waiting to be installed, of security among them, and held back by
    // the system (listed, never waiting).
    in property <int> system-count;
    in property <int> system-security;
    in property <int> system-held;
    // The packages shown (the first ones, or all), and how many more there
    // are.
    in property <[SystemLine]> system-lines;
    in property <int> system-more;
    // What installing the system's updates downloads, when every size is
    // known.
    in property <bool> has-system-download;
    in property <Size> system-download;
    in-out property <bool> system-expanded;
    // The lists were not downloaded again this time; or, not downloaded
    // this time, they are old or of an unknown age: dated, never « à jour ».
    in property <bool> refresh-failed;
    in property <SourceFailure> refresh-failure;
    in property <bool> lists-old;
    in property <bool> has-listed-at;
    in property <Moment> listed-at;

    in property <SourceState> snaps-state;
    in property <SourceFailure> snaps-failure;
    in property <[SnapLine]> snap-lines;
    in property <Size> snaps-size;
    in property <bool> has-snaps-size;
    in property <bool> has-next-refresh;
    in property <Moment> next-refresh;

    // A restart is awaited, and the packages that asked for it.
    in property <bool> reboot;
    in property <[string]> reboot-packages;
    in-out property <bool> reboot-expanded;

    // Anything but idle: no other installation, no search.
    in property <InstallStep> install-step;
    in property <InstallTarget> install-target;
    // The snap's title, when one is updated alone.
    in property <string> install-name;
    in property <InstallPhase> install-phase;
    // Of 100, when known.
    in property <bool> install-has-percentage;
    in property <int> install-percentage;
    // The package at hand, and the packages dpkg finished of all it handles
    // (0: not known).
    in property <string> install-package;
    in property <int> install-done;
    in property <int> install-total;
    in property <bool> install-cancellable;
    // It could be cancelled, and no longer can.
    in property <bool> install-too-late;
    in property <bool> install-cancel-asked;
    // What is downloaded of what is to be (snaps).
    in property <bool> install-has-bytes;
    in property <Size> install-bytes-done;
    in property <Size> install-bytes-total;
    // What the update would take away, and how many packages it brings in;
    // the list changed since it was last shown.
    in property <[RemovedLine]> removed;
    // How many it removes, and how many are not listed.
    in property <int> removed-count;
    in property <int> removed-more;
    in property <int> added;
    in property <bool> removals-changed;

    // The last installation's outcome, until closed.
    in property <bool> result-shown;
    in property <InstallEnd> result-end;
    in property <InstallTarget> result-target;
    in property <InstallWhy> result-why;
    // Its counts are known: snaps by the list read again; the system done,
    // every update asked.
    in property <bool> result-counted;
    in property <int> result-installed;
    // Asked and still waiting: their names (the first ones), and how many
    // more.
    in property <int> result-left;
    in property <string> result-left-names;
    in property <int> result-left-more;
    in property <bool> result-restart;
    // What dpkg removed that was never shown, by name; and whether some of
    // what it said could not be read (a removal may have gone unseen).
    in property <string> result-unshown;
    in property <bool> result-unchecked;
    // Something of it still waits and trying again may mend it.
    in property <bool> result-retriable;

    // Downloads the package lists, then reads again.
    callback search-now();
    // The last search, again.
    callback retry();
    callback show-all-system();
    callback update-system();
    // The snap of this line of `snap-lines`.
    callback update-snap(int);
    callback update-snaps();
    // What the update removes, shown, is accepted.
    callback confirm-update();
    // Closes the confirmation, or asks the installation to stop.
    callback cancel-update();
    callback close-result();
    // The last installation again, on what still waits.
    callback retry-update();
}
