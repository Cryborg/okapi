// The controls every screen shares, drawn from the mockup's components
// (docs/design/maquette/project/Components.dc.html).
import { ScrollView } from "std-widgets.slint";
import { Theme, Screen } from "theme.slint";

export component Card inherits Rectangle {
    // Picked up: outlined in the accent, floating over the page.
    in property <bool> raised;
    background: Theme.surface;
    border-color: raised ? Theme.accent : Theme.border;
    border-width: raised ? Theme.grab-border : Theme.border-width;
    border-radius: Theme.radius-large;
    drop-shadow-color: raised ? Theme.shadow-3 : Theme.shadow-1;
    drop-shadow-blur: raised ? Theme.shadow-3-blur : Theme.shadow-1-blur;
    drop-shadow-offset-y: raised ? Theme.shadow-3-offset : Theme.shadow-1-offset;
}

export component Line inherits Text {
    color: Theme.text;
    font-size: Theme.font-label;
    font-weight: Theme.weight-medium;
    wrap: word-wrap;
}

export component Detail inherits Text {
    color: Theme.text-2;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

export component Title inherits Text {
    color: Theme.text;
    font-size: Theme.font-display;
    font-weight: Theme.weight-semibold;
}

// An icon beside words that say the same: never read.
export component Icon inherits Image {
    width: Theme.icon;
    height: Theme.icon;
    accessible-role: none;
}

// A small line led by an icon in its tone: the icon only marks it, the
// words that follow say it all.
component IconLine inherits HorizontalLayout {
    in property <image> icon;
    in property <color> tone: Theme.text-2;
    spacing: Theme.spacing-s;
    Icon {
        source: root.icon;
        colorize: root.tone;
        width: Theme.icon-small;
        height: Theme.icon-small;
    }
    @children
}

// A note led by an icon, never read: the control it explains reads it.
export component IconNote inherits IconLine {
    in property <string> text;
    Detail {
        horizontal-stretch: 1;
        text: root.text;
        color: root.tone;
        accessible-role: none;
    }
}

// A note led by an icon, read: nothing else says it.
export component ReadIconNote inherits IconLine {
    in property <string> text;
    Detail {
        horizontal-stretch: 1;
        text: root.text;
        color: root.tone;
    }
}

// The ring around the control that has the keyboard focus.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    border-width: shown ? Theme.focus-width : 0;
    border-color: Theme.focus;
}

// A square button that shows only an icon: its label is read, and shown in
// a tooltip. Reached with Tab, pressed with Enter or Space, its focus ring
// visible.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked;

    width: Theme.icon-box;
    height: Theme.icon-box;
    border-radius: Theme.radius-medium;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        // A tooltip's text is styled: the label goes in as it is.
        Tooltip {
            text: @markdown("\{root.label}");
        }
    }

    FocusRing {
        shown: keys.has-focus;
        border-radius: root.border-radius;
    }

    Icon {
        source: root.icon;
        colorize: Theme.text-2;
    }
}

export enum ButtonKind { primary, secondary, ghost, danger }

// A button with words, and an icon beside them at times. Reached with Tab,
// pressed with Enter or Space, its focus ring visible; disabled, it is
// skipped and says so.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> large;
    in property <bool> enabled: true;
    // The keyboard's focus is on it.
    out property <bool> focused: keys.has-focus;
    callback clicked;

    forward-focus: keys;
    height: large ? Theme.control-height-large : Theme.control-height;
    border-radius: large ? Theme.radius-large : Theme.radius-medium;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    background: kind == ButtonKind.danger ? (hovered ? Theme.danger-hover : Theme.danger)
        : kind == ButtonKind.primary ? (hovered ? Theme.accent-hover : Theme.accent)
        : hovered ? Theme.surface-hover
        : kind == ButtonKind.secondary ? Theme.surface : transparent;
    border-width: kind == ButtonKind.secondary ? Theme.border-width : 0;
    border-color: Theme.border-strong;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if enabled {
            root.clicked();
        }
    }

    property <bool> hovered: enabled && touch.has-hover;

    // Always enabled: a disabled scope would also miss losing the focus,
    // and keep its ring. Tab skips it while disabled.
    keys := FocusScope {
        focus-on-tab-navigation: root.enabled;
        key-pressed(event) => {
            // A button disabled while it has the focus keeps it.
            if root.enabled && !event.repeat && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        // No focus on a click: the ring shows only for the keyboard.
        clicked => {
            root.clicked();
        }
    }

    FocusRing {
        shown: keys.has-focus;
        border-radius: root.border-radius;
    }

    HorizontalLayout {
        padding-left: large ? Theme.spacing-xl : Theme.spacing-l;
        padding-right: self.padding-left;
        spacing: Theme.spacing-s;
        alignment: center;
        if root.icon.width > 0: Icon {
            source: root.icon;
            colorize: label.color;
            y: (parent.height - self.height) / 2;
        }
        label := Text {
            text: root.text;
            accessible-role: none;
            color: kind == ButtonKind.danger ? Theme.on-danger
                : kind == ButtonKind.primary ? Theme.on-accent
                : kind == ButtonKind.ghost && !hovered ? Theme.text-2 : Theme.text;
            font-size: large ? Theme.font-heading : Theme.font-label;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
}

// The box of a checkbox: its state drawn, read by the control around it.
// Partial: some of what it stands for is checked.
export component CheckMark inherits Rectangle {
    in property <bool> checked;
    in property <bool> partial;
    in property <bool> enabled: true;
    width: Theme.checkbox;
    height: Theme.checkbox;
    border-radius: Theme.radius-small;
    border-width: Theme.checkbox-border;
    border-color: checked || partial ? Theme.accent : Theme.border-strong;
    background: checked || partial ? Theme.accent : Theme.surface;
    opacity: enabled ? 1 : Theme.disabled-opacity;
    if partial && !checked: Icon {
        source: @image-url("../assets/icons/minus.svg");
        colorize: Theme.on-accent;
        width: Theme.icon-badge;
        height: Theme.icon-badge;
    }
    if checked: Icon {
        source: @image-url("../assets/icons/check.svg");
        colorize: Theme.on-accent;
        width: Theme.icon-badge;
        height: Theme.icon-badge;
    }
}

// A word on a choice, in its tone: the warning colours by default.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> tone: Theme.warning;
    in property <color> tone-soft: Theme.warning-soft;
    height: Theme.badge-height;
    border-radius: Theme.radius-pill;
    background: tone-soft;
    HorizontalLayout {
        padding-left: Theme.spacing-s;
        padding-right: Theme.spacing-s;
        spacing: Theme.spacing-xs;
        Icon {
            source: root.icon;
            colorize: root.tone;
            width: Theme.icon-badge;
            height: Theme.icon-badge;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            // Read by the control the badge is in.
            accessible-role: none;
            color: root.tone;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
}

// How far a piece of work went, from 0 to 1; indeterminate, a sweep that
// says something runs without saying how far.
export component ProgressBar inherits Rectangle {
    in property <float> progress;
    in property <bool> indeterminate;
    in property <string> label;
    in property <color> tone: Theme.accent;
    height: Theme.bar-height;
    border-radius: Theme.radius-pill;
    background: Theme.track;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: label;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value: indeterminate ? "" : "\{round(clamp(progress, 0, 1) * 100)}";

    // The part of a sweep done, from 0 to 1.
    property <float> sweep: indeterminate
        ? mod(animation-tick() / 1ms, Theme.indeterminate-sweep / 1ms) / (Theme.indeterminate-sweep / 1ms)
        : 0;

    Rectangle {
        x: indeterminate ? (sweep * (1 + Theme.indeterminate-part) - Theme.indeterminate-part) * parent.width : 0;
        width: indeterminate ? Theme.indeterminate-part * parent.width : clamp(root.progress, 0, 1) * parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.tone;
    }
}

// The bar under a screen, its actions on the right.
export component Footer inherits Rectangle {
    height: Theme.footer-height;
    background: Theme.surface;
    Rectangle {
        y: 0;
        height: Theme.border-width;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: Screen.page-margin;
        padding-right: Screen.page-margin;
        spacing: Theme.spacing-m;
        @children
    }
}

// What scrolls within a screen, by the keyboard too: Tab reaches it, the
// arrows, the pages, Home and End move it; with nothing to scroll, the keys
// go on to what holds it.
export component ScrolledList inherits FocusScope {
    in property <string> label;
    in property <length> content-height;
    in property <length> ring-radius: Theme.radius-small;
    out property <length> visible-width: view.visible-width;
    out property <length> visible-height: view.visible-height;
    // Whether it can scroll further towards the top, or the bottom.
    out property <bool> above: view.content-y < 0;
    out property <bool> below: view.content-y > view.visible-height - view.content-height;

    // Scrolls by `step` (towards the top above 0).
    public function scroll-by(step: length) {
        view.content-y += step;
    }

    // Scrolls just enough for what lies from `top`, `height` high, in the
    // list's content to show.
    public function bring-into-view(top: length, height: length) {
        if top < -view.content-y {
            view.content-y = -top;
        } else if top + height > -view.content-y + view.visible-height {
            // Its top first, when it is higher than the list.
            view.content-y = max(-top, view.visible-height - top - height);
        }
    }

    accessible-role: list;
    accessible-label: label;
    key-pressed(event) => {
        if view.content-height <= view.visible-height {
            return reject;
        }
        if event.text == Key.Home {
            root.scroll-by(view.content-height);
            return accept;
        }
        if event.text == Key.End {
            root.scroll-by(-view.content-height);
            return accept;
        }
        if event.text == Key.UpArrow {
            root.scroll-by(Theme.scroll-step);
            return accept;
        }
        if event.text == Key.DownArrow {
            root.scroll-by(-Theme.scroll-step);
            return accept;
        }
        if event.text == Key.PageUp {
            root.scroll-by(view.visible-height);
            return accept;
        }
        if event.text == Key.PageDown {
            root.scroll-by(-view.visible-height);
            return accept;
        }
        reject
    }

    view := ScrollView {
        content-width: self.visible-width;
        content-height: root.content-height;
        @children
    }

    Rectangle {
        border-radius: root.ring-radius;
        border-width: root.has-focus ? Theme.focus-width : 0;
        border-color: Theme.focus;
    }
}

// A line that says something about the whole screen: a note, or a
// warning. Read when it shows.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> warning;
    background: warning ? Theme.warning-soft : Theme.info-soft;
    border-radius: Theme.radius-medium;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-live-region: polite;
    HorizontalLayout {
        padding: Theme.spacing-m;
        padding-left: Theme.spacing-l;
        spacing: Theme.spacing-m;
        Icon {
            source: root.warning ? @image-url("../assets/icons/triangle-alert.svg") : @image-url("../assets/icons/info.svg");
            colorize: root.warning ? Theme.warning : Theme.info;
            y: (parent.height - self.height) / 2;
        }
        Detail {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The frame of a modal dialog: never closed by a click outside (Franck's
// rule), Escape tells `escaped` from wherever the focus is in it; never a
// stop of Tab itself.
export component ModalFrame inherits PopupWindow {
    // Its name, read with it.
    in property <string> label;
    callback escaped;
    close-policy: no-auto-close;
    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escaped();
                return accept;
            }
            reject
        }
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-large;
            border-color: Theme.border;
            border-width: Theme.border-width;
            drop-shadow-color: Theme.shadow-1;
            drop-shadow-blur: Theme.shadow-1-blur;
            drop-shadow-offset-y: Theme.shadow-1-offset;
            accessible-role: groupbox;
            accessible-label: root.label;
            VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-l;
                @children
            }
        }
    }
}
