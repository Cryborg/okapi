{
  "type": "browsers",
  "chromiumCacheDirs": {
    "profile": [
      { "dir": "Cache", "label": "Cache", "description": "Pages, images, and scripts the browser keeps to load sites faster: downloaded again on the next visit. Logins, history, and bookmarks are not touched" },
      { "dir": "Code Cache", "label": "Code Cache", "cacheReset": true, "description": "Scripts of the sites visited, compiled: compiled again on the next visit, which is a little slower" },
      { "dir": "GPUCache", "label": "GPU Cache", "cacheReset": true, "description": "Shaders compiled by the browser's GPU process: rebuilt on demand" },
      { "dir": "Shared Dictionary/cache", "label": "Shared Dictionary Cache", "description": "Shared-compression dictionary cache: downloaded content rebuilt on demand" },
      { "dir": "Service Worker/CacheStorage", "label": "Service Worker Cache", "cacheReset": true, "description": "Responses the sites' service workers keep, offline copies included: usually downloaded again on the next visit, but a web app used offline may lose its local data" },
      { "dir": "DawnWebGPUCache", "label": "WebGPU Shader Cache", "cacheReset": true, "description": "Dawn's compiled WebGPU shaders: rebuilt on demand" },
      { "dir": "DawnGraphiteCache", "label": "Graphite Shader Cache", "cacheReset": true, "description": "Dawn/Skia Graphite pipeline cache: rebuilt on demand" }
    ],
    "shared": [
      { "dir": "component_crx_cache", "label": "Component Extension Cache", "description": "Downloaded CRX packages for component extensions: re-fetched on next update check, not the installed extensions themselves" },
      { "dir": "extensions_crx_cache", "label": "Extension Update Cache", "description": "Downloaded CRX packages awaiting install: re-fetched on next update check" },
      { "dir": "GrShaderCache", "label": "Skia Shader Cache", "cacheReset": true, "description": "Skia GPU shader cache: rebuilt on demand" },
      { "dir": "ShaderCache", "label": "Shader Cache", "cacheReset": true, "description": "Legacy GPU shader cache: rebuilt on demand" },
      { "dir": "GraphiteDawnCache", "label": "Graphite Pipeline Cache", "cacheReset": true, "description": "Where newer Chromium builds keep the Graphite pipeline cache: rebuilt on demand" },
      { "dir": "GPUPersistentCache", "label": "Persistent GPU Cache", "cacheReset": true, "description": "Where newer Chromium builds keep the on-disk GPU cache: rebuilt on demand" },
      { "dir": "PnaclTranslationCache", "label": "PNaCl Translation Cache", "cacheReset": true, "description": "Translated PNaCl modules: regenerated on demand" }
    ]
  },
  "firefoxCacheDirs": [
    { "dir": "cache2", "label": "Cache", "description": "Pages, images, and scripts the browser keeps to load sites faster: downloaded again on the next visit. Logins, history, and bookmarks are not touched" },
    { "dir": "thumbnails", "label": "Thumbnails", "description": "Page thumbnails of the new tab page: rebuilt on demand" },
    { "dir": "startupCache", "label": "Startup Cache", "cacheReset": true, "description": "Compiled scripts of the browser's own interface: rebuilt at the next launch, which is slower" }
  ],
  "chromium": [
    { "key": "chrome", "base": "${CONFIG}/google-chrome", "cache": "${CACHE}/google-chrome", "sandboxed": [
      { "packaging": "flatpak", "base": "${HOME}/.var/app/com.google.Chrome/config/google-chrome", "cache": "${HOME}/.var/app/com.google.Chrome/cache/google-chrome" }
    ] },
    { "key": "edge", "base": "${CONFIG}/microsoft-edge", "cache": "${CACHE}/microsoft-edge", "sandboxed": [
      { "packaging": "flatpak", "base": "${HOME}/.var/app/com.microsoft.Edge/config/microsoft-edge", "cache": "${HOME}/.var/app/com.microsoft.Edge/cache/microsoft-edge" }
    ] },
    { "key": "brave", "base": "${CONFIG}/BraveSoftware/Brave-Browser", "cache": "${CACHE}/BraveSoftware/Brave-Browser", "sandboxed": [
      { "packaging": "snap", "base": "${HOME}/snap/brave/current/.config/BraveSoftware/Brave-Browser", "cache": "${HOME}/snap/brave/common/.cache/BraveSoftware/Brave-Browser" },
      { "packaging": "flatpak", "base": "${HOME}/.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser", "cache": "${HOME}/.var/app/com.brave.Browser/cache/BraveSoftware/Brave-Browser" }
    ] },
    { "key": "opera", "base": "${CONFIG}/opera", "cache": "${CACHE}/opera", "sandboxed": [
      { "packaging": "snap", "base": "${HOME}/snap/opera/current/.config/opera", "cache": "${HOME}/snap/opera/common/.cache/opera" },
      { "packaging": "flatpak", "base": "${HOME}/.var/app/com.opera.Opera/config/opera", "cache": "${HOME}/.var/app/com.opera.Opera/cache/opera" }
    ] },
    { "key": "operaGX", "base": "${CONFIG}/opera-gx", "cache": "${CACHE}/opera-gx" },
    { "key": "vivaldi", "base": "${CONFIG}/vivaldi", "cache": "${CACHE}/vivaldi", "sandboxed": [
      { "packaging": "snap", "base": "${HOME}/snap/vivaldi/current/.config/vivaldi", "cache": "${HOME}/snap/vivaldi/common/.cache/vivaldi" },
      { "packaging": "flatpak", "base": "${HOME}/.var/app/com.vivaldi.Vivaldi/config/vivaldi", "cache": "${HOME}/.var/app/com.vivaldi.Vivaldi/cache/vivaldi" }
    ] },
    { "key": "arc", "base": "${CONFIG}/arc/User Data", "cache": "${CACHE}/arc/User Data" },
    { "key": "chromium", "base": "${CONFIG}/chromium", "cache": "${CACHE}/chromium", "sandboxed": [
      { "packaging": "snap", "base": "${HOME}/snap/chromium/common/chromium", "cache": "${HOME}/snap/chromium/common/.cache/chromium" },
      { "packaging": "flatpak", "base": "${HOME}/.var/app/org.chromium.Chromium/config/chromium", "cache": "${HOME}/.var/app/org.chromium.Chromium/cache/chromium" },
      { "packaging": "flatpak", "base": "${HOME}/.var/app/io.github.ungoogled_software.ungoogled_chromium/config/chromium", "cache": "${HOME}/.var/app/io.github.ungoogled_software.ungoogled_chromium/cache/chromium" }
    ] },
    { "key": "thorium", "base": "${CONFIG}/thorium", "cache": "${CACHE}/thorium" },
    { "key": "supermium", "base": "${CONFIG}/supermium", "cache": "${CACHE}/supermium" },
    { "key": "helium", "base": "${CONFIG}/helium", "cache": "${CACHE}/helium" },
    { "key": "cromite", "base": "${CONFIG}/cromite", "cache": "${CACHE}/cromite" },
    { "key": "catsxp", "base": "${CONFIG}/ArcSoft/CatsXP", "cache": "${CACHE}/ArcSoft/CatsXP" }
  ],
  "firefox": [
    { "key": "firefox", "bases": ["${HOME}/.mozilla/firefox", "${CONFIG}/mozilla/firefox"], "cache": "${CACHE}/mozilla/firefox", "sandboxed": [
      { "packaging": "snap", "bases": ["${HOME}/snap/firefox/common/.mozilla/firefox", "${HOME}/snap/firefox/current/.config/mozilla/firefox"], "cache": "${HOME}/snap/firefox/common/.cache/mozilla/firefox" },
      { "packaging": "flatpak", "bases": ["${HOME}/.var/app/org.mozilla.firefox/.mozilla/firefox", "${HOME}/.var/app/org.mozilla.firefox/config/mozilla/firefox"], "cache": "${HOME}/.var/app/org.mozilla.firefox/cache/mozilla/firefox" }
    ] },
    { "key": "librewolf", "bases": ["${HOME}/.librewolf"], "cache": "${CACHE}/librewolf", "sandboxed": [
      { "packaging": "flatpak", "bases": ["${HOME}/.var/app/io.gitlab.librewolf-community/.librewolf"], "cache": "${HOME}/.var/app/io.gitlab.librewolf-community/cache/librewolf" }
    ] },
    { "key": "waterfox", "bases": ["${HOME}/.waterfox"], "cache": "${CACHE}/waterfox", "sandboxed": [
      { "packaging": "flatpak", "bases": ["${HOME}/.var/app/net.waterfox.waterfox/.waterfox"], "cache": "${HOME}/.var/app/net.waterfox.waterfox/cache/waterfox" }
    ] },
    { "key": "floorp", "bases": ["${HOME}/.floorp"], "cache": "${CACHE}/floorp", "sandboxed": [
      { "packaging": "flatpak", "bases": ["${HOME}/.var/app/one.ablaze.floorp/.floorp"], "cache": "${HOME}/.var/app/one.ablaze.floorp/cache/floorp" }
    ] },
    { "key": "zen", "bases": ["${HOME}/.zen"], "cache": "${CACHE}/zen", "sandboxed": [
      { "packaging": "flatpak", "bases": ["${HOME}/.var/app/app.zen_browser.zen/.zen"], "cache": "${HOME}/.var/app/app.zen_browser.zen/cache/zen" }
    ] }
  ],
  "safari": null
}
